::SCORE::
** 品川車站 (Shinagawa Station Variations) **
~ "composer: zonble"
~ "arranger: Antigravity"
!= 126
?= C
<4/4>

/*
  Structure Overview (~2 mins / ~64 bars at 126 BPM, 4/4):
  Theme Motif:
    | 5 - 4 - 3 - 1 - | 1 2 1 3 1 4 1 5 | (2 bars)

  1. Intro (8 bars):
     - Repeat motif 4 times (solo Piano)
  2. Depart (8 bars):
     - Train departure / departure chime: Glockenspiel, Marimba ostinato, Pizzicato Bass & light Drums
  3. Accelerando_Run (16 bars):
     - Train speeding up: Strings swell, driving rhythm, melodic counterpoint on Flute & Piano
  4. Scenic_View (16 bars):
     - Lyrical expansion / view outside window: soaring Violin lead, rich CHORD harmonies, flowing arpeggios
  5. Arrival_Coda (16 bars):
     - Approaching next station: triumphant motif recap, gradual decrescendo, chime ring-out
*/

-> Intro
-> Depart
-> Accelerando_Run
-> Scenic_View
-> Arrival_Coda
-> #

/* ========================================================================= */
/* 1. INTRO (8 bars): Motif repeated 4 times on solo Piano                   */
/* ========================================================================= */

Intro:Piano@|0|{
    <8*>
    /* Repeat 1 */
    | 5 - 4 - 3 - 1 - | 1 2 1 3 1 4 1 5 |
    /* Repeat 2 */
    | 5 - 4 - 3 - 1 - | 1 2 1 3 1 4 1 5 |
    /* Repeat 3 */
    | 5 - 4 - 3 - 1 - | 1 2 1 3 1 4 1 5 |
    /* Repeat 4 */
    | 5 - 4 - 3 - 1 - | 1 2 1 3 1 4 1 5 |
}

/* ========================================================================= */
/* 2. DEPART (8 bars): Chime & rhythmic groove enters (train starts moving)   */
/* ========================================================================= */

Depart:Glockenspiel@|0|{
    <8*>
    /* Bright platform departure chime */
    | 5^ - 4^ - 3^ - 1^ - | 1^ 2^ 1^ 3^ 1^ 4^ 1^ 5^ |
    | 5^ - 4^ - 3^ - 1^ - | 1^ 2^ 1^ 3^ 1^ 4^ 1^ 5^ |
    | 5^ - 4^ - 3^ - 1^ - | 1^ 2^ 1^ 3^ 1^ 4^ 1^ 5^ |
    | 5^ - 6^ - 5^ - 3^ - | 2^ - 1^ - 1^ - - - |
}

Depart:Marimba@|0|{
    <16*>
    /* Clockwork wheel clicking ostinato */
    | 1 5 1 5 1 5 1 5 1 5 1 5 1 5 1 5 |
    | 1 5 1 5 1 5 1 5 1 5 1 5 1 5 1 5 |
    | 4_ 1 4_ 1 4_ 1 4_ 1 4_ 1 4_ 1 4_ 1 4_ 1 |
    | 5_ 2 5_ 2 5_ 2 5_ 2 5_ 2 5_ 2 5_ 2 5_ 2 |
    | 1 5 1 5 1 5 1 5 1 5 1 5 1 5 1 5 |
    | 1 5 1 5 1 5 1 5 1 5 1 5 1 5 1 5 |
    | 4_ 1 4_ 1 4_ 1 4_ 1 5_ 2 5_ 2 5_ 2 5_ 2 |
    | 1 5 1 5 1 5 1 5 1 - - - - - - - |
}

Depart:Bass@|0|{
    <4*>
    /* Walking pizzicato bass */
    | 1_ - 3_ - | 5_ - 3_ - |
    | 1_ - 3_ - | 5_ - 3_ - |
    | 4_ - 6_ - | 1 - 6_ - |
    | 5_ - 7__ - | 2_ - 5_ - |
    | 1_ - 3_ - | 5_ - 3_ - |
    | 1_ - 3_ - | 5_ - 3_ - |
    | 4_ - 4_ - | 5_ - 5_ - |
    | 1_ - 5_ - | 1_ - - - |
}

Depart:Drums@|0|{
    <16*>
    /* Light hi-hat train chug and snare taps */
    | t-t- t-t- t-t- t-t- | t-t- t-t- t-t- t-t- |
    | t-t- t-t- t-t- t-t- | t-t- t-t- t-t- t-t- |
    | t-t- t-t- t-t- t-t- | t-t- t-t- t-t- t-t- |
    | t-t- t-t- t-t- t-t- | t-t- t-t- t-s X--- |
    | t-t- t-t- t-t- t-t- | t-t- t-t- t-t- t-t- |
    | t-t- t-t- t-t- t-t- | t-t- t-t- t-t- t-t- |
    | t-t- t-t- t-t- t-t- | t-t- t-t- t-t- t-t- |
    | t-t- t-t- t-t- t-t- | X-s- X-s- X--- 0--- |
}

/* ========================================================================= */
/* 3. ACCELERANDO_RUN (16 bars): Train at full speed, energetic variation     */
/* ========================================================================= */

Accelerando_Run:Flute@|0|{
    <8*>
    /* Rapid woodwind arpeggiation and melody variation */
    | 5^ - 4^ - 3^ - 1^ - | 1^ 2^ 1^ 3^ 1^ 4^ 1^ 5^ |
    | 6^ - 5^ - 4^ - 2^ - | 2^ 3^ 2^ 4^ 2^ 5^ 2^ 6^ |
    | 5^ - 4^ - 3^ - 1^ - | 1^ 2^ 1^ 3^ 1^ 4^ 1^ 5^ |
    | 4^ - 3^ - 2^ - 7 - | 1^ - - - 1^ - - - |

    | 5^ 3^ 1^ 3^ 5^ 3^ 1^ 3^ | 6^ 4^ 1^ 4^ 6^ 4^ 1^ 4^ |
    | 5^ 3^ 1^ 3^ 5^ 3^ 1^ 3^ | 4^ 2^ 7 2^ 4^ 2^ 7 2^ |
    | 5^ 3^ 1^ 3^ 5^ 3^ 1^ 3^ | 6^ 4^ 2^ 4^ 6^ 4^ 2^ 4^ |
    | 5^ 4^ 3^ 2^ 1^ 7 6 5 | 1^ - - - 1^ - - - |
}

