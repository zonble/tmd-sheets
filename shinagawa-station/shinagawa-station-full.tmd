    <8*>
    | 1_ - 1_ - 1_ - 1_ - | 1_ - 1_ - 1_ - 1_ - |
    | 2_ - 2_ - 2_ - 2_ - | 2_ - 2_ - 2_ - 2_ - |
    | 1_ - 1_ - 1_ - 1_ - | 1_ - 1_ - 1_ - 1_ - |
    | 5_ - 5_ - 5_ - 5_ - | 1_ - 1_ - 1_ - 1_ - |

    | 1_ - 1_ - 1_ - 1_ - | 4_ - 4_ - 4_ - 4_ - |
    | 1_ - 1_ - 1_ - 1_ - | 5_ - 5_ - 5_ - 5_ - |
    | 6_ - 6_ - 6_ - 6_ - | 2_ - 2_ - 2_ - 2_ - |
    | 5_ - 5_ - 5_ - 5_ - | 1_ - 5_ - 1_ - - - |
}

Accelerando_Run:Drums@|0|{
    <16*>
    /* Driving 16th beat */
    | X-t- s-t- X-t- s-t- | X-t- s-t- X-t- s-t- |
    | X-t- s-t- X-t- s-t- | X-t- s-t- X-t- s-t- |
    | X-t- s-t- X-t- s-t- | X-t- s-t- X-t- s-t- |
    | X-t- s-t- X-t- s-t- | X-s- X-s- X-X- s-s- |

    | X-t- s-t- X-t- s-t- | X-t- s-t- X-t- s-t- |
    | X-t- s-t- X-t- s-t- | X-t- s-t- X-t- s-t- |
    | X-t- s-t- X-t- s-t- | X-t- s-t- X-t- s-t- |
    | X-t- s-t- X-t- s-t- | X--- s--- X-s- X--- |
}

/* ========================================================================= */
/* 4. SCENIC_VIEW (16 bars): Lyrical expansion / Tokyo bay window view       */
/* ========================================================================= */

Scenic_View:Violin@|0|{
    <8*>
    /* Broad lyrical cantabile variation of motif */
    | 5^ - - - 3^ - 1^ - | 2^ - 3^ - 4^ - 5^ - |
    | 6^ - - - 4^ - 2^ - | 3^ - 4^ - 5^ - 6^ - |
    | 7^ - - - 5^ - 3^ - | 6^ - 5^ - 4^ - 3^ - |
    | 2^ - - - - - - - | 5^ - - - - - - - |

    | 5^ - 4^ - 3^ - 1^ - | 1^ 2^ 1^ 3^ 1^ 4^ 1^ 5^ |
    | 6^ - 5^ - 4^ - 2^ - | 2^ 3^ 2^ 4^ 2^ 5^ 2^ 6^ |
    | 5^ - 6^ - 7^ - 1^^ - | 2^^ - 1^^ - 7^ - 6^ - |
    | 5^ - - - 2^ - - - | 1^ - - - 1^ - - - |
}

