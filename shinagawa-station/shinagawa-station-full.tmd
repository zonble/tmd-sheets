/* ========================================================================= */
/* 5. ARRIVAL_CODA (16 bars): Approaching next stop, grand tutti to chime fade */
/* ========================================================================= */

Arrival_Coda:Glockenspiel@|0|{
    <8*>
    | 5^ - 4^ - 3^ - 1^ - | 1^ 2^ 1^ 3^ 1^ 4^ 1^ 5^ |
    | 5^ - 4^ - 3^ - 1^ - | 1^ 2^ 1^ 3^ 1^ 4^ 1^ 5^ |
    | 5^ - 4^ - 3^ - 1^ - | 1^ 2^ 1^ 3^ 1^ 4^ 1^ 5^ |
    | 5^ - 6^ - 7^ - 1^^ - | 1^^ - - - 1^^ - - - |

    /* Echoing away like station bell */
    | 5^ - 4^ - 3^ - 1^ - | 1^ 2^ 1^ 3^ 1^ 4^ 1^ 5^ |
    | 5^ - 4^ - 3^ - 1^ - | 1^ - - - 0 - - - |
    | 5^ - - - 3^ - - - | 1^ - - - - - - - |
    | 0 - - - 0 - - - | 1^^ - - - - - - - |
}

