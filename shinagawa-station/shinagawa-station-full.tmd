    | 2_ - | 5_ - |
    | 1_ - | 6_ - |
    | 2_ - | 5_ - |

    | 1_ - | 4_ - |
    | 2_ - | 5_ - |
    | 1_ - | 4_ - |
    | 5_ - | 1_ - |
}

