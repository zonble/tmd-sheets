::SCORE::
** B 小調實驗曲 (Experiment in B Minor) **
!= 120
?= Bm
<4/4>

Intro:Piano@|0| {
    <8*>
    /* 序奏：夜色降臨的 B 小調 */
    | 6_ - 1 - 3 - 6 - | 7_ - 2 - 4 - 7 - |
    | 6_ - 1 - 3 - 6 - | 3 - - - - - - - |
}

SectionA:Vocal@|0| {
    <8*>
    /* 第一階段：深沉低亢的低音域開場 (B3 低音起唱) */
    | 6_ 1 3 3 3 2 3 - | 7_ 2 4 4 4 3 4 - |
    | 6_ 1 3 3 3 2 1 - | 7_ 6_ 7_ 1 6_ - - - |
}

SectionA:Bass@|0| {
    <8*>
    | 6__ - - - - - - - | 7__ - - - - - - - |
    | 6__ - - - - - - - | 3__ - - - - - - - |
}

SectionB:Vocal@|0| {
    <8*>
    /* 第二階段：逐漸過渡至中高音域 */
    | 3 3 5 6 - 5 3 - | 2 2 4 5 - 4 2 - |
    | 3 3 5 6 - 5 3 2 | 1 - 7_ - 6_ - - - |
}

SectionB:Bass@|0| {
    <8*>
    | 3__ - - - - - - - | 2__ - - - - - - - |
    | 3__ - - - - - - - | 6__ - - - - - - - |
}

Chorus:Vocal@|0| {
    <8*>
    /* 第三階段：華麗花腔流線 (攀升至高音域 1^ ~ 3^) */
    | 1^ 7 6 5 4 3 2 1 | 3^ - 2^ - 1^ 7 6 5 |
    | 6_ 7_ 1 3 5 7 1^ 3^ | 1^ - - - - - - - |
    | 3^ 2^ 1^ 7 1^ 2^ 3^ 5^ | 5^ - 3^ - 1^ - 7 - |
    | 6 5 4 3 2 1 7_ 5_' | 6_ - - - - - - - |
}

Chorus:Bass@|0| {
    <8*>
    | 6__ - - - - - - - | 3__ - - - - - - - |
    | 6__ - - - - - - - | 3__ - - - - - - - |
    | 6__ - - - - - - - | 3__ - - - - - - - |
    | 6__ - - - - - - - | 6__ - - - - - - - |
}

SectionC:Vocal@|0| {
    <8*>
    /* 第四階段：跨八度階梯 (1^ 攀升至 1^^) */
    | 6_ 1 3 6 1^ 3^ 6^ 1^^ | 1^^ - 7^ - 6^ 5^ 4^ 3^ |
    | 2^ 3^ 4^ 5^ 6^ 7^ 1^^ 3^^ | 3^^ - - - - - - - |
}

SectionC:Bass@|0| {
    <8*>
    | 6__ - - - - - - - | 3__ - - - - - - - |
    | 2__ - - - - - - - | 3__ - - - - - - - |
}

Cadenza:Vocal@|0| {
    <8*>
    /* 第五階段：極限花腔華彩 (跑音階至 5^^) */
    | 3^^ 2^^ 1^^ 7^ 6^ 5^ 4^ 3^ | 2^ 1^ 7 6 5 4 3 2 |
    | 6_ 7_ 1 3 6 1^ 3^ 6^ | 1^^ 3^^ 5^^ 3^^ 1^^ 7^ 6^ - |
}

Cadenza:Bass@|0| {
    <8*>
    | 6__ - - - - - - - | 3__ - - - - - - - |
    | 6__ - - - - - - - | 3__ - - - - - - - |
}

GrandFinale:Vocal@|0| {
    <8*>
    /* 第六階段：MIDI 聲響黃金極限巔峰 (B3 -> B6 / 6^^) */
    | 6^ 1^^ 3^^ 6^^ - - - - | 6^^ 5^^ 3^^ 1^^ 6^ 3^ 1^ 6 |
    | 6_ - - - - - - - | 6^^ - - - - - - - |
}

GrandFinale:Bass@|0| {
    <8*>
    | 6__ - - - - - - - | 3__ - - - - - - - |
    | 6__ - - - - - - - | 6__ - - - - - - - |
}

ArpeggioHeaven:Vocal@|0| {
    <8*>
    /* 第七階段：狂想琵音一路向上狂飆橫跨四個八度 (B3 -> B7 / 6___ -> 6^^^) */
    | 6_ 1 3 6 1^ 3^ 6^ 1^^ | 3^^ 6^^ 1^^^ 3^^^ 6^^^ - - - |
    | 6^^^ 3^^^ 1^^^ 6^^ 3^^ 1^^ 6^ 3^ | 1^ 6 3 1 6_ - - - |
}

ArpeggioHeaven:Bass@|0| {
    <8*>
    | 6__ - - - - - - - | 3__ - - - - - - - |
    | 6__ - - - - - - - | 6__ - - - - - - - |
}

Outro:Piano@|0| {
    <8*>
    /* 終曲：回到 B 小調主音 */
    | 6_ 1 3 6 3 1 6_ - | 6__ - - - - - - - |
}

-> Intro
-> SectionA
-> SectionB
-> Chorus
-> SectionC
-> Cadenza
-> GrandFinale
-> ArpeggioHeaven
-> Outro
->#

