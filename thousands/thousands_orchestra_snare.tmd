/* =========================================================================
   Chorus (16 measures) - 銅管與管弦群齊鳴，悲壯而堅毅
   千千萬萬隻眼睛... 點亮千千萬萬盞燈火... 守著溫柔
   ========================================================================= */

Chorus:Piano1@|0| {
    <4*>
    /* 一定有千千萬萬隻眼睛 還有千千萬萬張耳朵，會讓那 */
    | (4 4 3 2)%(--) 1 4 | 3 - 3 5_ | (2 2 2 5_)%(--) 1 7_ | 6_ 6_ 1 3 |
    /* 千千萬萬顆心 用千千萬萬雙手 點亮千千萬萬盞燈火 我相信 */
    | (4 4 3 2)%(--) 1 4 | (3 3 3 2)%(--) 1 3 | (5 5 5 2)%(--) 5 4 | 3 3 1 3 |
    /* 【第三句】許多樂器先安靜！留給主旋律與大提琴真摯訴說：有千千萬萬的生命 在野蠻中始終守著溫柔，在那 */
    | (4 4 4 1)%(--) 5 6 | 5 5 3 6 | (5 5 5 2)%(--) 5 4 | 3 3 1 3 |
    /* 【第四句】突然全面大爆發！！千千萬萬條街 千萬個巷弄 千千萬萬個角落 */
    | (4 4 4 4)%(--) 1 4 | (3 3 - 1)%(--) 5 3 | (2 2 2 5_)%(--) 1 7_ | 6_ - - - |
}

Chorus:Violin@|0| {
    <4*>
    | (4 4 3 2)%(--) 1 4 | 3 - 3 5_ | (2 2 2 5_)%(--) 1 7_ | 6_ 6_ 1 3 |
    | (4 4 3 2)%(--) 1 4 | (3 3 3 2)%(--) 1 3 | (5 5 5 2)%(--) 5 4 | 3 3 1 3 |
    /* 第三句安靜留白 */
    | 0 - - - | 0 - - - | 0 - - - | 0 - - - |
    /* 第四句突然爆發！ */
    | (4 4 4 4)%(--) 1 4 | (3 3 - 1)%(--) 5 3 | (2 2 2 5_)%(--) 1 7_ | 6_ - - - |
}

