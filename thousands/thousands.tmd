::SCORE::
** 千千萬萬 **
!= 120
?= C
<4/4>

Intro:Piano@|0| {
    <4*>
    | 4_ 1 1 2 | 1 6_ 5_ 6_ | 5_ 2 1 7_ | 6_ 3_ - - |
    | 4_ 1 1 2 | 1 6_ 5_ 6_ | 5_ 2 1 7_ | 6_ - - - |
}

A:Piano1@|0| {
    <4*>
    /* 千萬種利益 千萬種誘惑 */
    | 4_ 1 1 4_ | 3_ - - - | 2_ 1 (7_ - - 5_)%(--) | 3_ - - - |
    /* 千萬個秘密 千萬種操縱 */
    | 4_ 1 (1 - - 4_)%(--) | 5_ - - - | 2 5_ 1 7_ | 6_ - - - |
}

B:Piano1@|0| {
    <4*>
    /* 千萬種的恐懼 千萬種的壓迫 */
    | 4_ 1 1 4_ | 5_ 5_ - - | 5_ 2 1 7_ | 6_ 3_ - - |
    /* 千萬種、又千萬種 仇恨的連鎖 */
    | 4_ 1 1 - | 3_ 1 1 - | 2_ 1 7_ 2_ | 1_ - - - |
}

C:Piano1@|0| {
    <4*>
    /* 千萬道的難題 千萬種的難過 */
    | 4_ 1 1 4_ | 5_ 5_ - - | 5_ 2 1 7_ | 6_ 3_ - 3_ |
    /* 總覺得世界應該往前進 但怎麼一切都在往後走 */
    | 4_ (1 1)%(-) 1 4_ | 3_ 1 1 3_ | 2_ (1 1)%(-) 1 2_ | 1_ 6_ 5_ - |
}

D:Piano1@|0| {
    <4*>
    /* 千萬層的隔離 千萬座的牢籠 */
    | 4_ 1 1 4_ | 5_ 5_ - - | 5_ 2 1 7_ | 6_ 3_ - 3_ |
    /* 千萬句謊言 像千萬股迷煙 讓我視線朦朧 一定有*/
    | 4_ (1 1)%(-) 1 4_ | 3_ (1 3_)%(-) 1 3 | 2 5_ 1 7_ | 6_ 6_ 1 3 |
}

Chorus:Piano1@|0| {
    <4*>
    /* 一定有千千萬萬隻眼睛 還有千千萬萬張耳朵，會讓那 */
    | (4 4 3 2)%(--) 1 4 | 3 - 3 5_ | (2 2 2 5_)%(--) 1 7_ | 6_ 6_ 1 3 |
    /* 千千萬萬顆心 用千千萬萬雙手 點亮千千萬萬盞燈火 我相信 */
    | (4 4 3 2)%(--) 1 4 | (3 3 3 2)%(--) 1 3 | (5 5 5 2)%(--) 5 4 | 3 3 1 3 |
    /* 有千千萬萬的生命 在野蠻中始終守著溫柔，在那 */
    | (4 4 4 1)%(--) 5 6 | 5 5 3 6 | (5 5 5 2)%(--) 5 4 | 3 3 1 3 |
    /* 千千萬萬條街 千萬個巷弄 千千萬萬個角落 */
    | (4 4 4 4)%(--) 1 4 | (3 3 - 1)%(--) 5 3 | (2 2 2 5_)%(--) 1 7_ | 6_ - - - |
}

Bridge:Piano@|0| {
    <4*>
    | 4_ 1 1 2 | 1 6_ 5_ 6_ | 5_ 2 1 7_ | 6_ 3_ - - |
    | 4_ 1 1 2 | 1 6_ 5_ 6_ | 5_ 2 1 7_ | 6_ - - - |
}

Chorus2:Piano1@|0| {
    <4*>
    /* 一定有千千萬萬隻眼睛 還有千千萬萬張耳朵 會讓那 */
    | (4 4 3 2)%(--) 1 4 | 3 - 3 5_ | (2 2 2 5_)%(--) 1 7_ | 6_ 6_ 1 3 |
    /* 千千萬萬顆心 用千千萬萬雙手 點亮千千萬萬盞燈火 我相信 */
    | (4 4 3 2)%(--) 1 4 | (3 3 3 2)%(--) 1 3 | (5 5 5 2)%(--) 5 4 | 3 3 1 3 |
    /* 有千千萬萬的生命 在野蠻中始終守著溫柔 在那 */
    | (4 4 4 1)%(--) 5 6 | 5 5 3 6 | (5 5 5 2)%(--) 5 4 | 3 3 1 3 |
    /* 千千萬萬條街 千萬個巷弄 千千萬萬個角落 我相信 */
    | (4 4 3 2)%(--) 1 4 | (3 3 - 1)%(--) 5 3 | (2 2 2 5_)%(--) 1 7_ | 6_ 6_ 1 3 |
}

Chorus3:Piano1@|0| {
    <4*>
    /* 有千千萬萬的生命 我相信 我相信 */
    | (4 4 4 1)%(--) 5 6 | 5 - 3 6 | 5 - 3 6 | 5 - - - |
    /* 再怎樣的野蠻中 也始終守候著溫柔 我相信 */
    | (4 4 4 1)%(--) 5 6 | 5 - 5 2 | 5 (2 2)%(-) 5 ( 6 5)%(-) | 3 3 1 3 |
    /* 有千千萬萬的生命 我相信 我相信 */
    | (4 4 4 1)%(--) 5 6 | 5 - 3 6 | 5 - 2 5 | 3 - 1 3 |
    /* 千千萬萬條街 千萬個巷弄 千千萬萬個角落 在那 */
    | (4 4 4 4 )%(--) 1 4 | (3 3 - 1)%(--) 5 3 | (2 2 2 5_)%(--) 1 7_ | 6_ 6_ 1 3 |
}

End:Piano1@|0| {
    <4*>
    /* 千千萬萬條街 千萬個巷弄 千千萬萬個角落*/
    | (4 4 4 )%(--) 1 4 | (3 3 - 1)%(--) 5 3 | (2 2 2 5_)%(--) 1 7_ | 6_ - - - |
}

-> Intro -> A -> B -> C -> D -> Chorus -> Bridge -> D -> Chorus2 -> Chorus3 -> End ->#

