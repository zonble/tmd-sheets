::SCORE::
** 等不及想要看著你長大 **
!= 110
?= C
key= Am
~ "composer: zonble"
~ "lyrics: zonble"
~ "note: 寫於 1998 年 2 月大園空難後"
<4/4>

A1:Piano@|0| {
    <8*>
    /* 想聽你天真的童語、天真的歡笑、天真的歌唱
    天真的聲音總是那樣
    穿破天際地嘹亮 */
    | 6 - 6 7 1^ (1^ 7)%(-) 6 7 | 1^ (1^ 7)%(-) 6 7 3^ (3^ 2^) 1^ 2^ |
    | 2^ (2^ 2^)%(-) 2^ 2^ 1^ (1^ 7)%(-) 6 7 | 1^ (1^ 7)%(-) 6 1^ 7 - 3 - |
}

A2:Piano@|0| {
    <8*>
    /* 想看你稚氣的酒渦、稚氣的臉龐、稚氣的模樣
    稚氣的眼神總是那樣
    一閃一閃地發光 */
    | 6 - 6 7 1^ (1^ 7)%(-) 6 7 | 1^ (1^ 7)%(-) 6 7 3^ (3^ 2^) 1^ 2^ |
    | 2^ (2^ 2^)%(-) 2^ 2^ 1^ (1^ 7)%(-) 6 7 | 1^ (1^ 7)%(-) 6 1^ 7 1^ 7 - |
}

A3:Piano@|0| {
    <8*>
    /* 想帶你奔向那沙灘、奔向那海洋、奔向那夢想
    奔向那每個你想去
    卻又沒去過的地方 */
    | 6 - 6 7 1^ (1^ 7)%(-) 6 7 | 1^ (1^ 7)%(-) 6 7 3^ (3^ 2^) 1^ 2^ | 
    | 2^ (2^ 2^)%(-) 2^ 2^ 1^ (1^ 7)%(-) 6 7 | 1^ (1^ 7)%(-) 6 1^ 7 - 3 - |
}

A4:Piano@|0| {
    <8*>
    /* 想和你一起看星斗、一起看月亮、一起看太陽
    一起看著你怎樣又怎樣
    怎樣地長大 */
    | 6 - 6 7 1^ (1^ 7)%(-) 6 7 | 1^ (1^ 7)%(-) 6 7 3^ (3^ 2^) 1^ 2^ |
    | 2^ (2^ 2^)%(-) 2^ 2^ 1^ (1^ 7)%(-) 6 7 | 7 3 1^ 7 6 - 1^ 2^ |
}

B1:Piano@|0| {
    <8*>
    /* 勇敢的孩子，你是否曾經感到害怕？
    害怕我就此不能守候在你的身旁？
    勇敢的孩子，你能不能不要再害怕？
    我如此等不及想要看著你長大 */
    | 3^ - 3^ 3^ 2^ 7 5 7 | 1^ (1^ 7)%(-) 6 1^ 7 1^ 2^ - |
    | 3^ - 3^ 3^ 2^ 5^ 5^ 2^ | | 1^ (1^ 7)%(-) 6 1^ 7 1^ 2^ - |
    | 3^ - 3^ 3^ 2^ 7 5 7 | 1^ (1^ 7)%(-) 6 1^ 7 - 3 - |
    | 4 - 4 4 1^ (1^ 7)%(-) 6 7 | 7 3 1^ 7 6 - 1^ 2^ |
}

B2:Piano@|0| {
    <8*>
    /* 勇敢的孩子，你是否曾經感到驚慌？
    驚慌我就此不能守候在你的身旁？
    勇敢的孩子，你能不能不要再驚慌？
    我真的等不及想要看著你長大 */
    | 3^ - 3^ 3^ 2^ 7 5 7 | 1^ (1^ 7)%(-) 6 1^ 7 1^ 2^ - |
    | 3^ - 3^ 3^ 2^ 5^ 5^ 2^ | | 1^ (1^ 7)%(-) 6 1^ 7 1^ 2^ - |
    | 3^ - 3^ 3^ 2^ 7 5 7 | 1^ (1^ 7)%(-) 6 1^ 7 - 3 - |
    | 4 - 4 4 1^ (1^ 7)%(-) 6 7 | 7 3 1^ 7 6 - - -  |
}

-> A1
-> A2
-> A3
-> A4
-> B1
-> B2
-> A1
-> A2
-> A3
-> A4
-> B1
-> B2
-> {?+1}
-> B1
-> B2
-> #

