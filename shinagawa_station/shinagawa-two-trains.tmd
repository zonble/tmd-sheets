/* ========================================================================= */
/* 5. STATION_ARRIVAL (16 bars): Decelerating & Final Platform Bell Ring     */
/* ========================================================================= */

Station_Arrival:Train_1_Horn_Piano@|0|{
    <8*>
    /* Train 1 arrival call */
    | 5 - 4 - 3 - 1 - | 0 - - - 0 - - - |
    | 5 - 4 - 3 - 1 - | 0 - - - 0 - - - |
    | 5 - 4 - 3 - 1 - | 0 - - - 0 - - - |
    | 5 - 6 - 7 - 1^ - | 0 - - - 0 - - - |

    /* Decelerating to a stop */
    | 5 - 4 - 3 - 1 - | 0 - - - 0 - - - |
    | 5 - 4 - 3 - 1 - | 0 - - - 0 - - - |
    | 5 - - - 3 - - - | 0 - - - 0 - - - |
    | 0 - - - 0 - - - | [C] - - - - - - - |
}

Station_Arrival:Train_2_Bell_Celesta@|0|{
    <8*>
    /* Train 2 arrival response */
    | 0 - - - 0 - - - | 1^ 2^ 1^ 3^ 1^ 4^ 1^ 5^ |
    | 0 - - - 0 - - - | 1^ 2^ 1^ 3^ 1^ 4^ 1^ 5^ |
    | 0 - - - 0 - - - | 1^ 2^ 1^ 3^ 1^ 4^ 1^ 5^ |
    | 0 - - - 0 - - - | 1^^ - - - 1^^ - - - |

    /* Final platform chime echo */
    | 0 - - - 0 - - - | 1^ 2^ 1^ 3^ 1^ 4^ 1^ 5^ |
    | 0 - - - 0 - - - | 1^ - - - 0 - - - |
    | 0 - - - 0 - - - | 1^ - - - - - - - |
    | 0 - - - 0 - - - | 1^^ - - - - - - - |
}

Station_Arrival:Rail_Bass@|0|{
    <4*>
    | 1_ - 3_ - | 5_ - 3_ - |
    | 1_ - 3_ - | 5_ - 3_ - |
    | 4_ - 5_ - | 1_ - 3_ - |
    | 4_ - 5_ - | 1_ - - - |

    | 1_ - 3_ - | 5_ - 3_ - |
    | 1_ - 3_ - | 1_ - 0 - |
    | 1_ - - - | 1_ - - - |
    | 0 - - - | 1_ - - - |
}

Station_Arrival:Rail_Clicks_Drums@|0|{
    <16*>
    | X-t- s-t- X-t- s-t- | X-t- s-t- X-t- s-t- |
    | X-t- s-t- X-t- s-t- | X-t- s-t- X-t- s-t- |
