/* ========================================================================= */
/* 【第三樂章（壓軸）：新一軍軍歌】 (NFA_March, 14 小節)                      */
/* 天下第一軍剛毅雄渾，「吾軍欲發揚...效命疆場，才算好兒郎！」                 */
/* ========================================================================= */

NFA_March:Trumpet@|0| {
    <4*>
    /* 吾軍欲發揚 精誠 */
    | 5 1 (1 - - 2)%(--) | (3 - - 1)%(--) 5_ 5_ |
    /* 團結無欺罔 矢志 */
    | (2 - - 1)%(--) 7_ 2 | 5 - 0 (1 1)%(-) |
    /* 救國亡 猛士力能守四 */
    | 6 5 4 (2 -- 2)%(-) | 5 (3 -- 1)%(-) 2 3 |
    /* 方 不怕刀和槍 勢把敵人 */
    | 1 0 (3 -- 2 1 -- 7_)%(--) | 6_ 0 (2 - - 6_ 7_ - - 6_)%(--) |
    /* 降 親上死長 效命疆 */
    | 5_ 0 (5_ -- 5_ 7_ -- 3_)%(--) | 5 - (5 - 1 3)%(-) 6 |
    /* 場 才算好兒 */
    | 6 - - (0 2)%(-) | 5 (3 -- 1)%(-) 2 - |
    /* 郎 */
    | 1 - - - | 0 - 0 (5_ 1)%(-) |
}

