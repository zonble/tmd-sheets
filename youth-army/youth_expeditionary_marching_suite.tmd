    | 1^ 0 (3^ -- 2^ 1^ -- 7)%(--) | 6 0 (2^ - - 6 7 - - 6)%(--) |
    | 5 0 (5 -- 5 7 -- 3)%(--) | 5^ - (5^ - 1^ 3^)%(-) 6^ |
    | 6^ - - (0 2^)%(-) | 5^ (3^ -- 1^)%(-) 2^ - |
    | 1^ - - - | 0 - 0 (5^ 1^^)%(-) |
}

