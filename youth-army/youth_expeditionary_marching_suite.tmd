/* ========================================================================= */
/* 段落 F：奮勇向前 (YEF_End, 4 小節)「向前進，一起向前進！」                  */
/* ========================================================================= */

YEF_End:Trumpet@|0| {
    <4*>
    /* 向前進 勇敢的同志們 */
    | 1 1 6 - | 5 (6 - - 5)%(-) (5 - - 3)%(-) 1 |
    /* 向前進 一起向前進 */
    | 2 2 (7 - - 6)%(--) | (5 -- 5)%(-) (7 -- 2^)%(-) 1^ - |
}

YEF_End:Flute@|0| {
    <4*>
    | 1^ 1^ 6^ - | 5^ (6^ - - 5^)%(-) (5^ - - 3^)%(-) 1^ |
    | 2^ 2^ (7^ - - 6^)%(--) | (5^ -- 5^)%(-) (7^ -- 2^^)%(-) 1^^ - |
}

