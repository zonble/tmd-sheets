::SCORE::
** 青年軍進行曲 **
!= 120
?= E
~ "洪波作曲"
<4/4>

March1:Piano@|-1| {
    <4*>
    /* 我們*/
    | 0 0 0 ( 5_ -- 5_ )%(-) |
    /* 大家是知識青年  我們*/
    | 1 (5_ -- 1)%(-) 3 (1 -- 3)%(-) | (2 -- 7_)%(-) 5 0 ( 5_ -- 5_ )%(-) |
    /* 是國家社會的中堅 今日 */
    | 6 (6_ -- 2)%(-) 4 (4 -- 6)%(-) | (5 -- 4)%(--) 3 ( 3 -- 3 )%(-) |
    /* 來響應領袖的號召 去*/
    | 6 (7 -- 6)%(-) 5 (4 -- 3)%(-) | (4 --3)%(--) (2 0)%(-) (2--2)%(-) |
    /* 捍衛祖國上前線 */
    | (44)%(-) (5--4)%(-) 3 (4--2)%(-) | 5 -- 0 |
}

March2:Piano@|-1| {
    <4*>
    /* 我們*/
    | 0 0 0 ( 5_ -- 5_ )%(-) |
    /* 大家是知識青年  我們*/
    | 1 (5_ -- 1)%(-) 3 (1 -- 3)%(-) | (2 -- 7_)%(-) 5 0 ( 5_ -- 5_ )%(-) |
    /* 是國家社會的中堅 今日 */
    | 6 (6_ -- 2)%(-) 4 (4 -- 6)%(-) | (5 -- 4)%(--) 3 ( 3 -- 3 )%(-) |
    /* 來響應領袖的號召 去*/
    | 6 (7 -- 6)%(-) 5 (4 -- 3)%(-) | (4 --5)%(--) (6 0 5 5)%(--) |
    /* 捍衛祖國上前線 */
    | (77)%(-) (1^--5)%(-) 3 (4--2)%(-) | 1 -- 0 |
}

March3:Piano@|-1| {
    <4*>
    /* 不怕 */
    | 0 0 0 (1--1)%(-) |
    /* 吃苦 不畏 艱險 救亡*/
    | 2 - (2 0)%(-) (4--3)%(-) | 2 - (2 0)%(-) (2--3)%(-) |
    /* 責任在兩肩 壯志*/
    | 4 4 4 (5 4)%(-) | 3 - - (2 3)%(-) |
    /* 凌雲 歌聲遍野 裝*/
    | 4 - (4 0)%(-) (6--5)%(-) | 4 - (4 0)%(-) (4--5)%(-) |
    /* 備精銳軍容堅 */
    | 5 5 5 (7 6)%(-) | 5 - 0 0 |
}

March4:Piano@|-1| {
    <4*>
    /* 整*/
    | 0 0 0 (5 1^) %(-) |
    /* 齊步伐 奮勇上前 擊*/
    | 7 ( 7 -- 6')%(-) 7 (5 -- 7)%(-) | 6 (6 -- 5')%(-) 6 (4 -- 6)%(-) |
    /* 殺敵人 齊爭先殺 */
    | 5 (5 --4')%(-) 5 (4' -- 2)%(-) | 3 -- (5--1^)%(-) |
    /* 盡敵人 收復失地 最*/
    | 7 (7 -- 6')%(-) 7 (5 -- 7)%(-) | 6 (6 -- 5')%(-) 6 (4--6)%(-) |
    /* 後勝利在眼前*/
    | 5 (5 --4')%(-) 5 (4' -- 2)%(-) | 1 -- 0 |
}

March5:Piano@|-1| {
    <4*>
    /* 我們*/
    | 0 0 0 ( 5_ -- 5_ )%(-) |
    /* 大家是知識青年  我們*/
    | 1 (5_ -- 1)%(-) 3 (1 -- 3)%(-) | (2 -- 7_)%(-) 5 0 ( 5_ -- 5_ )%(-) |
    /* 是國家社會的中堅 今日 */
    | 6 (6_ -- 2)%(-) 4 (4 -- 6)%(-) | (5 -- 4)%(--) 3 ( 3 -- 3 )%(-) |
    /* 來響應領袖的號召 去*/
    | 6 (7 -- 6)%(-) 5 (4 -- 3)%(-) | (4 --5)%(--) (6 0 )%(-) (5--6)%(-) |
    /* 捍衛祖國上前線 */
    | ( 7 7)%(-) (1^--5)%(-) 3 (5--7)%(-) | 1^ -- 0 |
}

-> March1
-> March2
-> March3
-> March4
-> March5
-> #

