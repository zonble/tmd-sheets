::SCORE::
** 青年遠征軍進行曲 **
!= 120
?= C
~ "胡然作曲"
<4/4>

March1:Piano@|0| {
    <4*>
    /* 向前進 勇敢的同志們 */
    | 1 1 6 - | 5 (6 - - 5)%(-) (5 - - 3)%(-) 1 |
    /* 向前進 一起向前進 */
    | 2 2 (7 - -6)%(--) | (5 -- 4)%(-) (3 -- 2')%(-) 3 - |
}

March2:Piano@|0| {
    <4*>
    /* 我們是革命的新軍人 */
    | 1 (3 -- 1 )%(-) 5 (3 -- 1 )%(-) | (5 0)%(-) (6 0)%(-) 7 - |
    /* 我們是反攻的主力軍 */
    | 1^ (1^ 7)%(-) (2^ 1^ )%(-) (7 6)%(-) | (5 0 )%(-) (4' 0)%(-) 5 - |
}

March3:Piano@|0| {
    <4*>
    /* 1. 決心犧牲 貫徹命令 */
    /* 2. 奮勇作戰 殺賊立功 */
    | (6 -- 7)%(--) 6 2 | (5 -- 6)%(--) 5 1 |
    /* 1. 攻無不克 戰無不勝*/
    /* 2. 報酬雪恨 直搗黃龍*/
    | (2 -- 2)%(--) 2 2 | (2 -- 1)%(-) (1 -- 2)%(-) 3 - |
}

March4:Piano@|0| {
    <4*>
    /* 1. 收復失地 消滅敵人 */
    /* 2. 復興民族 永保和平 */
    | (6 -- 7)%(--) 6 2 | (5 -- 6)%(--) 5 1 |
    /* 要把那勝利的旗幟 */
    | (2 2 - 2)%(--) 7 (7 -- 6)%(-) | (5 4' 5 6)%(--) 2 - |
    /* 插上富士山峰 */
    | (7 7 - 6)%(--) (7 -- 7)%(-) 1^ | 2^ - 0 - |
}

March5:Piano@|0| {
    <4*>
    /* 要把那勝利的旗幟 */
    | (5 5 - 5)%(--) 3^ (3^ -- 2^)%(-) | (1^ -- 7)%(--) 1^ - |
    /* 插上富士山峰 */
    | (6 6 - 1^)%(--) (7 -- 6 5 -- 4')%(--) | 5 -- 0 |
}

End:Piano@|0| {
    <4*>
    /* 向前進 勇敢的同志們 */
    | 1 1 6 - | 5 (6 - - 5)%(-) (5 - - 3)%(-) 1 |
    /* 向前進 一起向前進 */
    | 2 2 (7 - -6)%(--) | (5 -- 5)%(-) (7 -- 2^)%(-) 1^ - |
}

-> March1
-> March2
-> March3
-> March4
-> March5
-> March1
-> March2
-> March3
-> March4
-> March5
-> End
-> #

