::SCORE::
** 青年遠征軍陸軍第二零一師師歌 **
!= 120
?= C
~ "胡然作曲"
<4/4>

A:Piano@|0| {
    <4*>
    /* 四海蒼茫佈戰雲 */
    | 5_ 1 3 3 | (5--3)%(-) (2 1)%(-) 2 - |
    /* 男兒執筆賦遠征 */
    | 3 3 5 5 | (2--1)%(-) (1 2)%(-) 3 - |
    /* 收復失地驅敵寇 */
    | 5 5 6 3 | (4--3)%(-) (2 1)%(-) 3 2 |
    /* 雪恥報酬責任不輕 */
    | (1--2)%(-) (3 4)%(-) 5 1 | (3--2)%(-) (1 7_)%(-) 1 - |
}

B:Piano@|0| {
    <4*>
    /* 挺我胸膛 鼓我志氣*/
    | 2 2 2 2 | (1--7_)%(--) 1 2 |
    /* 振作我精神*/
    | (3--2)%(-) (1 2)%(-) 3- |
    /* 偉哉中華 大國民*/
    | 5 5 5 5 | (6--5)%(-) (4 3)%(-) 3 2 |
    /* 勇哉青年 遠征軍 */
    | (1--2)%(-) (3 4)%(-) 5 1 | 3 2 1 0 |
}

C:Piano@|-1| {
    <4*>
    /* 整 */
    | 0 0 0 (0 1)%(-) |
    /* 戈待旦 奮鬥犧牲 */
    | (1--4)%(--) (4--6)%(--) | (6--5)%(--) 5 - |
    /* 團結一致 紀律要嚴明 */
    | (4--4)%(--) 4 4 | (3--2)%(-) (1 3)%(-) 5 - |
    /* 努力向前進 大家記在心 前*/
    | (4--4)%(--) (66)%(-) 5 | (4--3)%(-) (2 1)%(-)2 (5 5) %(-) |
    | (1--1)%(--) (3--1)%(--) | (3--3)%(--) 5 - |
}

-> A
-> B
-> C
->#

