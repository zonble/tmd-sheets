::SCORE::
** 幹幹幹 **
!= 120
?= C
~ "劉雪庵曲"
<2/4>

A:Piano@|0| {
    <4*>
    /* 幹幹幹！幹幹幹！大家努力幹 */
    | (5--5)%(-) 5 | (6--6)%(-) 6 | (1^--6)%(-) (1^--6)%(-) | (5--0)%(--) |
    /* 我們胸中有熱血 手裡有槍彈 要 */
    | (3--3)%(-) (33)%(-) | (5 6 5 3)%(--) | (2 1 2 3)%(--) | 1 (0 3)%(-) |
    /* 快要硬要切實 莫愁莫怕莫迂緩 */
    | (1 0 3 5 0 3)%(--) | 6 (5--3)%(-) | (50 0 6 1^ - - 6)%(--) | 2^ 1^ |
    /* 民眾作後援 自己當前面 */
    | (6 5 3 5)%(--) | (6 5 5 3)%(--) | (1^ 2^ 1^ 6)%(--) | 5 - |
    /* 轟轟烈烈幹一番 端的不負男兒願 */
    | (3 3 5 3)%(--) | (6 3)%(-) 5 | (1^ 6 5 1^)%(--)| 2^ 3^ | 1^ -|
}

-> A
-> #

