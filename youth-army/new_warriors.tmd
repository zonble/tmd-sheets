::SCORE::
** 新戰士進行曲 **
!= 120
?= C
~ "胡然作曲"
<4/4>

Intro:FrenchHorn@|0| {
    <4*>
    | 3^ -- (3^ - 1^ 3^)%(-) | 5^ -- (0 3^) | (1^ 1^)%(-) - - (5 1^)%(-) | 3^ - - 1^ |
    | 3^ -- (3^ - 1^ 3^)%(-) | 5^ -- (0 3^) | (1^ 1^)%(-) - - (5 5^)%(-) | 1^ - - - |
}

March1:Piano@|0| {
    <4*>
    /* 我們是保衛祖國的新戰士 */
    | 1 - - (1 3)%(-) | (5 - 5 5)%(--) - (3 5)%(-) | 1^ - - (0 2^)%(-) | 3^ - - - |
    /* 我們是中華民除的好兒郎 */
    | 2^ - - (2^ 3^)%(-) | (2^ - 1^ 7)%(--) - ( 6 7)%(-) | 2^ - - (0 5)%(-) | 5 - - - |
}

March2:Piano@|0| {
    <4*>
    /* 為了民族的復興 為了大眾的幸福*/
    | (3 3)%(-) 3 - (13)%(-) | 5 - 5 - | (3 3)%(-) 3 - (56)%(-) | 1^ - 1^ - |
    /* 離開溫款的家 踏入武裝的學堂*/
    | (2^ 2^)%(-) 2^ - (1^ 3^)%(-) | 2^ - - - | (5 5 )%(-) 6 - (5 6)%(-) | (7 2^)%(-) 1^- - |
}

March3:Piano@|0| {
    <4*>
    /* 堅定報國意志 忍受一切艱難 */
    | (1^ 1^) - - (1^ 7 )%(-) | (6 6) - - 0 | (2^ 2^) - - (2^ 7)%(-) | (5 5) - - 0 |
    /* 我們只有一心一意 虛心學習*/
    | (5 6) - (5 3 )%(-) - | (1^ 7) - (6 1^)%(-) - | (2^ 2^) - (1^ 2^)%(-) - | 3^ - - 2^ |
    /* 魔與強暴  才會被我們產光 */
    | (1^ 2^) - (3^ 2^) - | 0 0 0 (5 5)%(-) | 6 (5 6)%(-) 7 2^ | 1^ - - (6 6)%(-) |
}
March4:Piano@|0| {
    <4*>
    /* 我們歌頌勝利 這雖是 狂歡的時光 */
    | (6 5)%(-) - - (4 5)%(-) | (5 7)%(-) - - (1^ - 5 1^)%(-) | (1^ 5)%(-) - - (1^ 2^) | 3^ - - 2^ |
    | (2^ 7)%(-) - (6 6)%(-) - | (3^2^)%(-) - - (1^ - 2^ 1^)%(-) | 2^ - - 5 |
    | 5 (5 5)%(-) 6 (5 6)%(-) | 7 -- 2^ | 1^ - - - | - - - - |
}

End:Piano@|0| {
    <4*>
    /* 我們是保衛祖國的新戰士 */
    | 1 - - (1 3)%(-) | (5 - 5 5)%(--) - (3 5)%(-) | 1^ - - (0 2^)%(-) | 3^ - - - |
    /* 我們是中華民除的好兒郎 */
    | 2^ - - (2^ 3^)%(-) | (2^ - 1^ 7)%(--) - ( 6 7)%(-) | 2^ - - (0 5)%(-) | 1^ - - - |
}

-> Intro
-> March1
-> March2
-> March3
-> March4
-> End
-> #

