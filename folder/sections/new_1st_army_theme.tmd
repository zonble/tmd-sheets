::SCORE::
** The New 1st Army & Zongzhi - Grand March of Victory in Guangzhou **

!= 120
?= C
<4/4>

/* 
 * 宗治的 1945 年 10 月
 * 第一部第二景：廣州受降凱旋進行曲（精煉緊湊版）
 *
 * 結構調整說明：
 * 將過於冗長的宗治主題大幅精煉，由 16 小節砍至精準有力的 8 小節，
 * 緊接著在 8 小節的合流中迅速推向全曲高潮與尾聲，節奏緊湊俐落！
 */

-> March_Intro
-> Army_Song_Full
-> Army_Song_Tutti
-> Fanfare_Development
-> Zongzhi_March
-> Grand_Union
-> Grand_Coda
-> #

/* -------------------------------------------------- */
/* 1. March_Intro: 軍樂隊開場引子 (4 measures)        */
/* -------------------------------------------------- */

March_Intro:Drums@|0|{
    <8*>
    | X - S - X - S S | X - S - X - S S |
    | X - S - X - S S | X - S - B - - - |
}

March_Intro:Trumpet@|0|{
    <4*>
    | 0 - - - | 0 - - - |
    | 0 - - (5_ 1)%(-) | 3 - - 0 |
}

March_Intro:Trombone@|0|{
    <4*>
    | 0 - - - | 0 - - - |
    | 0 - - - | 1_ 0 5__ 0 |
}

March_Intro:Strings@|0|{
    <1*>
    0 | 0 | [C] | [C] |
}

/* -------------------------------------------------- */
/* 2. Army_Song_Full: 完整新一軍軍歌原曲 (14 measures)  */
/* -------------------------------------------------- */

Army_Song_Full:Trumpet@|0|{
    <4*>
    /* 吾軍欲發揚，精誠團結無欺罔，矢志 */
    | 0 - 0 (5_ 1)%(-) | (1. 2)%(-) 3 - 1 | 5_ 5_ (2. 1)%(-) 7_ | 2 5 - 0 |
    /* 救國亡，猛士力能守四方。不怕刀和槍，誓把敵人 */
    | 0 - 0 (1 1)%(-) | 6 5 4 (2. 2)%(-) | 5 (3. 1)%(-) 2 3 | 1 0 (3. 2)%(-) (1. 7_)%(-) |
    | 6_ 0 (2. 6_)%(-) (7_. 6_)%(-) |
    /* 降，親上死長，效命疆場，才算好兒郎。 */
    | 5_ 0 5_ (7_. 3)%(-) | 5 - - (5 1 3)%(-) | 6 - - (0. 2)%(-) | 5 (3. 1)%(-) 2 - | 1 - - 0 |
}

Army_Song_Full:Horn@|0|{
    <4*>
    | 0 - - - | 1 - - - | 5_ - - - | 7_ - - - |
    | 1 - - - | 4_ - - - | 1 - - - | 1 - 5_ - |
    | 6_ - 2_ - |
    | 5_ - 5_ - | 1 - - - | 4_ - - - | 5_ - 5__ - | 1 - - 0 |
}

Army_Song_Full:Trombone@|0|{
    <4*>
    | 0 - - - | 1_ 0 5__ 0 | 1_ 0 5__ 0 | 5__ 0 2_ 0 |
    | 1_ 0 5__ 0 | 4_ 0 1_ 0 | 1_ 0 5__ 0 | 1_ 0 5__ 0 |
    | 6__ 0 2_ 0 |
    | 5__ 0 5__ 0 | 1_ 0 5__ 0 | 4_ 0 1_ 0 | 5__ 0 5__ 0 | 1_ 0 1_ 0 |
}

Army_Song_Full:Strings@|0|{
    <4*>
    [C] - [C] - | [C] - [C] - | [C] - [G] - | [G] - [G7] - |
    [C] - [C] - | [F] - [F] - | [C] - [C] - | [C] - [G] - |
    [Am] - [Dm] - |
    [G] - [G7] - | [C] - [C] - | [F] - [F] - | [G] - [G7] - | [C] - - - |
}

Army_Song_Full:Drums@|0|{
    <8*>
    | B - S - X - S S | X - S - X - S S | X - S - X - S S | X - S - X - S S |
    | X - S - X - S S | X - S - X - S S | X - S - X - S S | X - S - X - S S |
    | X - S - X - S S |
    | X - S - X - S S | B - S - X - S S | X - S - X - S S | X - S - X - S S | X - S - B - - - |
}

