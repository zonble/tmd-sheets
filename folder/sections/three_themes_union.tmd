::SCORE::
** Guangzhou 1945 - The Three Themes Union: Elephant, Zongzhi & New 1st Army **

!= 120
?= C
<4/4>

/* 
 * 宗治的 1945 年 10 月
 * 第一部高潮：三大主題大合奏（大象、宗治、新一軍）
 *
 * 戲劇畫面：
 * 1945 年 10 月的廣州長堤，歷史上最不可思議的盛大交匯：
 * 1. 底層：大象林旺（阿妹）踏著沉重憨厚的巨大象步（低音號 Tuba）
 * 2. 中層：讀書人宗治投筆從戎、昂首闊步的廣東鄉音進行曲（法國號 Horn / 弦樂）
 * 3. 高層：新一軍美式鐵軍威風凜凜的受降號角（小號 Trumpet）
 *
 * 結尾要求：
 * 三大主題複調交織後，全樂團全面合流，以「新一軍主題」的最高潮輝煌收尾！
 */

-> Intro_Gathering
-> Layered_Entry
-> Three_Themes_Polyphony
-> Finale_New1stArmy
-> Grand_Cadence
-> #

/* -------------------------------------------------- */
/* 1. Intro_Gathering: 三方在長堤碼頭匯聚 (4 measures) */
/* -------------------------------------------------- */

Intro_Gathering:Drums@|0|{
    <8*>
    | X - S - X - S S | X - S - X - S S |
    | X - S - X - S S | X - S - B - - - |
}

Intro_Gathering:Tuba@|0|{
    <4*>
    | 1__ 0 5___ 0 | 1__ 0 5___ 0 |
    | 1__ 0 5___ 0 | 1__ 0 5___ 0 |
}

Intro_Gathering:Trombone@|0|{
    <4*>
    | 0 - - - | 0 - - - |
    | 1_ 0 5__ 0 | 1_ 0 5__ 0 |
}

Intro_Gathering:Trumpet@|0|{
    <4*>
    | 0 - - - | 0 - - - |
    | 0 - - (5_ 1)%(-) | 3 - - 0 |
}

Intro_Gathering:Strings@|0|{
    <1*>
    0 | 0 | [C] | [C] |
}

/* -------------------------------------------------- */
/* 2. Layered_Entry: 大象與宗治層層疊進 (8 measures)   */
/* -------------------------------------------------- */

Layered_Entry:Tuba@|0|{
    <8*>
    /* 前 4 小節：大象主題率先踩著笨重步伐進場 */
    | 5__ 5__ 5__ 5__ 5__ 3__ 2__ 3__ | 1__ - - - - - - - |
    | 5__ 5__ 5__ 5__ 5__ 3__ 2__ 3__ | 2__ - - - - - - - |
    /* 後 4 小節：大象主題持續在低音支撐 */
    | 5__ 5__ 5__ 5__ 5__ 3__ 2__ 3__ | 1__ - - - - - - - |
    | 6___ 1__ 2__ 3__ 5__ 3__ 2__ 3__ | 1__ - - - - - - - |
}

Layered_Entry:Bassoon@|0|{
    <8*>
    | 0 - - - - - - - | 1_ 3_ 5_ 3_ 1_ 0 0 0 |
    | 0 - - - - - - - | 2_ 4_ 6_ 4_ 2_ 0 0 0 |
    | 5_ 5_ 5_ 5_ 5_ 3_ 2_ 3_ | 1_ 3_ 5_ 3_ 1_ 0 0 0 |
    | 4_ 0 3_ 0 2_ 0 5_ 0 | 1_ 3_ 5_ 1 5_ - - - |
}

Layered_Entry:Horn@|0|{
    <4*>
    | 0 - - - | 0 - - - | 0 - - - | 0 - - - |
    /* 第 5 小節：宗治進行曲以中音號角切入！ */
    | 3. 6 (5 6 5 3)%(--) | 6 - - (7. 6)%(-) | 5. 3 3 (5. 1)%(-) | 2 5 1 - |
}

Layered_Entry:Strings@|0|{
    <4*>
    [C] - [C] - | [C] - [C] - | [G] - [G] - | [G] - [G7] - |
    [C] - [Am] - | [Am] - [Em] - | [F] - [C] - | [G7] - [C] - |
}

Layered_Entry:Drums@|0|{
    <8*>
    | B - S - X - S S | X - S - X - S S | X - S - X - S S | X - S - X - S S |
    | B - S - X - S S | X - S - X - S S | X - S - X - S S | X - S - B - - - |
}

/* -------------------------------------------------- */
/* 3. Three_Themes_Polyphony: 三大主題三重對位合奏！(12 measures) */
/* -------------------------------------------------- */

/* 高音部：新一軍軍歌鋼鐵號角翱翔 */
Three_Themes_Polyphony:Trumpet@|0|{
    <4*>
    | (1^. 2^)%(-) 3^ - 1^ | 5 5 (2^. 1^)%(-) 7 | 2^ 5 - 0 | (1^ 1^)%(-) 6^ 5^ 4^ |
    | (2^. 2^)%(-) 5^ (3^. 1^)%(-) | 2^ 3^ 1^ 0 | (3^. 2^)%(-) (1^. 7)%(-) 6 0 | (2^. 6)%(-) (7. 6)%(-) 1^ 0 |
    | (1^. 2^)%(-) 3^ - 1^ | 5 5 (2^. 1^)%(-) 7 | 2^ 5 - 0 | (1^ 1^)%(-) 6^ 5^ 4^ |
}

/* 中音部：宗治進行曲在管弦樂中層英武穿梭 */
Three_Themes_Polyphony:Horn@|0|{
    <4*>
    | 3. 6 (5 6 5 3)%(--) | 6 - - (7. 6)%(-) | 5. 3 3 (5. 1)%(-) | 2 7_ 7_ 5_ |
    | 3. 6 (5 6 5 3)%(--) | 6 - - (7. 6)%(-) | 5. 3 3 (5. 1)%(-) | 2 5 1 - |
    | 3. 6 (5 6 5 3)%(--) | 6 - - (7. 6)%(-) | 5. 3 3 (5. 1)%(-) | 2 7_ 2 6_ |
}

/* 低音部：大象林旺主題以低音號頑強而沉重地踏步 */
Three_Themes_Polyphony:Tuba@|0|{
    <8*>
    | 5__ 5__ 5__ 5__ 5__ 3__ 2__ 3__ | 1__ - - - - - - - |
    | 5__ 5__ 5__ 5__ 5__ 3__ 2__ 3__ | 2__ - - - - - - - |
    | 5__ 5__ 5__ 5__ 5__ 3__ 2__ 3__ | 1__ - - - - - - - |
    | 6___ 1__ 2__ 3__ 5__ 3__ 2__ 3__ | 1__ - - - - - - - |
    | 5__ 5__ 5__ 5__ 5__ 3__ 2__ 3__ | 1__ - - - - - - - |
    | 5__ 5__ 5__ 5__ 5__ 3__ 2__ 3__ | 1__ - - - - - - - |
}

Three_Themes_Polyphony:Trombone@|0|{
    <4*>
    | 1_ 0 5__ 0 | 1_ 0 5__ 0 | 5__ 0 2_ 0 | 1_ 0 5__ 0 |
    | 4_ 0 1_ 0  | 1_ 0 5__ 0 | 5__ 0 5__ 0 | 1_ 0 1_ 0 |
    | 1_ 0 5__ 0 | 1_ 0 5__ 0 | 5__ 0 2_ 0 | 1_ 0 5__ 0 |
}

Three_Themes_Polyphony:Strings@|0|{
    <4*>
    [C] - [C] - | [C] - [G] - | [G] - [G7] - | [C] - [F] - |
    [F] - [C] - | [C] - [C] - | [G] - [G7] - | [C] - - - |
    [C] - [C] - | [C] - [G] - | [G] - [G7] - | [C] - [F] - |
}

Three_Themes_Polyphony:Drums@|0|{
    <8*>
    | B - S - X - S S | X - S - X - S S | X - S - X - S S | X - S - X - S S |
    | B - S - X - S S | X - S - X - S S | X - S - X - S S | X - S - X - S S |
    | B - S - X - S S | X - S - X - S S | X - S - X - S S | B - B - B - - - |
}

/* -------------------------------------------------- */
/* 4. Finale_New1stArmy: 全體合流，以新一軍軍歌終曲高潮 (10 measures) */
/* -------------------------------------------------- */

Finale_New1stArmy:Trumpet@|0|{
    <4*>
    /* 親上死長，效命疆場，才算好兒郎！ */
    | 5 0 5 (7. 3^)%(-) | 5^ - - (5 1 3)%(-) | 6 - - (0. 2)%(-) | 5 (3. 1)%(-) 2 - | 1 - - 0 |
    /* 終極衝頂重複！ */
    | 0 - 0 (5 1 3)%(-) | 6^ - - (0. 2^)%(-) | 5^ (3^. 1^)%(-) 2^ - | 1^ - - - | 1^ 0 0 0 |
}

Finale_New1stArmy:Flute@|0|{
    <8*>
    | 5 7 2^ 5^ 7 2^ 5^ 7^ | 5^ 1^^ 3^^ 1^^ 5^ 3^ 1^ 3^ | 4^ 6^ 1^^ 6^ 4^ 2^ 1^ 2^ | 5^ 3^ 1^ 3^ 2^ 7 5 7 | 1^ 3^ 5^ 1^^ 1^ 0 0 0 |
    | 0 - - - 5^ 1^^ 3^^ 1^^ | 4^^ 6^^ 1^^^ 6^^ 4^^ 2^^ 1^^ 2^^ | 5^^ 3^^ 1^^ 3^^ 2^^ 7^ 5^ 7^ | 1^^ - - - - - - - | 1^^ 0 0 0 0 - - - |
}

Finale_New1stArmy:Horn@|0|{
    <4*>
    | 5_ - 5_ - | 1 - - (5_ 1 3)%(-) | 4 - - (0. 2)%(-) | 1 - 7_ - | 1 - - 0 |
    | 0 - - (5_ 1 3)%(-) | 4 - - (0. 2)%(-) | 1 - 7_ - | 1 - - - | 1 0 0 0 |
}

Finale_New1stArmy:Trombone@|0|{
    <4*>
    | 5__ 0 5__ 0 | 1_ 0 5__ 0 | 4_ 0 1_ 0 | 5__ 0 5__ 0 | 1_ 0 1_ 0 |
    | 0 - 0 1_    | 4_ 0 1_ 0  | 5__ 0 5__ 0 | 1_ - - - | 1_ 0 0 0 |
}

Finale_New1stArmy:Tuba@|0|{
    <4*>
    | 5__ 0 5__ 0 | 1__ 0 5___ 0 | 4__ 0 1__ 0 | 5__ 0 5___ 0 | 1__ 0 1__ 0 |
    | 0 - 0 1__   | 4__ 0 1__ 0  | 5__ 0 5___ 0 | 1__ - - - | 1__ 0 0 0 |
}

Finale_New1stArmy:Strings@|0|{
    <4*>
    [G] - [G7] - | [C] - [C] - | [F] - [F] - | [G] - [G7] - | [C] - - - |
    [C] - [C] -  | [F] - [F] - | [G] - [G7] - | [C] - - - | [C] - - - |
}

Finale_New1stArmy:Drums@|0|{
    <8*>
    | X - S - X - S S | B - S - X - S S | B - S - X - S S | X - S - X - S S | B - S - X - S S |
    | B - S - X - S S | B - S - X - S S | X - S - X - S S | B - B - B - B - | B - 0 - 0 - - - |
}

/* -------------------------------------------------- */
/* 5. Grand_Cadence: 全城歡騰大定格 (4 measures)       */
/* -------------------------------------------------- */

Grand_Cadence:Trumpet@|0|{
    <4*>
    | 1^^ - - - | 5^ - - - | 1^^ - - - | 1^^ 0 0 0 |
}

Grand_Cadence:Flute@|0|{
    <4*>
    | 1^^ - - - | 5^^ - - - | 1^^^ - - - | 1^^^ 0 0 0 |
}

Grand_Cadence:Horn@|0|{
    <4*>
    | 3 - - - | 5 - - - | 1^ - - - | 1^ 0 0 0 |
}

Grand_Cadence:Trombone@|0|{
    <4*>
    | 1_ - - - | 5__ - - - | 1_ - - - | 1_ 0 0 0 |
}

Grand_Cadence:Tuba@|0|{
    <4*>
    | 1__ - - - | 5___ - - - | 1__ - - - | 1__ 0 0 0 |
}

Grand_Cadence:Strings@|0|{
    <1*>
    [C] | [G] | [C] | [C] |
}

Grand_Cadence:Drums@|0|{
    <8*>
    | B - S - X - S S | B - S - X - S S | B - B - B - B - | B - 0 - 0 - - - |
}
