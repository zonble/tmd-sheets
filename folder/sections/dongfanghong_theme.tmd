    | 6__ 0 0 0 | 0 - - - |
    | 3__ 0 0 0 | 0 - - - |
    | 6__ 0 0 0 | 4__ 0 0 0 |
    | 3__ 0 0 0 | 6__ 0 6__ 0 |
}

