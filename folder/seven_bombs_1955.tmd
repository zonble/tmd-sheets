::SCORE::
** Movement III - Seven Incendiary Bombs 1955 (第三樂章：1955 年宗治二哥身上的七顆燃燒彈) **

!= 60
?= C
<4/4>

/* 
 * ===================================================================
 * 第三樂章核心悲劇：1955 年宗治二哥身上的七顆燃燒彈
 *
 * 1955 年，台海戰火熾烈，沿海島嶼與陣地陷入火海。
 * 凝固汽油燃燒彈從天呼嘯而降，七次滅絕人性的毀滅性撞擊，
 * 依次砸在至親的血肉之軀上。
 *
 * 【七次重擊結構 (The 7 Napalm Impacts)】：
 * 每一擊都由「高空尖嘯下墜 -> 鋼琴極低音簇與大鼓/定音鼓殘暴爆轟 -> 烈焰燃燒餘燼」構成：
 * 
 * 1. 第一擊 (Bar 1-2)：呼嘯而來，首度炸裂，血肉橫飛
 * 2. 第二擊 (Bar 3-4)：緊隨其後，衝擊波撕裂大地
 * 3. 第三擊 (Bar 5-6)：地火噴湧，長號撕裂哀號
 * 4. 第四擊 (Bar 7-8)：連續重砸，火海無處可逃
 * 5. 第五擊 (Bar 9-10)：骨肉焦黑，低音號砸入深淵
 * 6. 第六擊 (Bar 11-12)：瀕死窒息，定音鼓狂亂抽搐
 * 7. 第七擊 (Bar 13-16)：最後致命一擊，毀天滅地！隨後萬籟俱寂，只剩餘燼白煙
 * ===================================================================
 */

-> SevenBombs_Impacts_1_to_3
-> SevenBombs_Impacts_4_to_6
-> SevenBombs_Seventh_Final_Blast
-> SevenBombs_Burning_Ashes_Dirge
-> #

/* -------------------------------------------------------------------
   第一至第三擊（6 小節，24 秒）：
   第 1 擊 (Bar 1)、第 2 擊 (Bar 3)、第 3 擊 (Bar 5)
   ------------------------------------------------------------------- */
SevenBombs_Impacts_1_to_3:Timpani@|0|{
    <4*>
    /* 第 1 擊 */
    | 1__ - 1__ 0 | 0 - - - |
    /* 第 2 擊 */
    | 1__ - 1__ 0 | 0 - - - |
    /* 第 3 擊 (更沉重雙重轟擊) */
    | 1__ 1__ 1__ 0 | 0 - - - |
}

SevenBombs_Impacts_1_to_3:Drums@|0|{
    <4*>
    /* 巨響爆炸聲 (B=Bass Drum, S=Snare shockwave) */
    | B - S 0 | 0 - - - |
    | B - S 0 | 0 - - - |
    | B S B 0 | 0 - - - |
}

SevenBombs_Impacts_1_to_3:Piano@|0|{
    <4*>
    /* 極低音不協和音簇重砸 (Cluster Bomb) + 極高音尖嘯 */
    | (1___ 2___ 3___)%(-) - - 0 | 0 - - - |
    | (1___ 2___ 3___)%(-) - - 0 | 0 - - - |
    | (1___ 2___ 3___)%(-) - - 0 | 0 - - - |
}

SevenBombs_Impacts_1_to_3:Strings@|0|{
    <4*>
    /* 烈火焚燒撕裂顫音 (Tremolo) */
    | [Am] - - 0 | [Am] - - - |
    | [Bdim] - - 0 | [Bdim] - - - |
    | [F] - - 0 | [E7] - - - |
}

SevenBombs_Impacts_1_to_3:Trombone@|0|{
    <4*>
    | 0 - - - | 0 - - - |
    | 0 - - - | 0 - - - |
    | 6__ - - 0 | 3__ - - - |
}

SevenBombs_Impacts_1_to_3:Tuba@|0|{
    <4*>
    | 6___ - - 0 | 0 - - - |
    | 6___ - - 0 | 0 - - - |
    | 4___ - - 0 | 3___ - - - |
}

/* -------------------------------------------------------------------
   第四至第六擊（6 小節，24 秒）：
   第 4 擊 (Bar 7)、第 5 擊 (Bar 9)、第 6 擊 (Bar 11)
   間隔更緊密、火焰高溫持續上升
   ------------------------------------------------------------------- */
SevenBombs_Impacts_4_to_6:Timpani@|0|{
    <4*>
    /* 第 4 擊 */
    | 1__ 1__ 1__ 1__ | 1__ 0 0 0 |
    /* 第 5 擊 */
    | 1__ 1__ 1__ 1__ | 1__ 0 0 0 |
    /* 第 6 擊 */
    | 1__ 1__ 1__ 1__ | 1__ 1__ 1__ 0 |
}

SevenBombs_Impacts_4_to_6:Drums@|0|{
    <4*>
    | B S B S | B 0 0 0 |
    | B S B S | B 0 0 0 |
    | B S B S | B S B 0 |
}

SevenBombs_Impacts_4_to_6:Piano@|0|{
    <8*>
    | 1___ 2___ 3___ 1___  0 - - - | 0 - - - - - - - |
    | 1___ 2___ 3___ 1___  0 - - - | 0 - - - - - - - |
    | 1___ 2___ 3___ 1___  0 - - - | 0 - - - - - - - |
}

SevenBombs_Impacts_4_to_6:Flute@|0|{
    <4*>
    /* 高空刺耳呼嘯下墜尖叫 */
    | 3^^ - - 0 | 0 - - - |
    | 4^^ - - 0 | 0 - - - |
    | 5^^ - - 0 | 0 - - - |
}

SevenBombs_Impacts_4_to_6:Trumpet@|0|{
    <4*>
    | 0 - - - | 3^ 0 0 0 |
    | 0 - - - | 4^ 0 0 0 |
    | 0 - - - | 5^ 0 0 0 |
}

SevenBombs_Impacts_4_to_6:Trombone@|0|{
    <4*>
    | 6__ - - 0 | 0 - - - |
    | 4__ - - 0 | 0 - - - |
    | 3__ - - 0 | 0 - - - |
}

SevenBombs_Impacts_4_to_6:Tuba@|0|{
    <4*>
    | 6___ - - 0 | 0 - - - |
    | 4___ - - 0 | 0 - - - |
    | 3___ - - 0 | 0 - - - |
}

SevenBombs_Impacts_4_to_6:Strings@|0|{
    <4*>
    [Am] - [Dm] - | [E7] - - - |
    [F] - [Bdim] - | [E7] - - - |
    [Dm] - [E7] - | [Am] - [E7] - |
}

/* -------------------------------------------------------------------
   第七擊：致命天火終極爆轟（4 小節，16 秒）：
   第 7 擊 (Bar 13) 毀天滅地全力砸下，隨後全頻段音浪逐漸被燒成灰燼
   ------------------------------------------------------------------- */
SevenBombs_Seventh_Final_Blast:Timpani@|0|{
    <4*>
    /* 第 7 擊：毀滅性連環重槌爆裂 */
    | 1__ 1__ 1__ 1__ | 1__ 1__ 1__ 1__ |
    | 1__ - - - | 0 - - - |
}

SevenBombs_Seventh_Final_Blast:Drums@|0|{
    <4*>
    | B S B S | B S B S |
    | B - - - | 0 - - - |
}

SevenBombs_Seventh_Final_Blast:Piano@|0|{
    <4*>
    | (1___ 2___ 3___ 4___)%(-) - - - | - - - - |
    | 0 - - - | 0 - - - |
}

SevenBombs_Seventh_Final_Blast:Trumpet@|0|{
    <4*>
    | 6^ - - - | - - - - |
    | 0 - - - | 0 - - - |
}

SevenBombs_Seventh_Final_Blast:Flute@|0|{
    <4*>
    | 6^^ - - - | - - - - |
    | 0 - - - | 0 - - - |
}

SevenBombs_Seventh_Final_Blast:Trombone@|0|{
    <4*>
    | 6_ - - - | - - - - |
    | 0 - - - | 0 - - - |
}

SevenBombs_Seventh_Final_Blast:Tuba@|0|{
    <4*>
    | 6___ - - - | - - - - |
    | 0 - - - | 0 - - - |
}

SevenBombs_Seventh_Final_Blast:Strings@|0|{
    <4*>
    [Am] - - - | - - - - |
    [Am] - - - | [Am] 0 0 0 |
}

/* -------------------------------------------------------------------
   餘燼與血肉白煙（4 小節，16 秒）：
   爆炸止息，大火無聲蔓延，大提琴撕裂哀鳴，宗治主題在煙硝中殘破哭泣
   ------------------------------------------------------------------- */
SevenBombs_Burning_Ashes_Dirge:Cello@|0|{
    <4*>
    /* 宗治主題在至親焦黑肉身前的無聲痛哭 */
    | 3_ 6_ 5_ 3_ | 6_ - - 7__ |
    | 5_ 3_ 2_ 1_ | 6__ - - - |
}

SevenBombs_Burning_Ashes_Dirge:Clarinet@|0|{
    <4*>
    | 0 - - - | 3 2 1 7_ |
    | 1 7_ 6_ 5_ | 6_ - - - |
}

SevenBombs_Burning_Ashes_Dirge:Strings@|0|{
    <4*>
    [Am] - - - | [Dm] - - - |
    [E7] - - - | [Am] - - - |
}

SevenBombs_Burning_Ashes_Dirge:Timpani@|0|{
    <4*>
    | 0 - - - | 0 - - - |
    | 0 - - - | 1__ 0 0 0 |
}
