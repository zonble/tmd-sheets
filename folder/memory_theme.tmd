::SCORE::
** Theme of Memory (回憶的主題 / 「我」的主題) **

!= 72
?= C
<4/4>

/* 
 * 宗治的 1945 年 10 月
 * 全劇時空之門：回憶的主題（「我」的主題）
 *
 * 創作者自述：
 * 這是「我」的回憶，也是「我」的主題。
 * 身為後人的我，坐在安靜的鋼琴前，凝望爺爺八十年前留下來的歷史痕跡。
 * 旋律溫柔、清澈，帶著敬意與思念。
 * 最後一句由 3 2 1 沉入 7_ 5_，復起 7_ 2 3，
 * 輕輕落在羽音 6_（La）上——
 * 那正是宗治爺爺主題（3 6）的起點。
 * 我用這段旋律，在時空深處將爺爺喚醒。
 */

-> Memory_Solo_Piano
-> Memory_Full_Ensemble
-> Memory_Handoff_To_Zongzhi
-> #

/* -------------------------------------------------- */
/* 1. Memory_Solo_Piano: 「我」在鋼琴前的獨白 (8 measures) */
/* -------------------------------------------------- */

Memory_Solo_Piano:Piano@|0|{
    <4*>
    /* 前半段：一聲長嘆，思緒回到從前 */
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-) 2 1 | 2 1 5_ - |
    | 0 3 2 3 | 5 - 3 - | 2 - 5 - | 3 - - - |
}

Memory_Solo_Piano:Strings@|0|{
    <1*>
    [C] | [Am] | [F] | [C] |
    [Em] | [Am] | [G] | [C] |
}

Memory_Solo_Piano:Cello@|0|{
    <1*>
    1_ | 6__ | 4__ | 1_ |
    3__ | 6__ | 5__ | 1_ |
}

/* -------------------------------------------------- */
/* 2. Memory_Full_Ensemble: 弦樂與木管溫柔包覆 (8 measures) */
/* -------------------------------------------------- */

Memory_Full_Ensemble:Clarinet@|0|{
    <4*>
    /* 後半段：思念綿延，走向那個懸在半空的 6_ */
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-) 2 1 | (2 2)%(-) 1 5_ - |
    | 0 3 2 1 | 7_ - 5_ - | 7_ - 2 3 | 1 6_ - - |
}

Memory_Full_Ensemble:Piano@|0|{
    <8*>
    | 1 3 5 3  1 3 5 3 | 6_ 1 3 1  6_ 1 3 1 | 4_ 6_ 1 6_  4_ 6_ 1 6_ | 1 3 5 3  5_ 1 3 1 |
    | 6_ 1 3 1  6_ 1 3 1 | 5_ 7_ 2 7_  5_ 2 7_ 2 | 5_ 7_ 2 7_  5_ 2 3 2 | 6_ 1 3 1  6_ - - - |
}

Memory_Full_Ensemble:Strings@|0|{
    <4*>
    [C] - [C] - | [Am] - [Am] - | [F] - [F] - | [C] - [G] - |
    [Am] - [Am] - | [Em] - [G] - | [G] - [Em] - | [Am] - - - |
}

Memory_Full_Ensemble:Cello@|0|{
    <1*>
    1_ | 6__ | 4__ | 1_ |
    6__ | 3__ | 5__ | 6__ |
}

/* -------------------------------------------------- */
/* 3. Memory_Handoff_To_Zongzhi: 時空交接，喚醒宗治 (4 measures) */
/* -------------------------------------------------- */

Memory_Handoff_To_Zongzhi:Flute@|0|{
    <4*>
    | 0 3 2 1 | 2 1 - - | 0 2 3 2 | 6_ - - - |
}

Memory_Handoff_To_Zongzhi:Piano@|0|{
    <4*>
    | 0 - - - | 0 - - - | 0 - - - | 6_ 3_ 6__ - |
}

Memory_Handoff_To_Zongzhi:Strings@|0|{
    <1*>
    [F] | [C] | [Esus4] | [Am] |
}

Memory_Handoff_To_Zongzhi:Cello@|0|{
    <1*>
    4__ | 1_ | 3__ | 6__ |
}
