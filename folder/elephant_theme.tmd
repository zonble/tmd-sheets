::SCORE::
** The Elephant's Theme - Lin Wang in Guangzhou 1945 **

!= 88
?= C
<4/4>

/* 
 * 宗治的 1945 年 10 月
 * 第一部第三景：大象的主題（林旺在廣州）
 *
 * 歷史情境：
 * 1945 年秋，新一軍將在緬甸接收的戰象隊伍（包含林旺，當時叫阿妹）一路長征牽至廣州。
 * 巨大的戰象搖搖晃晃走在廣州城內，背負著叢林戰火的記憶，步伐沉重而溫厚。
 *
 * 音樂核心：
 * 以《快樂天堂》第一句「大象長長的鼻子正昂揚」為骨骼變奏：
 * <8*> | 5 5 5 5 5 3 2 3 | 1 - - - - - - - |
 * 透過低音號（Tuba）、低音管（Bassoon）與重踏步奏，
 * 刻劃巨獸笨重、蹣跚、搖晃卻無比溫柔的性格。
 */

-> Elephant_Steps
-> LinWang_Theme_Solo
-> Gentle_Giant
-> Elephant_March
-> Coda_Steps
-> #

/* -------------------------------------------------- */
/* 1. Elephant_Steps: 遠方傳來巨大的重踏步 (4 measures) */
/* -------------------------------------------------- */

Elephant_Steps:Cello@|0|{
    <4*>
    | 1__ 0 5___ 0 | 1__ 0 5___ 0 |
    | 1__ 0 5___ 0 | 1__ 0 5___ 0 |
}

Elephant_Steps:Bassoon@|0|{
    <4*>
    | 0 - - - | 0 - - - |
    <8*>
    | 1_ 0 3_ 0 2_ 0 5_ 0 | 1_ - - - 0 - - - |
}

Elephant_Steps:Drums@|0|{
    <4*>
    | A 0 A 0 | A 0 A 0 |
    | A 0 A 0 | A 0 A 0 |
}

Elephant_Steps:Strings@|0|{
    <1*>
    0 | 0 | [C] | [C] |
}

/* -------------------------------------------------- */
/* 2. LinWang_Theme_Solo: 低音號憨厚吹出林旺動機 (8 measures) */
/* -------------------------------------------------- */

LinWang_Theme_Solo:Tuba@|0|{
    <8*>
    /* 大象長長的鼻子正昂揚 */
    | 5__ 5__ 5__ 5__ 5__ 3__ 2__ 3__ | 1__ - - - - - - - |
    | 5__ 5__ 5__ 5__ 5__ 3__ 2__ 3__ | 2__ - - - - - - - |
    | 5__ 5__ 5__ 5__ 5__ 3__ 2__ 3__ | 1__ - - - - - - - |
    | 6___ 1__ 2__ 3__ 5__ 3__ 2__ 3__ | 1__ - - - - - - - |
}

LinWang_Theme_Solo:Bassoon@|0|{
    <8*>
    | 0 - - - - - - - | 1_ 3_ 5_ 3_ 1_ 0 0 0 |
    | 0 - - - - - - - | 2_ 4_ 6_ 4_ 2_ 0 0 0 |
    | 0 - - - - - - - | 1_ 3_ 5_ 3_ 1_ 0 0 0 |
    | 4_ 0 3_ 0 2_ 0 5_ 0 | 1_ 3_ 5_ 1 5_ - - - |
}

LinWang_Theme_Solo:Cello@|0|{
    <4*>
    | 1__ 0 5___ 0 | 1__ 0 5___ 0 |
    | 2__ 0 5___ 0 | 2__ 0 5___ 0 |
    | 1__ 0 5___ 0 | 1__ 0 5___ 0 |
    | 4__ 0 5___ 0 | 1__ 0 5___ 0 |
}

LinWang_Theme_Solo:Strings@|0|{
    <4*>
    [C] - [C] - | [C] - [C] - |
    [G] - [G] - | [G] - [G7] - |
    [C] - [C] - | [C] - [C] - |
    [F] - [G] - | [C] - [C] - |
}

LinWang_Theme_Solo:Drums@|0|{
    <4*>
    | A 0 A 0 | A 0 A 0 |
    | A 0 A 0 | A 0 A 0 |
    | A 0 A 0 | A 0 A 0 |
    | A 0 A 0 | A 0 A 0 |
}

/* -------------------------------------------------- */
/* 3. Gentle_Giant: 圍觀的孩童與溫和的巨獸 (8 measures) */
/* -------------------------------------------------- */

Gentle_Giant:Clarinet@|0|{
    <8*>
    | 5 5 5 5 5 3 2 3 | 1 - - - 3 5 1^ 5 |
    | 5 5 5 5 5 3 2 3 | 2 - - - 4 6 2^ 6 |
    | 5 5 5 5 5 3 2 3 | 1 - - - 3 5 1^ 5 |
    | 6 1^ 2^ 3^ 5 3 2 3 | 1 - - - - - - - |
}

Gentle_Giant:Flute@|0|{
    <4*>
    | 0 - - - | 0 - 0 3^ |
    | 2^ - - - | 0 - 0 4^ |
    | 3^ - - - | 0 - 0 5^ |
    <8*>
    | 6^ 5^ 4^ 3^ 2^ 3^ 2^ 7 | 1^ - - - - - - - |
}

Gentle_Giant:Bassoon@|0|{
    <8*>
    | 5_ 5_ 5_ 5_ 5_ 3_ 2_ 3_ | 1_ - - - - - - - |
    | 5_ 5_ 5_ 5_ 5_ 3_ 2_ 3_ | 2_ - - - - - - - |
    | 5_ 5_ 5_ 5_ 5_ 3_ 2_ 3_ | 1_ - - - - - - - |
    | 4_ 0 3_ 0 2_ 0 5_ 0 | 1_ - - - - - - - |
}

Gentle_Giant:Strings@|0|{
    <4*>
    [C] - [Am] - | [F] - [C] - |
    [G] - [Em] - | [Dm] - [G7] - |
    [C] - [Am] - | [F] - [C] - |
    [F] - [G7] - | [C] - - - |
}

Gentle_Giant:Cello@|0|{
    <4*>
    | 1_ 0 6__ 0 | 4__ 0 1_ 0 |
    | 5__ 0 3__ 0 | 2__ 0 5__ 0 |
    | 1_ 0 6__ 0 | 4__ 0 1_ 0 |
    | 4__ 0 5__ 0 | 1_ 0 1_ 0 |
}

Gentle_Giant:Drums@|0|{
    <8*>
    | A - S - A - S - | A - S - A - S - |
    | A - S - A - S - | A - S - A - S - |
    | A - S - A - S - | A - S - A - S - |
    | A - S - A - S - | A - S - B - - - |
}

/* -------------------------------------------------- */
/* 4. Elephant_March: 戰象隨部隊莊嚴前進 (8 measures)  */
/* -------------------------------------------------- */

Elephant_March:Tuba@|0|{
    <8*>
    | 5__ 5__ 5__ 5__ 5__ 3__ 2__ 3__ | 1__ - - - - - - - |
    | 5__ 5__ 5__ 5__ 5__ 3__ 2__ 3__ | 2__ - - - - - - - |
    | 5__ 5__ 5__ 5__ 5__ 3__ 2__ 3__ | 1__ - - - - - - - |
    | 6___ 1__ 2__ 3__ 5__ 3__ 2__ 3__ | 1__ - - - - - - - |
}

Elephant_March:Horn@|0|{
    <8*>
    | 5_ 5_ 5_ 5_ 5_ 3_ 2_ 3_ | 1_ - - - 3_ 5_ 1 5_ |
    | 5_ 5_ 5_ 5_ 5_ 3_ 2_ 3_ | 2_ - - - 4_ 6_ 2 6_ |
    | 5_ 5_ 5_ 5_ 5_ 3_ 2_ 3_ | 1_ - - - 3_ 5_ 1 5_ |
    | 6_ 1 2 3 5_ 3_ 2_ 3_ | 1_ - - - - - - - |
}

Elephant_March:Trumpet@|0|{
    <4*>
    | 0 - - - | 1 - 3 - | 2 - - - | 2 - 4 - |
    | 3 - - - | 3 - 5 - | 4 - 5 - | 3 - - 0 |
}

Elephant_March:Strings@|0|{
    <4*>
    [C] - [C] - | [C] - [C] - |
    [G] - [G] - | [G] - [G7] - |
    [C] - [C] - | [C] - [C] - |
    [F] - [G7] - | [C] - - - |
}

Elephant_March:Cello@|0|{
    <4*>
    | 1_ 0 5__ 0 | 1_ 0 5__ 0 |
    | 2_ 0 5__ 0 | 2_ 0 5__ 0 |
    | 1_ 0 5__ 0 | 1_ 0 5__ 0 |
    | 4_ 0 5__ 0 | 1_ 0 1_ 0 |
}

Elephant_March:Drums@|0|{
    <8*>
    | B - S - A - S - | A - S - A - S - |
    | B - S - A - S - | A - S - A - S - |
    | B - S - A - S - | A - S - A - S - |
    | B - S - A - S - | B - B - B - - - |
}

/* -------------------------------------------------- */
/* 5. Coda_Steps: 象步遠去，走向白雲山 (4 measures)   */
/* -------------------------------------------------- */

Coda_Steps:Tuba@|0|{
    <8*>
    | 5__ 3__ 2__ 3__ 1__ - - - | 0 - - - - - - - |
    | 5__ 3__ 1__ - - - - - | 0 - - - - - - - |
}

Coda_Steps:Cello@|0|{
    <4*>
    | 1__ 0 5___ 0 | 1__ 0 0 0 |
    | 1__ 0 5___ 0 | 1__ 0 0 0 |
}

Coda_Steps:Clarinet@|0|{
    <4*>
    | 0 - - - | 3 2 1 - |
    | 0 - - - | 1 - - - |
}

Coda_Steps:Strings@|0|{
    <1*>
    [C] | [C] | [C] | [C] |
}

Coda_Steps:Drums@|0|{
    <4*>
    | A 0 0 0 | A 0 0 0 |
    | A 0 0 0 | 0 - - - |
}
