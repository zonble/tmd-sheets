::SCORE::
** Movement III - Zongzhi's Variation: The Endless Void - Dayuan 1998 (宗治主題變奏：大園空難・極度哀慟) **

!= 52
?= C
<4/4>

/* 
 * ===================================================================
 * 第三樂章：宗治的主題變奏（大園 1998・極度哀傷與殘酷裂解）
 *
 * 歷史與家國創痛：
 * 宗治老人在歷經了一生的戰火、逃難、內戰、整肅與飄零之後，
 * 命運竟在 1998 年的春夜，再次以最殘酷的方式撕裂這個家庭——
 * 華航 676 號班機於大園失事墜毀。
 * 
 * 昔日歷經萬難拼湊起來的血肉與平靜，
 * 在漆黑的夜空與烈火殘骸中，瞬間灰飛煙滅。
 *
 * 音樂語彙：
 * 速度降至極緩慢的葬禮行板 (!= 52)。
 * 宗治主題被徹底撕裂成破碎、無力的低泣與絕望的嘶吼。
 * 
 * 結構：
 * 1. 【永夜與悶雷】(Dayuan_Night_Omen, 4 小節)：
 *    極低音大提琴空弦與定音鼓不祥的悶震，漆黑雨夜。
 * 2. 【宗治主題的悲泣與崩解】(Zongzhi_Elegy_Cello, 8 小節)：
 *    大提琴在最高把位發出撕心裂肺、顫抖哭泣的宗治動機，
 *    弦樂打出劇烈刺骨的減七和弦與不協和音，如白髮人送黑髮人的無聲慟哭。
 * 3. 【烈焰後的死寂與殘骸】(Ashes_Desolation, 8 小節)：
 *    單簧管獨奏在極低音區乾枯嗚咽，如在大雨滂沱的焦黑殘骸中尋找親人，
 *    只剩冰冷雨水滴落瓦礫的空響。
 * 4. 【問天無語】(Unanswered_Cry, 4 小節)：
 *    鋼琴孤零零敲下三個刺痛心房的高音，長久懸空，沉入永遠無法癒合的巨大悲慟。
 * ===================================================================
 */

-> Dayuan_Night_Omen
-> Zongzhi_Elegy_Cello
-> Ashes_Desolation
-> Unanswered_Cry
-> #

/* -------------------------------------------------------------------
   1. 永夜與悶雷（4 小節，18 秒）：
      1998 年 2 月 16 日夜晚，大園濃霧冰雨，低音弦樂如無底深淵
   ------------------------------------------------------------------- */
Dayuan_Night_Omen:Timpani@|0|{
    <4*>
    | 6___ 0 0 0 | 6___ 0 0 0 |
    | 6___ 0 0 0 | 6___ - - 0 |
}

Dayuan_Night_Omen:Cello@|0|{
    <4*>
    | 6__ - - - | 5__ - - - |
    | 4__ - - - | 3__ - - - |
}

Dayuan_Night_Omen:Strings@|0|{
    <4*>
    [Am] - - - | [Am/G] - - - |
    [F#dim] - - - | [Esus4] - [E] - |
}

Dayuan_Night_Omen:Piano@|0|{
    <4*>
    | 0 - - - | 0 - - - |
    | 0 - - - | 0 0 0 3 |
}

/* -------------------------------------------------------------------
   2. 宗治主題的悲泣與崩解（8 小節，37 秒）：
      大提琴在高音區撕心裂肺地拉出宗治主題，
      每一次音符的揚起，都是老人心頭被生生割裂的劇痛
   ------------------------------------------------------------------- */
Zongzhi_Elegy_Cello:Cello@|0|{
    <4*>
    /* 撕裂的宗治主題：高音淒厲、顫抖、哭泣 */
    | 3 6 (5 6 5 3)%(--) | 6 - - (7_ 6_)%(-) | 5 3 3 (5 1)%(-) | 2 7_ 7_ 5_ |
    | 3 6 (5 6 5 3)%(--) | 6 - - (7_ 6_)%(-) | 5 3 2 3 | 6__ - - - |
}

Zongzhi_Elegy_Cello:Strings@|0|{
    <4*>
    /* 刺骨尖銳的不協和與痛徹心扉的減和弦 */
    [Am] - - -   | [Dm] - - - |
    [Bdim] - - - | [E7] - - - |
    [Am] - [Am/G] - | [F] - - - |
    [Dm6] - [E7] -  | [Am] - - - |
}

Zongzhi_Elegy_Cello:Piano@|0|{
    <8*>
    | 6_ 1 3 1  6_ 1 3 1 | 2 4 6 4  2 4 6 4 |
    | 7_ 2 4 2  7_ 2 4 2 | 7_ 2 3 2  7_ 2 3 2 |
    | 6_ 1 3 1  5_ 7_ 2 7_ | 4_ 6_ 1 6_  4_ 6_ 1 6_ |
    | 2_ 4_ 6_ 4_  3_ 5_ 7_ 5_ | 6_ - - -  6_ 0 0 0 |
}

Zongzhi_Elegy_Cello:Clarinet@|0|{
    <4*>
    | 0 - - - | 0 - - - |
    | 0 - - - | 0 0 0 7_ |
    | 1 - - - | 1 - - - |
    | 2 - 3 - | 6_ - - - |
}

/* -------------------------------------------------------------------
   3. 烈焰後的死寂與殘骸（8 小節，37 秒）：
      單簧管在極度荒涼的冷雨中吹出破碎的餘音，
      所有的呼喊都得不到回音，只剩下焦黑殘骸與永恆的空洞
   ------------------------------------------------------------------- */
Ashes_Desolation:Clarinet@|0|{
    <4*>
    /* 破碎零落的音符，像是在殘骸堆中發抖呼喚親人的名字 */
    | 3_ 0 6_ 0 | 5_ 0 3_ 0 |
    | 6_ - - 0  | 0 - - - |
    | 5_ 0 3_ 0 | 2_ 0 7__ 0 |
    | 6__ - - - | 6__ 0 0 0 |
}

Ashes_Desolation:Flute@|0|{
    <4*>
    /* 長笛如冰冷的夜風吹過大園公路 */
    | 0 - - - | 0 - - - |
    | 3^ - - - | 2^ - 1^ - |
    | 7 - - -  | 6 - - - |
    | 0 - - -  | 0 - - - |
}

Ashes_Desolation:Cello@|0|{
    <4*>
    | 6__ - - - | 5__ - - - |
    | 4__ - - - | 3__ - - - |
    | 2__ - - - | 3__ - - - |
    | 6___ - - - | 6___ 0 0 0 |
}

Ashes_Desolation:Strings@|0|{
    <4*>
    [Am] - - - | [Em] - - - |
    [F] - - -  | [C] - - - |
    [Dm] - - - | [E7] - - - |
    [Am] - - - | [Am] 0 0 0 |
}

/* -------------------------------------------------------------------
   4. 問天無語（4 小節，18 秒）：
      極致的安靜，鋼琴孤零零敲下三聲滴血的高音，
      空留巨大的沉默，直面這命運最殘忍的無常
   ------------------------------------------------------------------- */
Unanswered_Cry:Piano@|0|{
    <4*>
    | 0 3^^ 0 0 | 0 2^^ 0 0 |
    | 0 1^^ 0 0 | 6^ - - - |
}

Unanswered_Cry:Cello@|0|{
