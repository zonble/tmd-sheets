    | 6__ - - - | 3__ - - - | 4__ - 3__ - | 6__ - - - |
}

General_Confinement_Variation:Strings@|0|{
    <4*>
    [Am] - - - | [Em] - - - | [F] - - - | [Em] - [E7] - |
    [Am] - - - | [Em] - - - | [F] - [E7] - | [Am] - - - |
}

/* -------------------------------------------------------------------
   4. 第二變奏：隔著鐵幕的殘陽軍禮（8 小節，24 秒）：
      弦樂鋪出沉鬱如海的哀傷背景，法國號與長號如隔著鐵幕高牆，
      在遠方深沉、悲壯地吹響老統帥最後的軍禮主題
   ------------------------------------------------------------------- */
General_Distant_Brass_Salute:Horn@|0|{
    <4*>
    /* 遠方長空中的悲壯軍號 */
    | 6 - 3^ - | 5 - 3^ - | 4 - 3^ - | 2 - 3 - |
    | 6 - 3^ - | 5 - 3^ - | 4 - 3 -  | 1 - - - |
}

General_Distant_Brass_Salute:Trombone@|0|{
    <4*>
    /* 長號低沉莊嚴的軍禮對位 */
    | 6_ - - - | 3_ - - - | 4_ - - - | 5_ - - - |
    | 6_ - - - | 3_ - - - | 4_ - 3_ - | 6__ - - - |
}

General_Distant_Brass_Salute:Tuba@|0|{
