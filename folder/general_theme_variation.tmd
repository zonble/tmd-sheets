    [Am] - - - | [Em] - - - | [F] - [E7] - | [Am] - - - |
}

/* -------------------------------------------------------------------
   5. 寂靜嘆息（4 小節，12 秒）：
      單簧管最後三音微弱顫抖，沉入長達三十年的歷史沉默
   ------------------------------------------------------------------- */
General_Silent_Echo:Clarinet@|0|{
    <4*>
    | 3 - 2 - | 1 - 7_ - |
    | 6_ - - - | 1 - 2 - |
}

General_Silent_Echo:Flute@|0|{
    <4*>
    | 0 - - - | 0 - - - |
    | 0 - - - | 0 0 3^ 5^ |
}

