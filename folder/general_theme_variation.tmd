    [Am] - - - | [Em] - - - |
    [F] - - -  | [E7] - - - |
}

General_Fall_Disruption:Cello@|0|{
    <4*>
    | 6__ - - - | 5__ - - - |
    | 4__ - - - | 3__ - - - |
}

General_Fall_Disruption:Timpani@|0|{
    <4*>
    | 6__ - - - | 0 - - - |
    | 4__ - - - | 3__ - - - |
}

/* -------------------------------------------------------------------
   3. 變奏：幽禁歲月（8 小節，24 秒）：
      軍鼓徹底死去。單簧管孤獨吹出小調將軍動機，大提琴深沉呼應，
      英雄被歷史剝奪聲響，只剩高牆內的靜謐與嘆息
   ------------------------------------------------------------------- */
General_Confinement_Variation:Clarinet@|0|{
    <4*>
    /* 將軍動機小調變奏：昔日昂揚化為滄桑獨白 */
    | 6_ - 3 - | 5_ - 3 - | 4_ - 3 - | 2_ - 3_ - |
    | 6_ - 3 - | 5_ - 3 - | 4_ - 3_ - | 6__ - - - |
}

General_Confinement_Variation:Flute@|0|{
    <4*>
    | 0 - - - | 0 - - - | 0 - - - | 0 - - - |
    | 6 - 3^ - | 5 - 3^ - | 4 - 3 - | 1 - - - |
}

General_Confinement_Variation:Cello@|0|{
    <4*>
