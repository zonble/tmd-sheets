    | 6_ 1 4 1  6_ 1 4 1 | 5_ 7_ 2 7_  5_ 7_ 2 7_ |
    | 1 3 5 3  1 3 5 3 | 5_ 7_ 2 7_  5_ 7_ 2 7_ |
    | 6_ 1 4 1  5_ 7_ 2 7_ | 1 3 5 1^  1 - - - |
}

General_Noble_Theme:Trombone@|0|{
    <4*>
    | 1_ 0 5__ 0 | 7__ 0 5__ 0 | 6__ 0 1_ 0 | 7__ 0 5__ 0 |
    | 1_ 0 5__ 0 | 7__ 0 5__ 0 | 4_ 0 5_ 0  | 1_ 0 1_ 0 |
}

General_Noble_Theme:Strings@|0|{
    <4*>
    [C] - [C] - | [G] - [Em] - | [F] - [C] - | [G] - [G7] - |
    [C] - [C] - | [G] - [Em] - | [F] - [G7] - | [C] - - - |
}

General_Noble_Theme:Timpani@|0|{
    <4*>
