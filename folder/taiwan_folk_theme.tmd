::SCORE::
** Voyage Part 5 - Taiwan Folk Song: Arrival at Green Isle (台灣民謠主題：抵達溫暖南方島嶼) **

!= 88
?= C
<4/4>

/* 
 * ===================================================================
 * 台灣民謠主題：抵達溫暖南方島嶼（南方的微風與島嶼初見）
 * 歷經了東北冰雪大戰與漫長海難顛簸，
 * 倖存的部隊、傷兵、孫立人將軍部屬與大象阿妹（林旺），
 * 終於穿過海峽迷霧，看見了南台灣青翠溫暖的島嶼海岸線。
 *
 * 旋律動機：
 * <8*> 
 * | 1 - 1 5_ 1 5_ 1 2 | 5 - 5 - 3 - - - |
 * | 1 - 1 5_ 1 5_ 1 2 | 3 - 2 - 1 - - - |
 *
 * 色彩：
 * 徹底告別東北長春的死寂黑白與冰雪冷槍，
 * 木管（長笛、單簧管）輕柔吹拂，如同溫暖的亞熱帶海風，
 * 弦樂撥奏（Pizzicato）輕快跳躍，迎接巨象與倖存者踏上這座庇護之島。
 * ===================================================================
 */

-> Taiwan_Island_Intro
-> Taiwan_Folk_Melody_Woodwinds
-> Taiwan_Folk_Tutti_Warmth
-> Taiwan_Welcoming_Echo
-> #

/* -------------------------------------------------------------------
   1. 島嶼浮現（4 小節，11 秒）：
      長笛與小提琴撥奏如南國晨曦微風，海水從深藍變為翠綠
   ------------------------------------------------------------------- */
Taiwan_Island_Intro:Violin@|0|{
    <8*>
    | 1 3 5 3  1 3 5 3 | 2 5 7 5  2 5 7 5 |
    | 1 3 5 3  1 3 5 3 | 1 5 1^ 5  1^ - - - |
}

Taiwan_Island_Intro:Clarinet@|0|{
    <8*>
    | 0 - - - 0 - - - | 0 - - - 0 - - - |
    | 0 - - - 0 - - - | 0 0 5_ 1  2 - 3 - |
}

Taiwan_Island_Intro:Cello@|0|{
    <4*>
    | 1_ 0 1_ 0 | 5__ 0 5__ 0 |
    | 1_ 0 1_ 0 | 1_ - - - |
}

Taiwan_Island_Intro:Strings@|0|{
    <4*>
    [C] - - - | [G] - - - |
    [C] - - - | [C] - - - |
}

/* -------------------------------------------------------------------
   2. 台灣民謠木管主奏（8 小節，22 秒）：
      單簧管與長笛深情吹出這段質樸純真、帶著台灣泥土芳香的旋律
   ------------------------------------------------------------------- */
Taiwan_Folk_Melody_Woodwinds:Clarinet@|0|{
    <8*>
    | 1 - 1 5_  1 5_ 1 2 | 5 - 5 -  3 - - - |
    | 1 - 1 5_  1 5_ 1 2 | 3 - 2 -  1 - - - |
    | 1 - 1 5_  1 5_ 1 2 | 5 - 5 -  3 - - - |
    | 1 - 1 5_  1 5_ 1 2 | 3 - 2 -  1 - - - |
}

Taiwan_Folk_Melody_Woodwinds:Flute@|0|{
    <8*>
    | 0 - - - - - - - | 0 - - - - - - - |
    | 0 - - - - - - - | 0 - - - - - - - |
    | 1^ - 1^ 5  1^ 5 1^ 2^ | 5^ - 5^ -  3^ - - - |
    | 1^ - 1^ 5  1^ 5 1^ 2^ | 3^ - 2^ -  1^ - - - |
}

Taiwan_Folk_Melody_Woodwinds:Cello@|0|{
    <8*>
    | 1_ - - -  5__ - - - | 5__ - - -  1_ - - - |
    | 4__ - - -  5__ - - - | 1_ - 5__ -  1_ - - - |
    | 1_ - - -  5__ - - - | 5__ - - -  1_ - - - |
    | 4__ - - -  5__ - - - | 1_ - 5__ -  1_ - - - |
}

Taiwan_Folk_Melody_Woodwinds:Strings@|0|{
    <4*>
    [C] - [G] - | [G] - [C] - |
    [F] - [G] - | [C] - - - |
    [C] - [G] - | [G] - [C] - |
    [F] - [G] - | [C] - - - |
}

/* -------------------------------------------------------------------
   3. 南國大地溫暖齊鳴（8 小節，22 秒）：
      小提琴、法國號與木管群全面合奏，陽光灑落高雄港與鳳山軍營
   ------------------------------------------------------------------- */
Taiwan_Folk_Tutti_Warmth:Violin@|0|{
    <8*>
    | 1^ - 1^ 5  1^ 5 1^ 2^ | 5^ - 5^ -  3^ - - - |
    | 1^ - 1^ 5  1^ 5 1^ 2^ | 3^ - 2^ -  1^ - - - |
    | 1^ - 1^ 5  1^ 5 1^ 2^ | 5^ - 5^ -  3^ - - - |
    | 1^ - 1^ 5  1^ 5 1^ 2^ | 3^ - 2^ -  1^ - - - |
}

Taiwan_Folk_Tutti_Warmth:Horn@|0|{
    <8*>
    | 1 - 1 5_  1 5_ 1 2 | 5 - 5 -  3 - - - |
    | 1 - 1 5_  1 5_ 1 2 | 3 - 2 -  1 - - - |
    | 1 - 1 5_  1 5_ 1 2 | 5 - 5 -  3 - - - |
    | 1 - 1 5_  1 5_ 1 2 | 3 - 2 -  1 - - - |
}

Taiwan_Folk_Tutti_Warmth:Flute@|0|{
    <8*>
    | 3^ 5^ 1^^ 5^  3^ 5^ 1^^ 2^^ | 5^^ - 5^^ -  3^^ - - - |
    | 3^ 5^ 1^^ 5^  3^ 5^ 1^^ 2^^ | 3^^ - 2^^ -  1^^ - - - |
    | 3^ 5^ 1^^ 5^  3^ 5^ 1^^ 2^^ | 5^^ - 5^^ -  3^^ - - - |
    | 3^ 5^ 1^^ 5^  3^ 5^ 1^^ 2^^ | 3^^ - 2^^ -  1^^ - - - |
}

Taiwan_Folk_Tutti_Warmth:Cello@|0|{
    <8*>
    | 1_ 5_ 1_ 5_  5__ 2_ 5__ 2_ | 5__ 2_ 5__ 2_  1_ 5_ 1_ 5_ |
    | 4__ 1_ 4__ 1_  5__ 2_ 5__ 2_ | 1_ 5_ 5__ 2_  1_ - - - |
    | 1_ 5_ 1_ 5_  5__ 2_ 5__ 2_ | 5__ 2_ 5__ 2_  1_ 5_ 1_ 5_ |
    | 4__ 1_ 4__ 1_  5__ 2_ 5__ 2_ | 1_ 5_ 5__ 2_  1_ - - - |
}

Taiwan_Folk_Tutti_Warmth:Strings@|0|{
    <4*>
    [C] - [G] - | [G] - [C] - |
    [F] - [G] - | [C] - - - |
    [C] - [G] - | [G] - [C] - |
    [F] - [G] - | [C] - - - |
}

/* -------------------------------------------------------------------
   4. 溫暖餘韻與安歇（4 小節，11 秒）：
      長笛如海鳥掠過平原，單簧管在溫柔的大三和弦上定格，
      準備迎接大象林旺踏上台灣南方的紅土。
   ------------------------------------------------------------------- */
Taiwan_Welcoming_Echo:Flute@|0|{
    <8*>
    | 1^ - 1^ 5  1^ 5 1^ 2^ | 3^ - 2^ -  1^ - - - |
    | 1^ - - - - - - - | 1^ 0 0 0 0 - - - |
}

Taiwan_Welcoming_Echo:Clarinet@|0|{
    <8*>
    | 1 - 1 5_  1 5_ 1 2 | 3 - 2 -  1 - - - |
    | 1 - - - - - - - | 1 0 0 0 0 - - - |
}

Taiwan_Welcoming_Echo:Cello@|0|{
    <4*>
    | 1_ - 5__ - | 1_ - - - |
    | 1_ - - - | 1_ 0 0 0 |
}

Taiwan_Welcoming_Echo:Strings@|0|{
    <4*>
    [F] - [G] - | [C] - - - |
    [C] - - - | [C] 0 0 0 |
}
