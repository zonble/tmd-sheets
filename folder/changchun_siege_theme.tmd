::SCORE::
** Voyage Part 4 - Siege of Changchun: New 1st Army Variation (新一軍主題變奏：長春圍城) **

!= 66
?= C
<4/4>

/* 
 * ===================================================================
 * 新一軍主題變奏：長春圍城（哀歌與崩解）
 * 1948 年，東北長春孤城，天下第一軍被重重圍困長達數月。
 * 糧道斷絕、寒冬饑饉、戰死凍死、百姓哀鴻遍野。
 *
 * 變奏手法：
 * 原本在廣州大調昂揚的《新一軍軍歌》（吾軍欲發揚，猛士力能守四方）
 * 在這裡徹底被拖慢、撕裂、轉入悲愴的 C 小調（Am / Cm 陰鬱調性），
 * 變成一支送葬進行曲（Funeral Dirge），鋼琴與低音號殘破迴盪。
 *
 * 結構：
 * 1. Siege_Cold_Hunger（圍城酷寒：低音單簧管與大提琴的饑饉長音）
 * 2. Siege_Army_Dirge（軍歌殘破悲歌：弱音小號如幽靈般吹響變奏軍歌）
 * 3. Siege_Collapse_Death（城破與崩解：沉重的大鼓喪鐘，最後的軍旗倒下）
 * ===================================================================
 */

-> Siege_Cold_Hunger
-> Siege_Army_Dirge
-> Siege_Collapse_Death
-> #

/* -------------------------------------------------------------------
   1. 圍城酷寒（4 小節，15 秒）：
      長春城內斷糧斷炊，大提琴與弦樂拉出沉重窒息的死亡音牆
   ------------------------------------------------------------------- */
Siege_Cold_Hunger:Cello@|0|{
    <4*>
    | 6__ - - - | 4__ - - - |
    | 2__ - - - | 3__ - - - |
}

Siege_Cold_Hunger:Strings@|0|{
    <4*>
    [Am] - - - | [F] - - - |
    [Dm] - - - | [E7] - - - |
}

Siege_Cold_Hunger:Timpani@|0|{
    <4*>
    /* 如心跳漸弱的喪鐘步履 */
    | 1__ 0 0 0 | 1__ 0 0 0 |
    | 1__ 0 0 0 | 1__ - - 0 |
}

/* -------------------------------------------------------------------
   2. 殘破的軍歌哀歌（14 小節，50 秒）：
      小號（帶著弱音器般孤涼）吹出《新一軍軍歌》核心旋律，
      但速度極慢、節奏殘破、轉入小調，伴隨鋼琴骨感琶音，
      「猛士力能守四方... 飢咽秕與糠... 效命疆場...」
   ------------------------------------------------------------------- */
Siege_Army_Dirge:Trumpet@|0|{
    <4*>
    /* 吾軍欲發揚... (極慢、悲鳴) */
    | 0 - 0 (5_ 1)%(-) | (1. 2)%(-) 3 - 1 | 5_ 5_ (2. 1)%(-) 7_ | 2 5 - 0 |
    /* 矢志救國亡，猛士力能守四方... */
    | 0 - 0 (1 1)%(-) | 6 5 4 (2. 2)%(-) | 5 (3. 1)%(-) 2 3 | 1 0 (3. 2)%(-) (1. 7_)%(-) |
    /* 飢咽秕與糠... */
    | 6_ 0 (2. 6_)%(-) (7_. 6_)%(-) |
    /* 效命疆場，才算好兒郎... (旋律碎裂無力) */
    | 5_ 0 5_ (7_. 3)%(-) | 5 - - (5 1 3)%(-) | 6 - - (0. 2)%(-) | 5 (3. 1)%(-) 2 - | 1 - - 0 |
}

Siege_Army_Dirge:Piano@|0|{
    <4*>
    /* 寒冷、空洞的琴鍵，記錄長春城內最後的冰封歲月 */
    | 0 - - - | [Am] - - - | [F] - - - | [Em] - - - |
    | [Am] - - - | [Dm] - - - | [C] - [G] - | [Am] - - - |
    | [Dm] - [Am] - |
    | [Em] - - - | [Am] - [F] - | [Dm] - - - | [E7] - - - | [Am] - - - |
}

Siege_Army_Dirge:Cello@|0|{
    <4*>
    | 0 - - - | 6__ - - - | 4__ - - - | 3__ - - - |
    | 6__ - - - | 2__ - - - | 1_ - 5__ - | 6__ - - - |
    | 2__ - 6__ - |
    | 3__ - - - | 6__ - 4__ - | 2__ - - - | 3__ - - - | 6__ - - - |
}

Siege_Army_Dirge:Strings@|0|{
    <4*>
    | 0 - - - | [Am] - - - | [F] - - - | [Em] - - - |
    | [Am] - - - | [Dm] - - - | [C] - [G] - | [Am] - - - |
    | [Dm] - [Am] - |
    | [Em] - - - | [Am] - [F] - | [Dm] - - - | [E7] - - - | [Am] - - - |
}

Siege_Army_Dirge:Drums@|0|{
    <4*>
    /* 喪鐘般的沉重軍鼓，不再有昂揚軍威，只有緩慢送葬步履 */
    | 0 - - - | A 0 S 0 | A 0 0 0 | A 0 S 0 |
    | A 0 0 0 | A 0 S 0 | A 0 S 0 | A 0 0 0 |
    | A 0 S 0 |
    | A 0 0 0 | A 0 S 0 | A 0 S 0 | A 0 0 0 | B - - - |
}

/* -------------------------------------------------------------------
   3. 城破與軍旗倒下（6 小節，22 秒）：
      低音號（Tuba）沉入地底，定音鼓最後幾聲無奈的重擊，
      一代精銳之師在長春嚴寒與歷史巨輪下徹底瓦解
   ------------------------------------------------------------------- */
Siege_Collapse_Death:Tuba@|0|{
    <4*>
    | 6___ - - - | 4___ - - - |
    | 3___ - - - | 6___ - - - |
    | 6___ - - - | 6___ 0 0 0 |
}

Siege_Collapse_Death:Horn@|0|{
    <4*>
    /* 最後一記殘破的軍歌動機 (1 5 1) 崩落 */
    | 1 - - 5_ | 1 - - - |
    | 7_ - - - | 6_ - - - |
    | 6_ - - - | 6_ 0 0 0 |
}

Siege_Collapse_Death:Strings@|0|{
    <4*>
    [Am] - - - | [Dm] - - - |
    [E7] - - - | [Am] - - - |
    [Am] - - - | [Am] 0 0 0 |
}

Siege_Collapse_Death:Timpani@|0|{
    <4*>
    | 1__ - - - | 0 - - - |
    | 1__ - - - | 1__ 0 0 0 |
    | 1__ - - - | 0 - - - |
}
