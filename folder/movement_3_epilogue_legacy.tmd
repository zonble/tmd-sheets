::SCORE::
** Movement III Epilogue - Memory & Legacy (全劇終幕：回憶與遺產・宏大終曲) **

!= 76
?= C
<4/4>

/* 
 * ===================================================================
 * 第三樂章終幕：回憶與遺產（全劇宏大終曲）
 *
 * 創作者自述與戲劇構想：
 * 歷經了 1945 年的逃難與遠征、長春的風雪、渡海的飄零、
 * 1955 年的烈火燃燒彈、將軍的幽禁、圓山動物園的童謠笑聲、
 * 以及 1998 年大園空難撕心裂肺的命運創痛……
 *
 * 坐在鋼琴前的「我」，從八十年歷史的驚濤駭浪中回過神來。
 * 這一刻，全劇時空收攏於《Legacy》的完整發展：
 * 
 * 結構架構：
 * 1. 【後人的凝視：鋼琴獨白】(Epilogue_Piano_Solitude, 8 小節)：
 *    鋼琴孤獨彈奏「牽巨人的手、仰望英雄」主歌（v1）。
 * 2. 【命運叩問：弦樂與木管激盪】(Epilogue_Existential_Cry, 8 小節)：
 *    弦樂與木管奏出「平凡無奇、物理法則對誰都適用、不只是我淹沒在遺忘洪流」（v3/v4）。
 * 3. 【全劇交響高潮：多麼希望我不只是我】(Epilogue_Grand_Chorus_Legacy, 16 小節)：
 *    管弦樂全力齊鳴（法國號、長號、小提琴、木管、定音鼓）！
 *    副歌（c1）磅礴爆發：「多麼希望我可以讓自己不只是自己，讓我不只是我！」
 *    弦樂在副歌間隙高唱「32121」對位，將歷史的浩劫化為永恆的生命尊嚴與不朽遺產。
 * 4. 【深情慢收與合上琴蓋】(Epilogue_Final_Farewell, 8 小節)：
 *    管弦樂漸漸遠去，單簧管與鋼琴輕輕哼唱最後一句「我能夠……」。
 *    最後一顆音符落在純淨的大三和弦上，長留於歷史與記憶中。
 * ===================================================================
 */

-> Epilogue_Piano_Solitude
-> Epilogue_Existential_Cry
-> Epilogue_Grand_Chorus_Legacy
-> Epilogue_Final_Farewell
-> #

/* -------------------------------------------------------------------
   1. 後人的凝視：鋼琴獨白（8 小節，25 秒）：
      「多希望能一直牽巨人的手，在燈塔照耀中……」
   ------------------------------------------------------------------- */
Epilogue_Piano_Solitude:Piano@|0|{
    <4*>
    /* 多希望 能夠 一直 牽巨 人的手 */
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-) 2 1 | 2 1 5_ - |
    /* 一直在 燈 塔 照 耀 中 */
    | 0 3 2 3 | 5 - 3 - | 2 - 5 - | 3 - - - |
}

Epilogue_Piano_Solitude:Cello@|0|{
    <4*>
    | 1_ - - - | 7__ - - - | 6__ - - - | 5__ - - - |
    | 4__ - - - | 3__ - - - | 2__ - - - | 5__ - - - |
}

Epilogue_Piano_Solitude:Strings@|0|{
    <4*>
    [C] - - - | [G/B] - - - | [Am] - - - | [C/G] - - - |
    [F] - - - | [C/E] - - - | [Dm] - - - | [G] - - - |
}

/* -------------------------------------------------------------------
   2. 命運叩問：弦樂與木管激盪（8 小節，25 秒）：
      「我一向都平凡無奇……不只是我淹沒在遺忘的洪流」
   ------------------------------------------------------------------- */
Epilogue_Existential_Cry:Clarinet@|0|{
    <4*>
    /* 我一向 都 平 凡 無 奇，我根本 都 無 足 輕 重 */
    | 0 3 1 3 | 4 - 1 - | 6_ - 4 - | 3 - - - |
    | 0 3 1 3 | 5 - 3 - | 2_ - 5 - | 3 - - - |
}

Epilogue_Existential_Cry:Flute@|0|{
    <4*>
    | 0 - - - | 0 - - - | 0 - - - | 0 - - - |
    | 0 3^ 1^ 3^ | 5^ - 3^ - | 2^ - 5^ - | 3^ - - - |
}

Epilogue_Existential_Cry:Cello@|0|{
    <4*>
    | 4__ - - - | 4__ - - - | 3__ - - - | 3__ - - - |
    | 2__ - - - | 2__ - - - | 6__ - - - | 6__ - - - |
}

Epilogue_Existential_Cry:Strings@|0|{
    <4*>
    [F] - - - | [F] - - - | [Em] - - - | [Em] - - - |
    [Dm] - - - | [Dm] - - - | [Am] - - - | [Am] - - - |
}

Epilogue_Existential_Cry:Piano@|0|{
    <8*>
    | 4_ 6_ 1 6_  4_ 6_ 1 6_ | 4_ 6_ 1 6_  4_ 6_ 1 6_ | 3_ 5_ 7_ 5_  3_ 5_ 7_ 5_ | 3_ 5_ 7_ 5_  3_ 5_ 7_ 5_ |
    | 2_ 4_ 6_ 4_  2_ 4_ 6_ 4_ | 2_ 4_ 6_ 4_  2_ 4_ 6_ 4_ | 6__ 1_ 3_ 1_  6__ 1_ 3_ 1_ | 6__ 1_ 3_ 1_  6__ - - - |
}

/* -------------------------------------------------------------------
   3. 全劇交響高潮：多麼希望我不只是我（16 小節，50 秒）：
      管弦樂全面爆發！
      「多麼希望我可以讓自己不只是自己，讓我不只是我！」
      法國號雄壯歌唱、小提琴飛揚、對位穿插 32121 動機！
   ------------------------------------------------------------------- */
Epilogue_Grand_Chorus_Legacy:Horn@|0|{
    <4*>
    /* 多麼希望我可以 讓自己不只是自己 讓我不只是我 */
    | 4 - 4 1 | 1^ - 4 6 | 5 - - (5 5)%(-) | 5 (5 5)%(-) 3 6 |
    | 5 - - 5 | 5 5 2 5 | 3 - - - | 0 - - - |
    /* 多麼希望我可以 對誰說一句 說一句 我能夠 */
    | 4 - 4 1 | 1^ - 7 6 | 5 3 - - | 6 5 5 3 |
    | 5 2 - - | 0 - 1 2 | 6_ - - - | 0 - - - |
}

Epilogue_Grand_Chorus_Legacy:Trumpet@|0|{
    <4*>
    | 0 - - - | 0 - - - | 0 - - - | 0 - - - |
    | 0 - - - | 0 - - - | 0 - - - | 0 - - - |
    | 4 - 4 1 | 1^ - 7 6 | 5 3 - - | 6 5 5 3 |
    | 5 2 - - | 0 - 1 2 | 1 - - - | 0 - - - |
}

Epilogue_Grand_Chorus_Legacy:Violin@|0|{
    <4*>
    /* 高音小提琴副歌飛翔歌唱 */
    | 4^ - 4^ 1^ | 1^^ - 4^ 6^ | 5^ - - (5^ 5^)%(-) | 5^ (5^ 5^)%(-) 3^ 6^ |
    | 5^ - - 5^ | 5^ 5^ 2^ 5^ | 3^ - - - | 0 3^ 2^ 1^ |
    | 4^ - 4^ 1^ | 1^^ - 7^ 6^ | 5^ 3^ - - | 6^ 5^ 5^ 3^ |
    | 5^ 2^ - - | 0 - 1^ 2^ | 6 - - - | 0 - - - |
}

Epilogue_Grand_Chorus_Legacy:Flute@|0|{
    <4*>
    /* 32121 對位穿插 */
    | 0 - - - | 0 3^ 2^ 1^ | 2^ 1^ - - | 0 - - - |
    | 0 - - - | 0 3^ 2^ 1^ | 2^ 1^ - - | 0 - - - |
    | 0 - - - | 0 3^ 2^ 1^ | 2^ 1^ - - | 0 - - - |
    | 0 - - - | 0 3^ 2^ 1^ | 2^ 1^ 6 - | 1^ - - - |
}

Epilogue_Grand_Chorus_Legacy:Strings@|0|{
    <4*>
    [F] - - - | [F] - - - | [G] - - - | [G] - - - |
    [Em] - - - | [Em] - - - | [Am] - - - | [Am] - - - |
    [F] - - - | [F] - - - | [G] - - - | [G] - - - |
    [Dm] - - - | [G] - - - | [Am] - - - | [Am] - - - |
}

Epilogue_Grand_Chorus_Legacy:Cello@|0|{
    <4*>
    | 4__ - - - | 4__ - - - | 5__ - - - | 5__ - - - |
    | 3__ - - - | 3__ - - - | 6__ - - - | 6__ - - - |
    | 4__ - - - | 4__ - - - | 5__ - - - | 5__ - - - |
    | 2__ - - - | 5__ - - - | 6__ - - - | 6__ - - - |
}

Epilogue_Grand_Chorus_Legacy:Timpani@|0|{
    <4*>
    | 4___ 0 0 0 | 4___ 0 0 0 | 5___ 0 0 0 | 5___ 0 0 0 |
    | 3___ 0 0 0 | 3___ 0 0 0 | 6___ 0 0 0 | 6___ 0 0 0 |
    | 4___ 0 0 0 | 4___ 0 0 0 | 5___ 0 0 0 | 5___ 0 0 0 |
    | 2___ 0 0 0 | 5___ 0 0 0 | 6___ - - - | 6___ - - - |
}

/* -------------------------------------------------------------------
   4. 深情慢收與合上琴蓋（8 小節，25 秒）：
      狂瀾平息，單簧管與鋼琴輕聲告慰歷史，在安詳大三和弦中長眠
   ------------------------------------------------------------------- */
Epilogue_Final_Farewell:Clarinet@|0|{
    <4*>
    /* 多麼希望我可以 對誰說一句 我能夠…… */
    | 4 - 4 1 | 1^ - 7 6 | 5 3 - - | 6 5 5 3 |
    | 5 2 - - | 0 - 1 7_ | 1 - - - | 1 - - - |
}

Epilogue_Final_Farewell:Flute@|0|{
    <4*>
    /* 長笛在第 5-6 小節輕輕唱出 3 2 1 2 1 */
    | 0 - - - | 0 - - - | 0 - - - | 0 - - - |
    | 0 3^ 2^ 1^ | 2^ 1^ - - | 0 - - - | 0 - - - |
}

Epilogue_Final_Farewell:Piano@|0|{
    <4*>
    /* 鋼琴：在最後 3 2 1 1 之前，清晰響起一次 3 2 1 2 1，隨後以 3 2 1 1 溫柔合上琴蓋 */
    | 0 - - - | 0 - - - | 0 - - - | 0 - - - |
    | 0 3 2 1 | 2 1 - - | 0 3 2 1 | 1 - - - |
}

Epilogue_Final_Farewell:Cello@|0|{
    <4*>
    | 4__ - - - | 5__ - - - | 3__ - - - | 6__ - - - |
    | 2__ - - - | 5__ - - - | 1_ - - -  | 1_ - - - |
}

Epilogue_Final_Farewell:Strings@|0|{
    <4*>
    [F] - - - | [G] - - - | [Em] - - - | [Am] - - - |
    [Dm] - - - | [G7] - - - | [C] - - - | [C] - - - |
}
