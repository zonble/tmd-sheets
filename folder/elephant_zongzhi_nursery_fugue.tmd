::SCORE::
** Movement III - Nursery Rhyme Fugue: The Elephant & Zongzhi (大象與宗治的童謠賦格) **

!= 96
?= C
<4/4>

/* 
 * ===================================================================
 * 第三樂章：大象與宗治的童謠賦格 (圓山動物園林旺爺爺與童年記憶)
 *
 * 歷史與心境：
 * 歷經了 1955 年的烽火、燃燒彈與將軍幽禁的肅殺歲月，
 * 時光悄然流轉，大象「阿妹」住進了台北圓山動物園，成為家喻戶曉的「林旺爺爺」；
 * 而廣東文人宗治，也洗盡戰火鉛華，在南台灣溫暖質樸的民間社會中過著踏實的日子。
 *
 * 結構設計：
 * 1. 【32121 序奏】(Nursery_32121_Solo, 4 小節)：
 *    鋼琴與長笛只出現一次純真清脆的「3 2 1 2 1」童謠動機（純粹乾淨，只此一次，絕不重複）。
 *    | 3 2 1 2 | 1 - - - | 3 2 1 2 | 1 - - - |
 *
 * 2. 【愉快的宗治主題進場】(Fugue_Subject_Zongzhi, 8 小節)：
 *    單簧管以跳躍、明朗、輕鬆的大調形態奏出宗治主題（3 6 5 3 6...），
 *    木管與撥奏跳動，如南國午後的微風與街巷歡笑。
 *
 * 3. 【大象憨厚對位加入】(Fugue_Answer_Elephant, 8 小節)：
 *    低音號（Tuba）與低音管憨厚無比地加入林旺主題（5 5 5 5 5 3 2 3 | 1...），
 *    與中音部的宗治主題形成溫暖幽默的二重賦格。
 *
 * 4. 【童謠與雙主題歡樂齊鳴】(Fugue_Tutti_Joy, 8 小節)：
 *    全樂團（長笛、雙簧管、法國號、弦樂、輕快打擊）全面交織！
 *    大象長鼻子昂揚、宗治步伐輕快，童年的美好與和平的幸福洋溢其間。
 *
 * 5. 【溫馨尾聲】(Fugue_Coda, 4 小節)：
 *    大象頑皮的低音重踏與木管輕快收尾，定格在陽光燦爛的大三和弦。
 * ===================================================================
 */

-> Nursery_32121_Solo
-> Fugue_Subject_Zongzhi
-> Fugue_Answer_Elephant
-> Fugue_Tutti_Joy
-> Fugue_Coda
-> #

/* -------------------------------------------------------------------
   1. 32121 序奏（4 小節，10 秒）：
      注意：3 2 1 2 1 只在這裡出現一次！
      長笛與鋼琴清澈敲出兒時的跳房子歌謠，如晨光破顏。
   ------------------------------------------------------------------- */
Nursery_32121_Solo:Flute@|0|{
    <4*>
    | 3 2 1 2 | 1 - - - |
    | 3 2 1 2 | 1 - - 0 |
}

Nursery_32121_Solo:Piano@|0|{
    <4*>
    | 3 2 1 2 | 1 - - - |
    | 3 2 1 2 | 1 - - - |
}

Nursery_32121_Solo:Clarinet@|0|{
    <4*>
    | 0 - - - | 0 - - - |
    | 0 - - - | 0 0 5_ 7_ |
}

Nursery_32121_Solo:Strings@|0|{
    <4*>
    [C] - - - | [F] - [C] - |
    [C] - - - | [F] - [C] - |
}

Nursery_32121_Solo:Cello@|0|{
    <4*>
    | 1_ 0 5__ 0 | 1_ 0 1_ 0 |
    | 1_ 0 5__ 0 | 1_ 0 1_ 0 |
}

/* -------------------------------------------------------------------
   2. 愉快的宗治主題進場（8 小節，20 秒）：
      單簧管輕快吹出大調版宗治主題，大提琴與弦樂撥奏輕盈伴奏
   ------------------------------------------------------------------- */
Fugue_Subject_Zongzhi:Clarinet@|0|{
    <4*>
    /* 愉快的宗治主題：洗盡戰火煙硝，如漫步在南台灣的稻香小徑 */
    | 3 6 (5 6 5 3)%(--) | 6 - - (7. 6)%(-) | 5. 3 3 (5. 1)%(-) | 2 7_ 7_ 5_ |
    | 3 6 (5 6 5 3)%(--) | 6 - - (7. 6)%(-) | 5. 3 2 3 | 1 - - - |
}

Fugue_Subject_Zongzhi:Flute@|0|{
    <8*>
    | 0 - - - 0 - - - | 1^ 3^ 5^ 3^  1^ 0 0 0 |
    | 0 - - - 0 - - - | 5 7 2^ 7  5 0 0 0 |
    | 0 - - - 0 - - - | 1^ 3^ 5^ 3^  1^ 0 0 0 |
    | 6 1^ 4^ 1^  5 7 2^ 7 | 1^ 3^ 5^ 1^^  1^ - - - |
}

Fugue_Subject_Zongzhi:Strings@|0|{
    <4*>
    [C] - [C] - | [Am] - [Am] - | [F] - [C] - | [G] - [G7] - |
    [C] - [C] - | [Am] - [Am] - | [F] - [G7] - | [C] - - - |
}

Fugue_Subject_Zongzhi:Cello@|0|{
    <4*>
    | 1_ 0 5__ 0 | 6__ 0 3__ 0 | 4__ 0 1_ 0 | 5__ 0 2_ 0 |
    | 1_ 0 5__ 0 | 6__ 0 3__ 0 | 4__ 0 5__ 0 | 1_ 0 1_ 0 |
}

/* -------------------------------------------------------------------
   3. 大象憨厚對位加入（8 小節，20 秒）：
      低音號（Tuba）憨厚奏出林旺主題，
      單簧管與長笛則在中高音部繼續穿梭宗治主題的對位！
   ------------------------------------------------------------------- */
Fugue_Answer_Elephant:Tuba@|0|{
    <8*>
    /* 林旺主題：大象長長的鼻子正昂揚 */
    | 5__ 5__ 5__ 5__  5__ 3__ 2__ 3__ | 1__ - - - - - - - |
    | 5__ 5__ 5__ 5__  5__ 3__ 2__ 3__ | 2__ - - - - - - - |
    | 5__ 5__ 5__ 5__  5__ 3__ 2__ 3__ | 1__ - - - - - - - |
    | 6___ 1__ 2__ 3__  5__ 3__ 2__ 3__ | 1__ - - - - - - - |
}

Fugue_Answer_Elephant:Clarinet@|0|{
    <4*>
    /* 宗治主題在上層輕盈對位 */
    | 3 6 (5 6 5 3)%(--) | 6 - - (7. 6)%(-) | 5. 3 3 (5. 1)%(-) | 2 7_ 7_ 5_ |
    | 3 6 (5 6 5 3)%(--) | 6 - - (7. 6)%(-) | 5. 3 2 3 | 1 - - - |
}

Fugue_Answer_Elephant:Flute@|0|{
    <8*>
    | 0 - - -  1^ 3^ 5^ 3^ | 1^ 3^ 5^ 1^^  5^ 3^ 1^ 3^ |
    | 0 - - -  2^ 4^ 6^ 4^ | 2^ 4^ 6^ 2^^  7^ 5^ 2^ 7 |
    | 0 - - -  1^ 3^ 5^ 3^ | 1^ 3^ 5^ 1^^  5^ 3^ 1^ 3^ |
    | 4^ 6^ 1^^ 6^  5^ 7^ 2^^ 7^ | 1^^ 5^ 3^ 1^  1^ - - - |
}

Fugue_Answer_Elephant:Cello@|0|{
    <4*>
    | 1_ 0 5__ 0 | 1_ 0 5__ 0 |
    | 2_ 0 5__ 0 | 2_ 0 5__ 0 |
    | 1_ 0 5__ 0 | 1_ 0 5__ 0 |
    | 4_ 0 5_ 0  | 1_ 0 5__ 0 |
}

Fugue_Answer_Elephant:Strings@|0|{
    <4*>
    [C] - [C] - | [C] - [C] - |
    [G] - [G] - | [G] - [G7] - |
    [C] - [C] - | [C] - [C] - |
    [F] - [G] - | [C] - [C] - |
}

/* -------------------------------------------------------------------
   4. 歡樂雙主題賦格齊鳴（8 小節，20 秒）：
      小號、長號、法國號、木管群、弦樂全開！
      宗治進行曲與大象笨拙憨厚的步伐完美融合成最愉快的生命禮讚。
   ------------------------------------------------------------------- */
Fugue_Tutti_Joy:Horn@|0|{
    <4*>
    /* 法國號精神抖擻吹響宗治主題 */
    | 3. 6 (5 6 5 3)%(--) | 6 - - (7. 6)%(-) | 5. 3 3 (5. 1)%(-) | 2 7_ 7_ 5_ |
    | 3. 6 (5 6 5 3)%(--) | 6 - - (7. 6)%(-) | 5. 3 2 3 | 1 - - - |
}

Fugue_Tutti_Joy:Tuba@|0|{
    <8*>
    /* 低音號轟鳴踏步：大象林旺正高興地搖晃！ */
    | 5__ 5__ 5__ 5__  5__ 3__ 2__ 3__ | 1__ - - - - - - - |
    | 5__ 5__ 5__ 5__  5__ 3__ 2__ 3__ | 2__ - - - - - - - |
    | 5__ 5__ 5__ 5__  5__ 3__ 2__ 3__ | 1__ - - - - - - - |
    | 6___ 1__ 2__ 3__  5__ 3__ 2__ 3__ | 1__ - - - - - - - |
}

Fugue_Tutti_Joy:Flute@|0|{
    <8*>
    | 3^ 5^ 1^^ 5^  3^ 5^ 1^^ 5^ | 6^ 1^^ 3^^ 1^^  6^ 5^ 4^ 3^ |
    | 2^ 4^ 6^ 4^  2^ 4^ 6^ 4^ | 5^ 7^ 2^^ 7^  5^ 4^ 3^ 2^ |
    | 3^ 5^ 1^^ 5^  3^ 5^ 1^^ 5^ | 6^ 1^^ 3^^ 1^^  6^ 5^ 4^ 3^ |
    | 4^ 6^ 1^^ 6^  5^ 7^ 2^^ 7^ | 1^^ 5^ 3^ 1^  1^ - - - |
}

Fugue_Tutti_Joy:Clarinet@|0|{
    <4*>
    | 1^ 0 5 0 | 6 0 3 0 | 4 0 1 0 | 5 0 2 0 |
    | 1^ 0 5 0 | 6 0 3 0 | 4 0 5 0 | 1 0 1 0 |
}

Fugue_Tutti_Joy:Strings@|0|{
    <4*>
    [C] - [C] - | [Am] - [Am] - | [Dm] - [Dm] - | [G] - [G7] - |
    [C] - [C] - | [Am] - [Am] - | [F] - [G7] -  | [C] - - - |
}

Fugue_Tutti_Joy:Cello@|0|{
    <4*>
    | 1_ 0 5__ 0 | 6__ 0 3__ 0 | 2__ 0 6__ 0 | 5__ 0 2_ 0 |
    | 1_ 0 5__ 0 | 6__ 0 3__ 0 | 4__ 0 5__ 0 | 1_ - - - |
}

/* -------------------------------------------------------------------
   5. 溫馨尾聲（4 小節，10 秒）：
      大象最後搖一搖長鼻子，宗治與林旺在動物園陽光下安然定格
   ------------------------------------------------------------------- */
Fugue_Coda:Flute@|0|{
    <4*>
    | 1^ - 3^ - | 5^ - 1^^ - |
    | 1^^ - - - | 1^^ 0 0 0 |
}

Fugue_Coda:Clarinet@|0|{
    <4*>
    | 3 - 5 - | 1^ - 3^ - |
    | 1^ - - - | 1^ 0 0 0 |
}

Fugue_Coda:Tuba@|0|{
    <8*>
    | 5__ 3__ 2__ 3__  1__ - - - |
    | 5__ 3__ 2__ 3__  1__ 0 0 0 |
}

Fugue_Coda:Cello@|0|{
    <4*>
    | 1_ - 5__ - | 1_ - - - |
    | 1_ - - - | 1_ 0 0 0 |
}

Fugue_Coda:Strings@|0|{
    <4*>
    [C] - [G] - | [C] - - - |
    [C] - - - | [C] 0 0 0 |
}
