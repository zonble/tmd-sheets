::SCORE::
** だいしゃ（台車） **
!= 96
?= F
<2/4>
~ "日治時期公學校唱歌"
~ "國立臺灣歷史博物館典藏"

/* ==========================================================
   前奏 (Intro): 4 小節 (2/4 拍)
   以輕快活潑的台車行進動機展開
   ========================================================== */

Intro:PianoRH@|0| {
    <4*>
    /* 右手：前奏主題 */
    | (1 3)%(-) (5 1^)%(-) | (6 6)%(-) (5 3)%(-) | (3 3)%(-) (2 1)%(-) | (2 2 5_ 0)%(--) |
}

Intro:PianoLH@|0| {
    <4*>
    /* 左手：輕快伴奏 (低音單音 + 首調和弦度數 [1], [4], [5]) */
    | 1_ [1] | 4_ [4] | 1_ [1] | 5_ [5] |
}

/* ==========================================================
   主歌段 (Daisha): 12 小節 (2/4 拍)
   右手為唱歌主旋律，左手為低音及和聲伴奏
   ========================================================== */

Daisha:PianoRH@|0| {
    <4*>
    /* ================= 第一行 (4 小節) ================= */
    /* 一: ゴウ ゴウ | ダイ シャ | ノ・ボ ル・ヨ | ダイ シャ */
    /* 二: ごう ごう | だい しゃ | く・だ る・よ | だい しゃ */
    /* 三: ゴウ ゴウ | ダイ シャ | ハ・シ ル・ヨ | ダイ シャ */
    | 5_ 5_ | (1 1 1 0)%(--) | (3 -- 3)%(-) (3 -- 1)%(-) | (2 2 2 0)%(--) |

    /* ================= 第二行 (4 小節) ================= */
    /* 一: ミ チ・ハ | ヤ・マ ミチ | グン・グン ノ・ボ | ル | */
    /* 二: み ち・は | ふ・も とへ | ずん・ずん く・だ | ル | */
    /* 三: ミ チ・ハ | サ・ト まで | ア・ト     ヒ・ト | イキ・ダ | */
    | 5 (6 6)%(-) | (3 3)%(-) (2 1)%(-) | (2 2)%(-) (5_ 5_)%(-) | (1 1 1 0)%(--) |

    /* ================= 第三行 (4 小節) ================= */
    /* 一: サウ シ・ジュ | バ・— ヤ・シ | マ・ダ ツ・ヅ | ク | */
    /* 二: ば   せ・う   | ば・— た・け | も・う す・ぎ | たり | */
    /* 三: カン シャ     | バ・— タ・ケ | ガ・ミ ギ・ヒ | ダ・リ | */
    | 5_ (1 1)%(-) | (6--6)%(-) (5 5)%(-) | (6 - -6)%(-) (5 -- 5)%(-) | (1 -- 0)%(--) |
}

Daisha:PianoLH@|0| {
    <4*>
    /* ================= 第一行 (4 小節) ================= */
    | 1_ [1] | 1_ [1] | 1_ [1] | 5_ [5] |

    /* ================= 第二行 (4 小節) ================= */
    | 4_ [4] | 1_ [1] | 5_ [5] | 1_ [1] |

    /* ================= 第三行 (4 小節) ================= */
    | 1_ [1] | 4_ [1] | 4_ [5] | [1] 0 |
}

-> Intro -> Daisha -> Daisha -> Daisha -> #
