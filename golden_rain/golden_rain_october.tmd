    <4*>
    {mf}
    | 5 - 5 (3 5)%(-) | 6 - 4 6 | 5 - (5 5 4 3)%(--) | (3 2 2 1 2 5 5 5)%(----) |
    | 5 - 5 (3 5)%(-) | 6 - 1^ 6 | 5 - 5 (4 3)%(-) | (3 - - 2)%(--) 2 - |
    | 1 - - - | 2 - 1 2 | 3 - 5 (4 3)%(-) | 2 - 5 - |
    | 1 - - - | 2 - 1 2 | 3 - 5 (4 3)%(-) | 2 - 0 0 |
}

