::SCORE::
** 點蟲蟲 (兒歌琶音前奏版) **
!= 120
?= C
<4/4>

/* 4 小節前奏：引出蟲蟲主題動機與歡快琶音 */
intro:Piano@|0| {
    <8*>
    /* 第 1 小節：右手輕快點出核心動機「點蟲蟲」(3 1 1 -)，左手伴以 C 和弦琶音 */
    | 1_ 3_ 5_ 3_ 1_ 3_ 5_ 3_ |
    /* 第 2 小節：F 和弦跳躍 (Fa-La-Do) */
    | 4_ 6_ 1 6_ 4_ 6_ 1 6_ |
    /* 第 3 小節：模仿「蟲蟲飛呀」快速爬升 (3 2 1 3 5 1^...) */
    | 3 2 1 3 5 3 5 1^ |
    /* 第 4 小節：G 屬和弦大琶音與半拍提示音，預備進主歌 */
    | 5 2 7_ 5_ 7_ 2 5 0 |
}

A:Vocal@|0| {
    <4*>
    /* 點蟲蟲 蟲蟲飛呀 */
    | 3 1 1 - | 5 4 (3 2)%(-) 1 |
    /* 點蟲蟲 蟲蟲飛呀 */
    | 3 1 1 - | 5 4 (3 2)%(-) 1 |
    /* 點蟲蟲 蟲蟲飛呀飛呀 */
    | 3 1 1 - | 5 4 (3 2 1 3)%(--) |
    /* 飛 */
    | 2 - - - | - - - - |
}

A:Piano@|0| {
    <8*>
    /* 第 1 句：C 和弦分解琶音 (Do-Mi-Sol-Mi) 與 F/C 琶音 */
    | 1_ 3_ 5_ 3_ 1_ 3_ 5_ 3_ | 4_ 6_ 1 6_ 1_ 3_ 5_ 3_ |
    /* 第 2 句 */
    | 1_ 3_ 5_ 3_ 1_ 3_ 5_ 3_ | 4_ 6_ 1 6_ 1_ 3_ 5_ 3_ |
    /* 第 3 句 */
    | 1_ 3_ 5_ 3_ 1_ 3_ 5_ 3_ | 4_ 6_ 1 6_ 1_ 3_ 5_ 3_ |
    /* 第 4 句：G 和弦琶音，向上爬升 (Sol-Ti-Re-Sol) 停在開闊屬音 */
    | 5__ 7__ 2_ 5_ 5__ 7__ 2_ 5_ | 7__ 2_ 5_ 7_ 2 5 7 0 |
}

B:Vocal@|0| {
    <4*>
    /* 點蟲蟲 蟲蟲飛呀 */
    | 3 1 1 - | 5 4 (3 2)%(-) 1 |
    /* 點蟲蟲 蟲蟲飛呀 */
    | 3 1 1 - | 5 4 (3 2)%(-) 1 |
    /* 點蟲蟲 蟲蟲飛呀飛呀 */
    | 3 1 1 - | 5 4 (3 2 3 2)%(--) |
    /* 飛 */
    | 1 - - - | - - - - |
}

B:Piano@|0| {
    <8*>
    /* 第 1 句 */
    | 1_ 3_ 5_ 3_ 1_ 3_ 5_ 3_ | 4_ 6_ 1 6_ 1_ 3_ 5_ 3_ |
    /* 第 2 句 */
    | 1_ 3_ 5_ 3_ 1_ 3_ 5_ 3_ | 4_ 6_ 1 6_ 1_ 3_ 5_ 3_ |
    /* 第 3 句：走向 F 和弦與 G 和弦琶音 */
    | 1_ 3_ 5_ 3_ 1_ 3_ 5_ 3_ | 4_ 6_ 1 6_ 5__ 7__ 2_ 5_ |
    /* 第 4 句：主和弦 C 琶音後華麗落於低音主和弦 */
    | 1_ 3_ 5_ 1 3 5 3 1 | [1_] - - - - - - - |
}

-> intro
-> A
-> B
-> A
-> B
->#
