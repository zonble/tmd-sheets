::SCORE::
** 點蟲蟲 **
!= 120
?= C
<4/4>

A:Piano@|0| {
    <4*>
    /* 點蟲蟲 蟲蟲飛呀*/
    | 3 1 1 - | 5 4 (3 2)%(-) 1 |
    /* 點蟲蟲 蟲蟲飛呀*/
    | 3 1 1 - | 5 4 (3 2)%(-) 1 |
    /* 點蟲蟲 蟲蟲飛呀飛呀*/
    | 3 1 1 - | 5 4 (3 2 1 3)%(--)  |
    /* 飛 */
    | 2 - - - | - - - - |
}

B:Piano@|0| {
    <4*>
    /* 點蟲蟲 蟲蟲飛呀*/
    | 3 1 1 - | 5 4 (3 2)%(-) 1 |
    /* 點蟲蟲 蟲蟲飛呀*/
    | 3 1 1 - | 5 4 (3 2)%(-) 1 |
    /* 點蟲蟲 蟲蟲飛呀飛呀*/
    | 3 1 1 - | 5 4 (3 2 3 2)%(--)  |
    /* 飛 */
    | 1 - - - | - - - - |
}

->A
->B
->#