::SCORE::
** 點蟲蟲 (兒歌版) **
!= 120
?= C
<4/4>

A:Piano@|0| {
    <4*>
    /* 點蟲蟲 蟲蟲飛呀 */
    | 3 1 1 - | 5 4 (3 2)%(-) 1 |
    /* 點蟲蟲 蟲蟲飛呀 */
    | 3 1 1 - | 5 4 (3 2)%(-) 1 |
    /* 點蟲蟲 蟲蟲飛呀飛呀 */
    | 3 1 1 - | 5 4 (3 2 1 3)%(--) |
    /* 飛 */
    | 2 - - - | - - - - |
}

A:CHORD@|0| {
    <2*>
    /* 兒歌經典明亮配器：I - IV - V 進行 */
    | [1] - | [4] [1] |
    | [1] - | [4] [1] |
    | [1] - | [4] [1] |
    | [5] - | - - |
}

B:Piano@|0| {
    <4*>
    /* 點蟲蟲 蟲蟲飛呀 */
    | 3 1 1 - | 5 4 (3 2)%(-) 1 |
    /* 點蟲蟲 蟲蟲飛呀 */
    | 3 1 1 - | 5 4 (3 2)%(-) 1 |
    /* 點蟲蟲 蟲蟲飛呀飛呀 */
    | 3 1 1 - | 5 4 (3 2 3 2)%(--) |
    /* 飛 */
    | 1 - - - | - - - - |
}

B:CHORD@|0| {
    <2*>
    | [1] - | [4] [1] |
    | [1] - | [4] [1] |
    | [1] - | [4] [5] |
    | [1] - | - - |
}

-> A
-> B
-> A
-> B
->#
