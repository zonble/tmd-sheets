    | 7__+7_ - - - - - 1_+1 - 1_+1 - - - - - - - |
    /* 原鋼琴前奏動機 1 1 12 3，♭VII（D 大調）上的 #11 色彩 */
    | 1+1^ - - - 1+1^ - - - 1+1^ - 2+2^ - 3+3^ - - - |
    | 3+3^ - - - 2+2^ - - - 2+2^ - 3+3^ - 2+2^ - - - |
