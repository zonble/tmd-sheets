::SCORE::
** 藿香薊 — Fantasia（全曲版） **
!= 72
?= E
~ "composer: zonble"
~ "arrangement: complete fantasy for solo piano, after Liszt, with impressionist colours"
<4/4>

/* ==========================================================
   幻想曲全曲版 — 以幻想曲版為基礎，涵蓋原曲每一段

   和聲語彙：李斯特式的三度關係轉調、增三和弦、減七華彩，
   加上印象派的色彩和弦（add9、maj7、♭VII 的 #11 色彩、
   低音持續音、平行六和弦、五聲音階水光）。

     Introduzione  A 主題於升 c 小調，下行哀歌低音，減七華彩
     Intro         原 Violin 主題：E 持續音上的 add9／maj7 水光
     A1  Tema      和聲每拍流動；原鋼琴動機成為三度半音線
     B1  Canzone   左手六連音波浪 → ♭III、增三和弦
     A2            旋律沉到次中音，高音區 ♭VII、maj7 和弦染色（quasi lontano）
     B2            leggiero：右手三度振翅（燕子），左手輕跳
     Episodio      B 主題動機小三度模進 E → G → B♭ → C# → E
     B3  Grandioso 旋律和弦在上、A 主題在低音
     C1  Celeste   ♭VI（C 大調），極弱高音區
     C2  Barcarola 再降大三度到 A♭（= G#）：平行六和弦、五聲音階
     C3  Apoteosi  回 E 大調：四個八度掃弦
                   （C1 → C2 → C3 走增三和弦軸 C – A♭ – E，
                     每次以 ♭VI7 轉入下一個調的 IV）
     C4            暴風雨過後：E 持續音上的鐘聲回聲
     Coda          A 主題開頭，♭VI–♭VII–I

   三個聲部皆為同一台鋼琴：PianoCanto（旋律）、PianoRH、PianoLH。
   ========================================================== */

/* ==========================================================
   Introduzione — Lento, quasi recitativo（升 c 小調）
   ========================================================== */

Introduzione:PianoCanto@|0| {
    <16*>
    /* A 主題的頭兩句，改放在升 c 小調的和聲上 */
    | {p} 0 - - - 0 - - - 3_+3 - - - 1_+1 - - - |
    | 5_+5 - - - 6_+6 - - - 5_+5 - - - 4_+4 - - - |
    | 3_+3 - - - - - - - - - - - - - - - |
    | 0 - - - 0 - - - 1_+1 - - - 3_+3 - - - |
    | 2_+2 - - - 3_+3 - 2_+2 - 1_+1 - - - 2_+2 - - - |
    | {mp} 3_+3 - - - - - - - - - - - - - - - |
    | 0 - - - 0 - - - 0 - - - 0 - - - |
    | 0 - - - 0 - - - 0 - - - 0 - - - |
}

Introduzione:PianoRH@|0| {
    <16*>
    | 0 - - - 0 - - - 0 - - - 0 - - - |
    | 0 - - - 0 - - - 0 - - - 0 - - - |
    | 0 - - - (5' 7 2^ 3^ 5'^ 7^)%(----) (2^^ 7^ 5'^ 3^ 2^ 7)%(----) 5' - - - |
    | 0 - - - {pp} 6+1^+3^ - - - 0 - - - 0 - - - |
    | 0 - - - 0 - - - 0 - - - 0 - - - |
    | 0 - - - (5 1^ 3^ 5^ 1^^ 3^^)%(----) (5^^ 3^^ 1^^ 5^ 3^ 1^)%(----) 5 - - - |
    /* 減七和弦上下兩個八度，接 E 大調音階下行，半音導入 B */
    | {mf} (7_ 2 4 6, 7 2^)%(--) (4^ 6,^ 7^ 2^^ 4^^ 6,^^)%(--) (7^^ 6,^^ 4^^ 2^^ 7^ 6,^)%(--) (4^ 2^ 7 6, 4 2)%(--) (1^ 7 1^ 2^ 1^ 7)%(--) (6 5 4 3 2 1)%(--) (7_ 6_ 5_ 6_ 6'_ 7_)%(--) (1 2 3 4 4' 4')%(--) |
    | {p} 5+7+2^+4^ - - - - - - - 0 - - - 0 - - - |
}

Introduzione:PianoLH@|0| {
    <16*>
    | {!= 58} {p} 6____+6___ - - - - - - - 6___+3__+6__ - - - - - - - |
    | 6___+6__ - - - 3__+6__+1_ - - - 5___+5__ - - - 4___+4__ - - - |
    | 3___+3__ - - - 7__+2_+5'_ - - - - - - - - - - - |
    | 6___+6__ - - - 3__+6__+1_ - - - 4___+4__ - - - 3__+6__+1_ - - - |
    | 2___+2__ - - - 6__+1_+4_ - - - 5___+5__ - - - 4__+7__+2_ - - - |
    | 1___+1__ - - - 5__+1_+3_ - - - - - - - - - - - |
    | 5___+5__ - - - - - - - - - - - - - - - |
    | 5___+5__ - - - - - - - - - - - - - - - |
}

/* ==========================================================
   Intro — Andantino, come acqua（原 Violin 主題）
   ========================================================== */

Intro:PianoCanto@|-1| {
    <16*>
    /* 原 Violin 主題，八度置於中音域 */
    | 0 - - - 0 - - - 0 - - - 5__+5_ - - - |
    | {mp} 1_+1 - - - 5__+5_ - - - 6__+6_ - - - 6__+6_ - - - |
    | 6__+6_ - 7__+7_ - 1_+1 - - - 7__+7_ - - - 6__+6_ - - - |
    | 5__+5_ - - - 5__+5_ - 6__+6_ - 5__+5_ - - - 5__+5_ - 5__+5_ - |
    | 5__+5_ - - - 5__+5_ - 6__+6_ - 5__+5_ - - - 5__+5_ - - - |
    | 1_+1 - - - 5__+5_ - - - 6__+6_ - - - 6__+6_ - - - |
