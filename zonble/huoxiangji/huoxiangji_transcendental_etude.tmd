/* ==========================================================
   A1 — Dolce, con fluidità（左手寬廣琶音）
   ========================================================== */

A1:PianoRH@|-1| {
    <16*>
    /* 灑來了一陣淅瀝 / 是綿綿不停的霪雨 */
    | {p} 0 - - - 0 - - - 3 - 2 3 1 - - - |
    | 5 - 6 5 6 - 1^ 6 5 - 6 5 4 - 5 4 |
    | 3 5 1^ 3^ 3^ - 3^ - 3^ 5^ 3^ 1^ 3^ - 3^ - |
    | 3^ 5 1^ 5 3^ - 3^ - 3^ 5 1^ 5 2^ 1^ 7 5 |
    | 1^ 7 6 5 4 3 2 7_ 1 - - - 3 - - - |
    | 2 - 1 2 3 4 2 - 1 2 7_ 1 2 - 3 2 |
    | 3 5 1^ 3^ 3^ - 3^ - 3^ 5^ 3^ 1^ 3^ - 3^ - |
    | 3^ 5 1^ 5 3^ - 3^ - 3^ 5 1^ 5 2^ 1^ 7 6 |
    | 1^ 7 6 5 4 3 2 7_ 3 - 2 3 1 - - - |
    /* 傳來了一串笑語 / 是苔痕親吻著山壁 */
    | {mp} 5 6 7 5 6 7 1^ 6 5 6 4 5 4 3 2 3 |
    | 3 5 7 3^ 3^ - 3^ - 3^ 5^ 3^ 7 3^ - 3^ - |
    | 3^ 6 1^ 6 3^ - 3^ - 3^ 6 1^ 6 2^ 1^ 7 6 |
    | 1^ 6 4 1 6 4 1 6_ 1 - - - 3 - - - |
    | 3 4 3 2 2 - 4 3 2 - 1 7_ 1 - - - |
    | 1 3 5 1^ 3^ - 3^ - 3^ 5^ 3^ 1^ 3^ - 3^ - |
    | 3^ 6 1^ 6 3^ - 3^ - 3^ 6 1^ 6 2^ 1^ 7 6 |
    | 1^ 5 3 1 5 - 4 5 1^ - 7 1^ 5 - - - |
}

