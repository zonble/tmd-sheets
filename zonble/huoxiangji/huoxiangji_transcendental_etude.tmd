/* ==========================================================
   A2 — Doppie note（右手三度、六度雙音）
   ========================================================== */

A2:PianoRH@|-1| {
    <16*>
    /* 飄來了一陣清新 / 是翻騰蒸潤的氤氳（三度） */
    | {mp} 0 - - - 0 - - - 1+3 - 7_+2 1+3 6_+1 - - - |
    | 3+5 - 4+6 3+5 4+6 - 5+7 4+6 3+5 - 4+6 3+5 2+4 - 3+5 2+4 |
    | 1+3 - - - 1+3 2+4 3+5 4+6 5+7 6+1^ 7+2^ 1^+3^ 1^+3^ - 1^+3^ - |
    | 1^+3^ - - - 1^+3^ - 1^+3^ - 1^+3^ 7+2^ 6+1^ 5+7 7+2^ 6+1^ 5+7 4+6 |
    | 3+5 2+4 1+3 7_+2 6_+1 5_+7_ 4_+6_ 5_+7_ 6_+1 - - - 1+3 - - - |
    | 7_+2 - 6_+1 7_+2 1+3 - 7_+2 - 6_+1 - 5_+7_ 6_+1 2+4 - - - |
    | 1+3 - - - 3+5 5+1^ 1^+3^ - 1^+3^ 7+2^ 1^+3^ - 1^+3^ - 1^+3^ - |
    | 1^+3^ - - - 1^+3^ - 1^+3^ - 1^+3^ 7+2^ 6+1^ 5+7 7+2^ 6+1^ 5+7 4+6 |
    | 3+5 2+4 1+3 7_+2 6_+1 5_+7_ 4_+6_ 5_+7_ 1+3 - 7_+2 1+3 6_+1 - - - |
    /* 傳來了一串跫音 / 是橋底溪澗的湍急（六度） */
    | 7_+5 - 1+6 7_+5 1+6 - 2+7 1+6 7_+5 - 1+6 7_+5 6_+4 - 7_+5 6_+4 |
    | 5_+3 - - - 5_+3 6_+4 7_+5 1+6 2+7 3+1^ 4+2^ 5+3^ 5+3^ - 5+3^ - |
    | 5+3^ - - - 5+3^ - 5+3^ - 5+3^ 4+2^ 3+1^ 2+7 4+2^ 3+1^ 2+7 1+6 |
    | 7_+5 6_+4 5_+3 4_+2 3_+1 2_+7_ 1_+6_ 2_+7_ 3_+1 - - - 5_+3 - - - |
    | 1+3 2+4 1+3 7_+2 7_+2 - 2+4 1+3 7_+2 - 6_+1 5_+7_ 6_+1 - - - |
    | 3_+1 - - - 1+3 3+5 5+1^ 1^+3^ 1^+3^ 7+2^ 1^+3^ - 1^+3^ - 1^+3^ - |
    | 1^+3^ - - - 1^+3^ - 1^+3^ - 1^+3^ 7+2^ 6+1^ 5+7 7+2^ 6+1^ 5+7 4+6 |
    | 3+5 2+4 1+3 7_+2 3+5 - 4+6 3+5 3+1^ - 2+7 3+1^ 3+5 - - - |
}

