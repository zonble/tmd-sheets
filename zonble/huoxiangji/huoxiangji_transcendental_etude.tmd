    | 7_+7 2 7_+7 2 6_+6 2 6_+6 2 7_+7 2 7_+7 2 7_+7 5 1+1^ 5 |
    /* 長音 1^ 上方鐘聲閃爍，左手接手前奏動機 */
    | 1+1^ 5^ 3^ 5^ 1^^ 5^ 3^ 5^ 1^^ 5^ 3^ 5^ 1^^ 5^ 3^ 5^ |
    | 5^ 2^ 7 2^ 5^ 2^ 7 2^ 4^ 2^ 7 2^ 5^ 2^ 7 5 |
    | 0 - - - 0 - - - 0 - - - 0 - - - |
}

