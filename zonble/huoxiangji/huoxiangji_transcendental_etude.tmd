/* ==========================================================
   B3 — Grandioso（高潮：四音和弦旋律＋三八度琶音）
   ========================================================== */

B3:PianoRH@|0| {
    <16*>
    /* 於是可以將種子埋入濕透的衣領 / 我的心，於是也蓋上一層植被 */
    | {ff} 6_+1+4+6 4 1 4 6_+1+4+6 4 1 4 6_+1+4+6 4 7_+2+4+7 4 1+4+6+1^ 6 4 6 |
    | 7_+2+5+7 5 2 5 6_+2+4+6 4 2 4 5_+7_+2+5 2 7_ 2 5 2 6_+2+4+6 4 |
    | 5_+1+3+5 3 1 3 5 1^ 3^ 5^ 1^^ 5^ 3^ 1^ 5 3 1 5_ |
    | 1+3+5+1^ 5 3 5 1^ 5 3 5 4+6+1^+4^ 1^ 6 1^ 3+6+1^+3^ 1^ 6 1^ |
    | 1+3+6+1^ 6 3 6 1+3+6+1^ 6 3 6 1+3+6+1^ 6 2+4+6+2^ 6 3+6+1^+3^ 1^ 6 1^ |
    | 2+5+7+2^ 7 5 7 3+5+7+3^ 7 2+5+7+2^ 7 1+4+5+1^ 5 4 5 4+5+7+4^ 7 5 7 |
    | 3+5+1^+3^ 1^ 5 1^ 3^ 1^ 5 3 5 1^ 3^ 5^ 2+5+7+2^ 7 5 7 |
    | 1+4+6+1^ 6 4 6 1^ 6 4 6 4+6+1^+4^ 1^ 6 1^ 3+6+1^+3^ 1^ 6 1^ |
    /* 我的心，攀滿了綠、還有紫色的、白色的藿香薊 / 一路開滿了藿香薊 */
