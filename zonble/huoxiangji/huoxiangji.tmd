::SCORE::
** 藿香薊 **
!= 110
?= E
~ "composer: zonble"
~ "date: 2006"
<4/4>

/* Intro */

Intro:Violin@|-1|{
    <4 *>
    | 0 0 0 5 |
    | 1^ 5 6 6 | (6 7)%(-) 1^ 7 6 | 5 (5 6)%(-) 5 (5 5)%(-) | 5 (5 6)%(-) 5 5 |
    | 1^ 5 6 6 | (6 7)%(-) 1^ 7 6 | (7 - - 1^)%(--) 1^ - | - - 1^ - |
    | - - - - | - - - - | 0 0 0 0 |
}

Intro:Piano@|6|{
    <4*>
    | [1_] 0 0 0 |
    | 1 1 (1 2)%(-) 3 | 3 2 (2 3)%(-) 2 | 1 1 (1 2)%(-) 3 | 3 2 (2 7_)%(-) 5_ |
    | [1_] - - - |
}

/* A */

A1:Vocal@|-1|{
    <4*>
    | 0 0 3 1 |
    L| _ _ 灑 來 |
    | 5 6 5 4 | 3 - - - | - - - - | 0 0 1 3 |
    L| 了 一 陣 淅 | 瀝 - - - | - - - - | _ _ 是 綿 |
    | 2 (3 2)%(-) 1 2 | 3 - - - | - - - - | 0 0 3 1 |
    L| 綿 (不 停) 的 霪 | 雨 - - - | - - - - | 0 0 傳 來 |
    | 5 6 5 4 | 3 - - - | - - - - | 0 0 1 3 |
    L| 了 一 串 笑 | 語 - - - | - - - - | 0 0 是 苔 |
    | 3 2 2 2 | (- 1)%(-) 1 - - | - - - - | 0 5 1^ 5 |
    L| 痕 親 吻 著 | (- 山) 壁 - - | - - - - | - 於 是 可 |
}

A1:Piano@|0|{
    <4*>
    | 0 0 0 0 | 0 (3 3)%(-) 3 (3 3)%(-) | 3 (3 3)%(-) 3 2 | 1 - - - |
    | 0 0 0 0 | 0 (3 3)%(-) 3 (3 3)%(-) | 3 (3 3)%(-) 3 2 | 1 - - - |
    | 0 0 0 0 | 0 (3 3)%(-) 3 (3 3)%(-) | 3 (3 3)%(-) 3 2 | 1 - - - |
    | 0 0 0 0 | 0 (3 3)%(-) 3 (3 3)%(-) | 3 (3 3)%(-) 3 2 | 1 - - - |
}

A1:Violin@|1|{
    <4 *>
    | 3 - 2 - | 3 - - - | - - - - |
    | 0 0 0 0 | 1 - 2 - | 3 - - - | - - - - |
    | 0 0 0 0 | 3 - 2 - | 3 - - - | - - - - |
    | 0 0 0 0 | 1 - 2 - | 1 - - - | - - - - |
}

/* B */

B1:Vocal@|0|{
    <4*>
    | (6 6 - 6)%(--) (6 7)%(-) 1^ | 7 6 (5 - - 6)%(--) | 5 - - - | - 5 1^ 5 |
    L| (以 知 - 道) (湖 面) 的 | 皺 紋 (叫 - - 漣) | 漪 - - - | - 於 是 可 |
    | (6 6 - 6)%(--) (6 7)%(-) 1^ | 7 6 (7 - - 1^)%(--) | 1^ - - - | - 5 1^ 5 |
    L| (以 知 - 道) (蕩 開) 的 | 方 向 (叫 - - 牽) | 引 - - - | - 於 是 可 |
    | (6 6 - 6)%(--) (6 7)%(-) 1^ | 7 6 (5 - - 6)%(--) | 5 (5 5)%(-) 5 (5 6)%(-) | 5 5 1^ 5 |
    L| (以 順 - 著) (燕 子) 的 | 輕 盈 (向 - - 著) | 不 (知 名) 處 (飛 去) | 去 一 路 上 |
    | 6 6 (6 7)%(-) 1^ | 7 6 (7 - - 1^)%(--) | - - - - | - - - - |
    L| 開 滿 (像 繁) 星 | 的 藿 (香 - - 薊) | - - - - | - - - - |
}

B1:Piano@|14|{
    <4*>
    | 1 1 (1 2)%(-) 3 | 3 2 (2 3)%(-) 2 | 1 - - - |
}

/* A */
A2:Vocal@|-1|{
    <4*>
    | 0 0 3 1 |
    L| _ _ 飄 來 |
    | 5 6 5 4 | 3 - - - | - - - - | 0 0 1 3 |
    L| 了 一 陣 清 | 新 - - - | - - - - | _ _ 是 翻 |
    | 2 (3 2)%(-) 1 4 | 3 - - - | - - - - | 0 0 3 1 |
    L| 騰 (蒸 潤) 的 氤 | 氳 - - - | - - - - | 0 0 傳 來 |
    | 5 6 5 4 | 3 - - - | - - - - | 0 0 1 3 |
    L| 了 一 串 跫 | 音 - - - | - - - - | 0 0 是 橋 |
    | 3 2 2 2 | (- 1)%(-) 1 - - | - - - - | 0 5 1^ 5 |
    L| 底 溪 澗 的 | (- 湍) 急 - - | - - - - | - 於 是 可 |
}

A2:Piano@|0|{
    <4 *>
    | 0 0 0 0 | 0 (3 3)%(-) 3 (3 3)%(-) | 3 (3 3)%(-) 3 2 | 1 - - - |
    | 0 0 0 0 | 0 (3 3)%(-) 3 (3 3)%(-) | 3 (3 3)%(-) 3 2 | 1 - - - |
    | 0 0 0 0 | 0 (3 3)%(-) 3 (3 3)%(-) | 3 (3 3)%(-) 3 2 | 1 - - - |
    | 0 0 0 0 | 0 (3 3)%(-) 3 (3 3)%(-) | 3 (3 3)%(-) 3 2 | 1 - - - |
}

A2:Violin@|0|{
    <4 *>
    | 0 0 0 0 | 3 - 2 - | 3 - - - | - - - - |
    | 0 0 0 0 | 1 - 2 - | 3 - 2 - | 1 - - - |
    | 0 0 0 0 | 3 - 2 - | 3 - - - | - - - - |
    | 0 0 0 0 | 1 - 2 - | 1 - - - | - - - - |
}

/* B */

B2:Vocal@|0|{
    <4*>
    | (6 6 - 6)%(--) (6 7)%(-) 1^ | 7 6 (5 - - 6)%(--) | 5 - - - | - 5 1^ 5 |
    L| (以 知 - 道) (枝 椏) 的 | 起 伏 (叫 - - 韻) | 律 - - - | - 於 是 可 |
    | (6 6 - 6)%(--) (6 7)%(-) 1^ | 7 6 (7 - - 1^)%(--) | 1^ - - - | - 5 1^ 5 |
    L| (以 知 - 道) (葉 片) 的 | 顫 動 (叫 - - 呼) | 吸 - - - | - 於 是 可 |
    | (6 6 - 6)%(--) (6 7)%(-) 1^ | 7 6 (5 - - 6)%(--) | 5 (5 5)%(-) 5 (5 6)%(-) | 5 5 1^ 5 |
    L| (以 順 - 著) (燕 子) 的 | 輕 盈 (向 - - 著) | 不 (知 名) 處 (飛 去) | 去 一 路 上 |
    | 4 4 (6 7)%(-) 1^ | 7 6 (7 - - 1^)%(--) | 1^ - - - | - 5 1^ 5 |
    L| 開 滿 (像 繁) 星 | 的 藿 (香 - - 薊) | - - - - | - 於 是 可 |
}

B2:Piano@|14|{
    <4*>
    | 1 1 (1 2)%(-) 3 | 3 2 0 0 |
}

B3:Vocal@|0|{
    <4*>
    | (6 6 - 6)%(--) (6 7)%(-) 1^ | 7 6 (5 - - 6)%(--) | 5 - - - | 1^ - 4^ 3^ |
    L| (以 將 - 種) (子 埋) 入 | 濕 透 (的 - - 衣) | 領 - - - | 喔 - 我 的 |
    | 1^ 1^ (1^ 2^)%(-) 3^ | (2^ - 3^ 2^)%(--) 1^ 4^ | 3^ - - 2^ | 1^ - 4^ 3^ |
    L| 心 於 (是 也) 蓋 | (上 - 一 -) 層 植 | 被 - - 喔 | 喔 - 我 的 |
    | 1^ - (1^ 2^)%(-) 3^ | 2^ - 1^ 2^ | 3^ 4^ 3^ - | 3^ (3^ 3^)%(-) 3^ (2^ 1^)%(-) |
    L| 心 - (攀 滿) 了 | 綠 - 還 有 | 紫 色 的 - | 白 (色 的) 藿 (香 薊) |
    | 1^ 4 4^ 3^ | 2^ 3^ (2^ - 1^ 2^)%(--) | 1^ - - - | - - - - |
    L| - 一 路 開 | 滿 了 (藿 - 香 -) | 薊 - - - | - - - - |
}

C1:Vocal@|0|{
    <4*>
    /* 迎面吹來下坡的風
    看見密雲漸漸散去
    一路開滿了藿香薊 */
    | 0 5^ 5^ 6^ | (5^ - - 4^)%(--) (3^ 2^)%(--) |
    | (3^ - - 1^)%(--) 1^ 2^ | (3^ - - 3^)%(--) (3^ 2^)%(-) 1^ |
    | 1^ - 1^ 3^ | (2^ 2^ 3^ 2^)%(--) 1^ 2^ | 3^ - - - | - - - - |
}

C2:Vocal@|0|{
    <4*>
    /* 開在路邊平凡如我
    也能訴說春的消息
    紫色、白色的藿香薊 */
    | 0 5^ 5^ 6^ | (5^ - - 4^)%(--) (3^ 2^)%(--) |
    | (3^ - - 1^)%(--) 1^ 2^ | (3^ - - 3^)%(--) (3^ 2^)%(-) 1^ |
    | 1^ - 1^ 3^ | 3^ 2^ (2^ - - 1^)%(--) | 1^ - - - | - - - - |
}

C3:Vocal@|0|{
    <4*>
    /* 迎面吹來下坡的風
    看見天際漸漸放晴
    一路開滿了藿香薊 */
    | 0 5^ 5^ 6^ | (5^ - - 2^)%(--) (5^ 4^)%(--) |
    | (3^ - - 1^)%(--) 1^ 2^ | (3^ - - 3^)%(--) (3^ 2^)%(-) 1^ |
    | 1^ - 1^ 3^ | (2^ 2^ 3^ 2^)%(--) 1^ 4^ | 3^ - - - | - - - - |
}

C4:Vocal@|0|{
    <4*>
    /* 走在路邊草芥如我
    也能領略春的消息
    紫色、白色的藿香薊 */
    | 0 5^ 5^ 6^ | (5^ - - 2^)%(--) (5^ 4^)%(--) |
    | (3^ - - 1^)%(--) 1^ 2^ | (3^ - - 3^)%(--) (3^ 2^)%(-) 1^ |
    | 1^ - 1^ 3^ | 3^ 2^ (2^ - - 1^)%(--) | 1^ - - - | - - - - |
}

-> Intro
    -> A1
    -> B1
    -> A2
    -> B2
    -> B3
    -> C1
    -> C2
    -> C3
    -> C4
    -> #
