/* ==========================================================
   A2 — Il canto nel basso, tremolando
   ========================================================== */

A2:PianoCanto@|-1| {
    <16*>
    /* 旋律移到次中音（如大提琴） */
    | {mf} 0 - - - 0 - - - 3_ - - - 1_ - - - |
    | 5_ - - - 6_ - - - 5_ - - - 4_ - - - |
    | 3_ - - - - - - - - - - - - - - - |
