/* ==========================================================
   B3 — Sonore sans dureté（La cathédrale engloutie）
   於是可以將種子埋入濕透的衣領 / 我的心，於是也蓋上一層植被 / 我的心，攀滿了綠、還有紫色的、白色的藿香薊
   ========================================================== */

B3:PianoCanto@|0| {
    <16*>
    /* 四度＋五度＋八度的平行和弦（奧加農） */
    | {ff} 6_+2+3+6 - - - 6_+2+3+6 - - - 6_+2+3+6 - 7_+3+4'+7 - 1+4+5+1^ - - - |
    | 7_+3+4'+7 - - - 6_+2+3+6 - - - 5_+1+2+5 - - - - - 6_+2+3+6 - |
    | 5_+1+2+5 - - - - - - - - - - - - - - - |
    | 1+4+5+1^ - - - - - - - 4+7,+1^+4^ - - - 3+6+7+3^ - - - |
    | 1+4+5+1^ - - - 1+4+5+1^ - - - 1+4+5+1^ - 2+5+6+2^ - 3+6+7+3^ - - - |
    | 2+5+6+2^ - - - 3+6+7+3^ - 2+5+6+2^ - 1+4+5+1^ - - - 4+7,+1^+4^ - - - |
    | 3+6+7+3^ - - - - - - - - - - - 2+5+6+2^ - - - |
    | 1+4+5+1^ - - - - - - - 4+7,+1^+4^ - - - 3+6+7+3^ - - - |
    | 1+4+5+1^ - - - 1+4+5+1^ - - - 1+4+5+1^ - 2+5+6+2^ - 3+6+7+3^ - - - |
    | 2+5+6+2^ - - - - - - - 1+4+5+1^ - - - 2+5+6+2^ - - - |
    | 3+6+7+3^ - - - 4+7,+1^+4^ - - - 3+6+7+3^ - - - - - - - |
    | 3+6+7+3^ - - - 3+6+7+3^ - 3+6+7+3^ - 3+6+7+3^ - - - 2+5+6+2^ - 1+4+5+1^ - |
    | 1+4+5+1^ - - - 4_+7,_+1+4 - - - 4+7,+1^+4^ - - - 3+6+7+3^ - - - |
    | 2+5+6+2^ - - - 3+6+7+3^ - - - 2+5+6+2^ - - - 1+4+5+1^ - 2+5+6+2^ - |
    | 1+4+5+1^ - - - - - - - - - - - - - - - |
    | - - - - - - - - - - - - - - - - |
}

