/* ==========================================================
   Coda — Comme au début, plus lent
   Violin 主題升到高音區，停在 E6/9，不解決
   ========================================================== */

Coda:PianoCanto@|0| {
    <16*>
    /* 平行四度 */
    | {ppp} 1^^+5^+1^ - - - 5^+2^+5 - - - 6^+3^+6 - - - 6^+3^+6 - - - |
    | 6^+3^+6 - 7^+4'^+7 - 1^^+5^+1^ - - - 7^+4'^+7 - - - 6^+3^+6 - - - |
