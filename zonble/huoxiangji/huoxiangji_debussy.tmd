    | 0 - - - 0 - - - 0 - - - 0 - - - |
    | 0 - - - 0 - - - (5^ 3^ 2^)%(----) (1^ 6 5)%(----) |
    | 0 - - - 0 - - - 0 - - - 0 - - - |
