    | (1^ 2^ 3^)%(----) (5^ 6^ 1^^)%(----) (2^^ 3^^ 5^^)%(----) 6^^ - - - |
    | 1^+5^+2^^+6^^ - - - - - - - - - - - - - - - |
}

