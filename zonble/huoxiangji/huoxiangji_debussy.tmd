/* ==========================================================
   C2 — Très calme et doucement expressif（La fille aux cheveux de lin）
   轉到 G（♭III），五聲音階牧歌：開在路邊平凡如我 / 也能訴說春的消息 / 紫色、白色的藿香薊
   ========================================================== */

C2:PianoCanto@|0| {
    <16*>
    /* 旋律下方加平行四度 */
    | {p} 0 - - - 2+5 - - - 2+5 - - - 3+6 - - - |
    | 2+5 - - - - - 1+4 - 7_+3 - - - 6_+2 - - - |
    | 7_+3 - - - - - 5_+1 - 5_+1 - - - 6_+2 - - - |
    | 7_+3 - - - - - 7_+3 - 7_+3 - 6_+2 - 5_+1 - - - |
    | 5_+1 - - - - - - - 5_+1 - - - 7_+3 - - - |
    | 7_+3 - - - 6_+2 - - - 6_+2 - - - - - 5_+1 - |
    | 5_+1 - - - - - - - - - - - - - - - |
    | - - - - - - - - - - - - - - - - |
}

C2:PianoRH@|0| {
