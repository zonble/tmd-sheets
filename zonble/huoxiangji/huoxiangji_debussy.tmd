/* ==========================================================
   C1 — Animé（Le vent dans la plaine）
   迎面吹來下坡的風 / 看見密雲漸漸散去 / 一路開滿了藿香薊
   ========================================================== */

C1:PianoCanto@|0| {
    <16*>
    /* 旋律放在中音域 */
    | {mp} 0 - - - 5 - - - 5 - - - 6 - - - |
    | 5 - - - - - 4 - 3 - - - 2 - - - |
    | 3 - - - - - 1 - 1 - - - 2 - - - |
    | 3 - - - - - 3 - 3 - 2 - 1 - - - |
    | 1 - - - - - - - 1 - - - 3 - - - |
    | 2 - 2 - 3 - 2 - 1 - - - 2 - - - |
    | 3 - - - - - - - - - - - - - - - |
    | - - - - - - - - - - - - - - - - |
}

C1:PianoRH@|0| {
    <16*>
    /* 兩音交替的六連音頑固音型 */
    | {pp} (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) |
    | (2^ 3^ 2^ 3^ 2^ 3^)%(----) (2^ 3^ 2^ 3^ 2^ 3^)%(----) (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) |
    | (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) |
    | (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) |
    /* 第 5–6 小節改為半音交替，風勢轉強 */
    | (3,^ 3^ 3,^ 3^ 3,^ 3^)%(----) (3,^ 3^ 3,^ 3^ 3,^ 3^)%(----) (3^ 4^ 3^ 4^ 3^ 4^)%(----) (3^ 4^ 3^ 4^ 3^ 4^)%(----) |
    | (2^ 3,^ 2^ 3,^ 2^ 3,^)%(----) (2^ 3,^ 2^ 3,^ 2^ 3,^)%(----) (3^ 4^ 3^ 4^ 3^ 4^)%(----) (3^ 4^ 3^ 4^ 3^ 4^)%(----) |
    | (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) |
    | (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) (3^ 4'^ 3^ 4'^ 3^ 4'^)%(----) |
}

