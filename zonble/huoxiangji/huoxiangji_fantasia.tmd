/* ==========================================================
   Grandioso — 旋律在上、A 主題在低音
   ========================================================== */

Grandioso:PianoCanto@|0| {
    <16*>
    /* 於是可以將種子埋入濕透的衣領 / 我的心，於是也蓋上一層植被 / 我的心，攀滿了綠、還有紫色的、白色的藿香薊 */
    | {ff} 6_+4+6 - - - 6_+4+6 - - - 6_+4+6 - 7_+4+7 - 1+6+1^ - - - |
