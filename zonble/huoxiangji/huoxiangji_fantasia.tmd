    | 0 - - - 0 - - - 0 - - - 0 - - - |
    | 0 - - - 0 - - - (5' 7 2^ 3^ 5'^ 7^)%(----) (2^^ 3^^ 5'^^ 7^^ 2^^^ 3^^^)%(----) |
    | 0 - - - 0 - - - 0 - - - 0 - - - |
    | 0 - - - 0 - - - (7 2^ 4^ 5^ 7^ 2^^)%(----) (4^^ 5^^ 7^^ 2^^^ 4^^^ 5^^^)%(----) |
    /* 半音階八度下行兩個八度 */
    | {ff} (5^+5^^ 4'^+4'^^ 4^+4^^ 3^+3^^ 3,^+3,^^ 2^+2^^)%(--) (2,^+2,^^ 1^+1^^ 7+7^ 7,+7,^ 6+6^ 6,+6,^)%(--) (5+5^ 4'+4'^ 4+4^ 3+3^ 3,+3,^ 2+2^)%(--) (2,+2,^ 1+1^ 7_+7 7,_+7, 6_+6 6,_+6,)%(--) 5_+5 - - - 0 - - - |
    | (5_ 7_ 2 4 5 7)%(----) (2^ 4^ 5^ 7^ 2^^ 4^^)%(----) 5^^ - - - 0 - - - |
}

