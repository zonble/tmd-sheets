::SCORE::
** Voyage Part 6 - Elephant in Taiwan & Zongzhi Epilogue (大象抵台與宗治回歸尾聲) **

!= 84
?= C
<4/4>

/* 
 * ===================================================================
 * 第二樂章終景：大象抵台與宗治回歸尾聲
 * 1. 大象主題再現（Lin Wang Steps & Theme）：
 *    林旺搖搖晃晃走下登陸艦跳板，踏上台灣南方的土地（鳳山）。
 *    低音號與低音管憨厚笨重踏步，台灣南部的微風拂過牠粗糙的皮膚。
 * 2. 結尾回到宗治主題（Zongzhi Epilogue）：
 *    在巨象安頓、夕陽西下的南國暮色裡，
 *    大提琴重新拉起宗治的《香夭》核心旋律，
 *    不再有第一樂章軍樂的亢奮，而是帶著一生顛沛流離之後的平靜、滄桑與安頓。
 * ===================================================================
 */

-> Elephant_Landing_Steps
-> Elephant_Theme_Warmth
-> Handoff_To_Zongzhi
-> Zongzhi_Sunset_Soliloquy
-> Movement2_Peaceful_End
-> #

/* -------------------------------------------------------------------
   1. 大象踏上台灣土地（4 小節，11 秒）：
      低音號、低音管與大提琴笨重踏步，巨象搖搖晃晃走下碼頭跳板
   ------------------------------------------------------------------- */
Elephant_Landing_Steps:Tuba@|0|{
    <8*>
    | 5__ 5__ 5__ 5__  5__ 3__ 2__ 3__ | 1__ - - - - - - - |
    | 5__ 5__ 5__ 5__  5__ 3__ 2__ 3__ | 2__ - - - - - - - |
}

Elephant_Landing_Steps:Bassoon@|0|{
    <8*>
    | 1_ 0 3_ 0  2_ 0 5_ 0 | 1_ - - -  0 - - - |
    | 1_ 0 3_ 0  2_ 0 5_ 0 | 2_ - - -  0 - - - |
}

Elephant_Landing_Steps:Cello@|0|{
    <4*>
    | 1__ 0 5___ 0 | 1__ 0 5___ 0 |
    | 1__ 0 5___ 0 | 2__ 0 5___ 0 |
}

Elephant_Landing_Steps:Strings@|0|{
    <4*>
    [C] - - - | [C] - - - |
    [C] - - - | [G] - - - |
}

/* -------------------------------------------------------------------
   2. 陽光下的溫柔巨獸（8 小節，23 秒）：
      長笛與單簧管加入，台灣南方的孩童圍繞著大象好奇觀看，
      大象主題帶上一層溫馨祥和的金色陽光色彩
   ------------------------------------------------------------------- */
Elephant_Theme_Warmth:Tuba@|0|{
    <8*>
    | 5__ 5__ 5__ 5__  5__ 3__ 2__ 3__ | 1__ - - - - - - - |
    | 6___ 1__ 2__ 3__  5__ 3__ 2__ 3__ | 1__ - - - - - - - |
    | 5__ 5__ 5__ 5__  5__ 3__ 2__ 3__ | 1__ - - - - - - - |
    | 6___ 1__ 2__ 3__  5__ 3__ 2__ 3__ | 1__ - - - - - - - |
}

Elephant_Theme_Warmth:Clarinet@|0|{
    <8*>
    | 5 5 5 5  5 3 2 3 | 1 - - - - - - - |
    | 6_ 1 2 3  5 3 2 3 | 1 - - - - - - - |
    | 5 5 5 5  5 3 2 3 | 1 - - - - - - - |
    | 6_ 1 2 3  5 3 2 3 | 1 - - - - - - - |
}

Elephant_Theme_Warmth:Flute@|0|{
    <8*>
    | 0 - - - - - - - | 0 - - - - - - - |
    | 0 - - - - - - - | 0 - - - - - - - |
    | 5^ 5^ 5^ 5^  5^ 3^ 2^ 3^ | 1^ - - - - - - - |
    | 6 1^ 2^ 3^  5^ 3^ 2^ 3^ | 1^ - - - - - - - |
}

Elephant_Theme_Warmth:Strings@|0|{
    <4*>
    [C] - [Am] - | [F] - [C] - |
    [F] - [G] -  | [C] - - - |
    [C] - [Am] - | [F] - [C] - |
    [F] - [G] -  | [C] - - - |
}

/* -------------------------------------------------------------------
   3. 轉場交接（4 小節，11 秒）：
      熱鬧退去，暮色漸深。單簧管吹響最後一聲象步餘韻，
      弦樂悄悄由 C 大調轉入深沉的 Am，大提琴準備出場
   ------------------------------------------------------------------- */
Handoff_To_Zongzhi:Clarinet@|0|{
    <8*>
    | 5 3 2 3  1 - - - | 0 - - - - - - - |
    | 0 - - - - - - - | 0 0 3_ 5_  6_ - - - |
}

Handoff_To_Zongzhi:Strings@|0|{
    <4*>
    [C] - [G] - | [Am] - - - |
    [F] - - -  | [Esus4] - [E7] - |
}

Handoff_To_Zongzhi:Cello@|0|{
    <4*>
    | 1_ - 5__ - | 6__ - - - |
    | 4__ - - - | 3__ - - - |
}

/* -------------------------------------------------------------------
   4. 宗治的日落獨白（8 小節，23 秒）：
      宗治主題完整再現！大提琴深情、滄桑的獨奏。
      告別了珠江逃難、告別了新一軍的凱旋狂歡、告別了東北長春的死亡冰雪。
      歷盡萬劫，客居海島，在南方海風中安身立命。
   ------------------------------------------------------------------- */
Zongzhi_Sunset_Soliloquy:Cello@|0|{
    <4*>
    | 3_ 6_ (5_ 6_ 5_ 3_)%(--) | 6_ - - (7__ 6_)%(-) | 5_ 3_ 3_ (5_ 1)%(-) | 2 7_ 7_ 5_ |
    | 3_ 6_ (5_ 6_ 5_ 3_)%(--) | 6_ - - (7__ 6_)%(-) | 5_ 3_ 3_ (5_ 1)%(-) | 2 7_ 2 6_ |
}

Zongzhi_Sunset_Soliloquy:Strings@|0|{
    <4*>
    [Am] - [Em] - | [F] - [C] - | [Dm] - [Am] - | [E7] - - - |
    [Am] - [Em] - | [F] - [C] - | [Dm] - [Am] - | [E7] - [Am] - |
}

Zongzhi_Sunset_Soliloquy:Clarinet@|0|{
    <4*>
    | 0 - - - | 0 - - - | 0 - - - | 0 - - - |
    | 0 - - - | 0 - - - | 0 - - - | 2 7_ 2 6_ |
}

/* -------------------------------------------------------------------
   5. 第二樂章安歇終局（4 小節，11 秒）：
      大提琴落在最後的 6__，長音緩緩消融，海浪聲微弱泛起，全樂章落幕
   ------------------------------------------------------------------- */
Movement2_Peaceful_End:Cello@|0|{
    <4*>
    | 6__ - - - | - - - - |
    | 6__ - - - | 6__ 0 0 0 |
}

Movement2_Peaceful_End:Clarinet@|0|{
    <4*>
    | 6_ - - - | - - - - |
    | 6_ - - - | 6_ 0 0 0 |
}

Movement2_Peaceful_End:Strings@|0|{
    <4*>
    [Am] - - - | [Am] - - - |
    [Am] - - - | [Am] 0 0 0 |
}
