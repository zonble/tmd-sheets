    | 0 - - - | 0 - - - | 1^ - - - | 5 - - - |
    | 0 - - - | 0 - - - | 1^ - - - | 7 - - - |
    | 6 - - - | 5 - - - | 4 - - - | 5 - - - |
    | 0 - - - | 0 - - - | 1^ - 7 - | 1^ - - - |
}

