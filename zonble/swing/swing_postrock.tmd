    | [C] - [Dm] - | [Em] - [G] - | [C] - [Dm] - | [C] - - - |
    | [C] - [Dm] - | [Em] - [G] - | [C] - [Dm] - | [C] - - - |
    | [C] - [Dm] - | [Em] - [G] - | [C] - [Dm] - | [C] - - - |
    | [C] - [Dm] - | [Em] - [G] - | [C] - [G] - | [F] [Em] [Dm] [G] |
}

