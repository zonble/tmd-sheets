    <8*>
    | 1_ 1_ 1_ 1_ 2_ 2_ 2_ 2_ | 3_ 3_ 3_ 3_ 5_ 5_ 5_ 5_ | 1_ 1_ 1_ 1_ 2_ 2_ 2_ 2_ | 1_ 1_ 1_ 1_ 1_ 1_ 1_ 1_ |
    | 1_ 1_ 1_ 1_ 2_ 2_ 2_ 2_ | 3_ 3_ 3_ 3_ 5_ 5_ 5_ 5_ | 1_ 1_ 1_ 1_ 2_ 2_ 2_ 2_ | 1_ 1_ 1_ 1_ 1_ 1_ 1_ 1_ |
    | 1_ 1_ 1_ 1_ 2_ 2_ 2_ 2_ | 3_ 3_ 3_ 3_ 5_ 5_ 5_ 5_ | 1_ 1_ 1_ 1_ 2_ 2_ 2_ 2_ | 1_ 1_ 1_ 1_ 1_ 1_ 1_ 1_ |
    | 1_ 1_ 1_ 1_ 2_ 2_ 2_ 2_ | 3_ 3_ 3_ 3_ 5_ 5_ 5_ 5_ | 1_ 1_ 1_ 1_ 5_ 5_ 5_ 5_ | 4_ 4_ 3_ 3_ 2_ 2_ 5_ 5_ |
}

C:synthStrings1@|0|{
    <4*>
    /* 巨大弦樂音牆大長音，寬廣深邃 (Massive Ambient Pad) */
    | 1^ - - - | 7 - - - | 6 - - - | 5 - - - |
