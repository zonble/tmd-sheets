::SCORE::
** 鐘擺 (後搖滾音牆版 / Post-Rock Massive Wall of Sound) **
!= 100
?= C
<4/4>

/*
  後搖滾大音牆編制 (Post-Rock Wall of Sound Setup):
  - Vocal: 人聲主旋律
  - cleanGuitar: 空間清音電吉他 (Reverb & Tape Delay，晶瑩水下撥弦)
  - distortionGuitar: 猛烈破音電吉他 (Heavy Power Chords / Strumming，主音牆)
  - overdriveGuitar: 高把位過載吉他 (Tremolo Lead & High Octaves，天際嘶吼)
  - synthStrings1: 合成器厚重弦樂海嘯 (Massive Pad / White Noise Wall)
  - Bass: 重型電貝斯 (8th-note Driving Pick Bass)
  - Drums: 後搖滾暴風雨鼓組 (Soft Shimmer -> Explosive Crash Beats)
  - Cello: 深海大提琴長弓 (Deep Sadness)

  音牆結構：
  - Intro / A1: 只有 cleanGuitar 與 Cello，水下延遲，寂靜空靈
  - A2: Bass、Drums 輕輕切入，積蓄第一層暗湧
  - B1 / B2: Drums 轉為沉重大鼓/桶鼓，Cello 撕裂，overdriveGuitar 遠方低鳴
  - C (排比句): distortionGuitar 開始大力痛刷破音和弦！[C] [G] [Am] [F] 重拳出擊！
  - D (音牆海嘯大爆炸！):
    * distortionGuitar：全八分音符死命暴刷破音和弦！
    * overdriveGuitar：高八度極速輪指顫音 (Tremolo Picking)！
    * synthStrings1：全立體聲弦樂音牆鋪滿整個空間！
    * Drums：大鼓雙踏、小鼓狂擊、Crash 鈸每拍炸裂！
  - End: 最高潮處瞬間切斷！只留下一聲「動」與吉他長音電流餘燼。
*/

/* ========================================================================= */
/* INTRO (8 bars): 深海殘響與冰冷鐘擺 (Space Delay & Ambient Cello)          */
/* ========================================================================= */

Intro:PianoRH@|0|{
    <8*>
    /* 右手：純粹、乾淨的鐘擺原版主題 */
    | 1 - 3 - 2 1 3 - | 1 - 3 - 2 1 3 - | 1 - 3 - 2 1 3 2 | 2 1 3 2 2 1 1 - |
    | 1 - 3 - 2 1 3 - | 1 - 3 - 2 1 3 - | 1 - 3 - 2 1 3 2 | 2 1 3 2 2 1 1 - |
}

Intro:PianoLH@|0|{
    <8*>
    /* 左手部：簡約溫柔的低音分解伴奏 (Bass + 5th + octave) */
    /* Bar 1-2: C -> C/B 或 Am 溫柔沉澱 */
    | 1_ - 5_ - 1 - 5_ - | 1_ - 5_ - 1 - 5_ - |
    /* Bar 3-4: F -> G 乾淨支撐 */
    | 4__ - 1_ - 4_ - 1_ - | 5__ - 2_ - 5_ - 2_ - |
    /* Bar 5-6: C -> Am */
    | 1_ - 5_ - 1 - 5_ - | 6__ - 3_ - 6_ - 3_ - |
    /* Bar 7-8: F -> G -> C 緩慢收尾 */
    | 4__ - 1_ - 4_ - 1_ - | 5__ - - - 1_ - - - |
}

Intro:Cello@|0|{
    <4*>
    /* 溫暖柔和的深沉長弓鋪底 */
    | 1_ - - - | - - - - | 6__ - - - | - - - - |
    | 4__ - - - | - - - - | 5__ - - - | - - - - |
}


/* ========================================================================= */
/* A1: 他總像是鐘擺一般過活 (極簡、呢喃、深海寂靜)                           */
/* ========================================================================= */

A1:Vocal@|0|{
    <4*>
    /* 他總像是鐘擺一般過活 */
    | 1 3 2 1 | 2 3 5 ( 0 7_)%(-) | 1 - - ( 0 7_)%(-) | 5_ - - - |
    /* 從這頭不斷擺蕩到那頭 */
    | 1 3 2 ( 1 5_)%(-) | 2 3 5 ( 0 7_)%(-) | 1 - - ( 0 1)%(-) | 7_ - - - |
    /* 有時一個人在這裡，有時一個人在那頭 */
    | 1 3 2 ( 1 5_)%(-) | 2 3 3 - |  1 3 2 ( 1 5_)%(-) | 1 2 1 - |
    /* 他總像是鐘擺一般過活 */
    | 1 3 2 1 | 2 3 5 ( 0 7_)%(-) | 1 - - ( 0 2)%(-) | 1 - - - |
}

