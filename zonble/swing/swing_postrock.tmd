/* ========================================================================= */
/* B1: 風 一股寒流 (桶鼓轟鳴，暗湧席捲而來)                                  */
/* ========================================================================= */

B1:Vocal@|0|{
    <4*>
    /* 風 一股 寒流 都能夠沒有理由就將思緒牽 */
    | 5 - 3 1 | (5 2)%(-) 2 3 5 | 6 5 3 2 | 3 2 (3 2)%(-) 1 |
    /* 動 即使明知 他鄉的誘惑 也不能新奇 多久 一陣*/
    | 5 - 3 1 | (2 3 0 3 3 2)%(---) 1 | (6_ 1 0 3 3 2 1 1)%(----)| 1 5_ 3 1 |
}

B1:Piano@|0|{
    <8*>
    /* 鼓突然退場！世界驟然沉寂，鋼琴在此變奏出冰冷、孤獨而哀傷的和聲 */
    /* Bar 1-2: C -> Dm (寒流襲來，哀傷下沉) */
    | 1_ 5_ 3 5 1_ 5_ 3 5 | 2_ 6_ 4 6 2_ 6_ 4 6 |
    /* Bar 3-4: Am -> G -> C (思緒牽動，鐘擺無聲擺盪) */
    | 6__ 3_ 1 3 5__ 2_ 7_ 2 | 1_ 5_ 3 5 1_ - - - |
    /* Bar 5-6: Am -> Em -> F -> G (他鄉的誘惑) */
    | 6__ 3_ 1 3 3__ 7__ 5_ 7_ | 4__ 1_ 4 6 5__ 2_ 5 7 |
    /* Bar 7-8: Am -> F -> C (悲傷收斂，不能新奇多久) */
    | 6__ 3_ 6_ 1 4__ 1_ 4_ 6_ | 1_ 5_ 1 - 1_ - - - |
}

B1:Cello@|0|{
    <4*>
    /* 遠處寒風般微弱悲涼的長音 */
    | 1_ - - - | 2_ - - - | 1_ - 7__ - | 1_ - - - |
    | 6__ - 5__ - | 4__ - 5__ - | 6__ - 4__ - | 1_ - - - |
}

B1:synthStrings1@|0|{
    <4*>
    /* 極薄極冷的環境底噪 (Cold Ambient Pad) */
    | 1 - - - | 2 - - - | 1 - 7_ - | 1 - - - |
    | 6_ - 5_ - | 4_ - 5_ - | 6_ - 4_ - | 1 - - - |
}


