/* ========================================================================= */
/* C: 排比句 (在他鄉...在故鄉... 破音全力猛刷和弦！音牆第一波爆發！)          */
/* ========================================================================= */

C:Vocal@|0|{
    <4*>
    /* 在他鄉被別人排擠 在故鄉被自己人壓迫 */
    | 1 3 2 (1 5_)%(-) | 2 3 3 - |  1 3 2 (1 5_)%(-) | 1 2 1 - |
    /* 在他鄉總覺得委屈 在故鄉也一樣沒人懂 */
    | 1 3 2 (1 5_)%(-) | 2 3 3 - |  1 3 2 (1 5_)%(-) | 1 2 1 - |
    /* 在他鄉是一份孤寂 在故鄉是另一種難過 */
    | 1 3 2 (1 5_)%(-) | 2 3 3 - |  1 3 2 (1 5_)%(-) | 1 2 1 - |
    /* 在他鄉總想著回去 在故鄉卻更想逃走 */
    | 1 3 2 (1 5_)%(-) | 2 3 5 - |  1 3 2 (5 5_)%(-) | 4 3 1 - |
}

C:distortionGuitar@|0|{
    <8*>
    /* 破音吉他 1：中低音全八分音符暴刷破音和弦！(Heavy Power Chords Drive) */
    | [C] [C] [C] [C] [Dm] [Dm] [Dm] [Dm] | [Em] [Em] [Em] [Em] [G] [G] [G] [G] | [C] [C] [C] [C] [Dm] [Dm] [Dm] [Dm] | [C] [C] [C] [C] [C] [C] [C] [C] |
    | [C] [C] [C] [C] [Dm] [Dm] [Dm] [Dm] | [Em] [Em] [Em] [Em] [G] [G] [G] [G] | [C] [C] [C] [C] [Dm] [Dm] [Dm] [Dm] | [C] [C] [C] [C] [C] [C] [C] [C] |
    | [C] [C] [C] [C] [Dm] [Dm] [Dm] [Dm] | [Em] [Em] [Em] [Em] [G] [G] [G] [G] | [C] [C] [C] [C] [Dm] [Dm] [Dm] [Dm] | [C] [C] [C] [C] [C] [C] [C] [C] |
    | [C] [C] [C] [C] [Dm] [Dm] [Dm] [Dm] | [Em] [Em] [Em] [Em] [G] [G] [G] [G] | [C] [C] [C] [C] [G] [G] [G] [G]     | [F] [F] [Em] [Em] [Dm] [Dm] [G] [G] |
}

C:overdriveGuitar@|0|{
    <4*>
