::SCORE::
** 鐘擺 (音樂課鋼琴伴奏版 / School Music Class Piano Version) **
!= 100
?= C
~ "composer: zonble"
~ "note: 原曲寫於 2011 年（2026年音樂課本鋼琴伴奏版改編）"
<4/4>

/*
  音樂課鋼琴伴奏與機械時鐘編制 (School Music Class Piano & Clockwork Setup):
  - Vocal: 人聲主旋律 (完全保留原版旋律與節奏)
  - PianoRH: 鋼琴右手 (課本前奏主題、端正的大三和弦伴奏、樂句空檔乖巧的課本過門音)
  - PianoLH: 鋼琴左手 (拜厄 Beyer 式的阿爾貝堤低音 Do-Sol-Mi-Sol、正拍根五音進行曲步伐、八度交替低音)
  - Woodblock: 機械節拍器／老時鐘滴答聲 (GM Program 115，以 `Woodblock[pitchMode=fixed]` 鎖定高低音 `5 1 5 1` 模擬「滴—答—滴—答」)

  編曲核心意象——「用最端正的音樂課本大調與無情的節拍器，伴奏最無處可逃的人生」：
  - 全曲嚴格只使用最純粹、最乖巧的 C 大調課本和聲 (C, F, G, G7，僅在 B 段經過標準的 Dm 與 Am)。
  - Woodblock 從第 1 小節起就毫無感情地敲著四分音符 `5 1 5 1`（滴—答—滴—答）。
  - 在 B2 結尾「也不能新奇多久 (`2 1 0 0`)」人聲與鋼琴雙手離鍵休止的那兩拍空白裡，全場寂靜，只有時鐘依然冷酷地敲出兩聲「滴—答」。
  - D 段當人聲開始焦慮地加速重複「從故鄉到他鄉、從他鄉到故鄉」時，鋼琴與時鐘卻完全不跟著激動喧嘩，反而退回最安靜、最乖巧的拜厄阿爾貝堤分解和弦與四分音符滴答聲——人越是急促奔波，背景的時鐘與課本伴奏就越是冷靜如常。
*/

/* ========================================================================= */
/* INTRO (8 bars): 音樂教室裡的節拍器與老師的課本標準前奏                     */
/* ========================================================================= */

Intro:PianoRH@|0|{
    <8*>
    /* 前 4 小節：端正、乾淨的課本鐘擺前奏主題 */
    | {mf} 1 - 3 - 2 1 3 - | 2 - 3 - 5 - 3 - |
    | 1 - 3 - 2 1 3 2 | 2 - - - 7_ - - - |
    /* 後 4 小節：第 8 小節彈出音樂老師最標準的「預備——起！」下行導音過門 */
    | 1 - 3 - 2 1 3 - | 2 - 3 - 5 - 3 - |
    | 4 - 3 - 2 1 2 3 | 1 - - - 5_ 6_ 7_ 2 |
}

Intro:PianoLH@|0|{
    <8*>
    /* 拜厄 (Beyer) 式的標準阿爾貝堤分解和弦 (Alberti Bass: Do-Sol-Mi-Sol) */
    | {mp} 1_ 5_ 3_ 5_ 1_ 5_ 3_ 5_ | 7__ 5_ 2_ 5_ 7__ 5_ 2_ 5_ |
    | 6__ 3_ 1_ 3_ 4__ 1_ 6__ 1_ | 5__ 2_ 7__ 2_ 5__ 4_ 3_ 2_ |
    | 1_ 5_ 3_ 5_ 1_ 5_ 3_ 5_ | 7__ 5_ 2_ 5_ 7__ 5_ 2_ 5_ |
    | 4__ 1_ 6__ 1_ 5__ 2_ 7__ 2_ | 1_ 5_ 3_ 5_ 1_ - 0 - |
}

Intro:Woodblock[pitchMode=fixed]@|0|{
    <4*>
    /* 機械時鐘／木製節拍器：一高一低「滴—答—滴—答」穩定擺動 */
    | {mp} 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
    | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
}

/* ========================================================================= */
/* A1: 他總像是鐘擺一般過活 (拜厄式的阿爾貝堤低音，像節拍器一樣乖巧擺動)     */
/* ========================================================================= */

A1:Vocal@|0|{
    <4*>
    /* 他總像是鐘擺一般過活 */
    | 1 3 2 1 | 2 3 5 ( 0 7_)%(-) | 1 - - ( 0 7_)%(-) | 5_ - - - |
    /* 從這頭不斷擺蕩到那頭 */
    | 1 3 2 ( 1 5_)%(-) | 2 3 5 ( 0 7_)%(-) | 1 - - ( 0 1)%(-) | 7_ - - - |
    /* 有時一個人在這裡，有時一個人在那頭 */
    | 1 3 2 ( 1 5_)%(-) | 2 3 3 - | 1 3 2 ( 1 5_)%(-) | 1 2 1 - |
    /* 他總像是鐘擺一般過活 */
    | 1 3 2 1 | 2 3 5 ( 0 7_)%(-) | 1 - - ( 0 2)%(-) | 1 - - - |
}

A1:PianoRH@|0|{
    <8*>
    /* 陪著人聲輕彈正拍和弦，並在人聲長音處補上乖巧的課本回應音 */
    | {mp} [C] - - - [C] - - - | [G] - - - [G] - - - | [F] - 1 2 3 - 1 - | [G] - 2 1 7_ - 5_ - |
    | [C] - - - [C] - - - | [G] - - - [G] - - - | [F] - 1 2 3 - 1 - | [G] - 5 4 3 2 1 7_ |
    | [F] - - - [C] - - - | [G] - [C] - 3 4 5 3 | [F] - - - [C] - - - | [G] - [C] - 3 2 1 - |
    | [C] - - - [C] - - - | [G] - - - [G] - - - | [F] - 1 2 [G] - 7_ - | [C] - 3 2 1 - 0 - |
}

A1:PianoLH@|0|{
    <8*>
    /* 機械般精準、毫無情緒起伏的阿爾貝堤低音 (Do-Sol-Mi-Sol) */
    | {p} 1_ 5_ 3_ 5_ 1_ 5_ 3_ 5_ | 7__ 5_ 2_ 5_ 7__ 5_ 2_ 5_ | 4__ 1_ 6__ 1_ 4__ 1_ 6__ 1_ | 5__ 2_ 7__ 2_ 5__ 2_ 7__ 2_ |
    | 1_ 5_ 3_ 5_ 1_ 5_ 3_ 5_ | 7__ 5_ 2_ 5_ 7__ 5_ 2_ 5_ | 4__ 1_ 6__ 1_ 4__ 1_ 6__ 1_ | 5__ 2_ 7__ 2_ 5__ 4_ 3_ 2_ |
    | 4__ 1_ 6__ 1_ 1_ 5_ 3_ 5_ | 5__ 2_ 7__ 2_ 1_ 5_ 3_ 5_ | 4__ 1_ 6__ 1_ 1_ 5_ 3_ 5_ | 5__ 2_ 7__ 2_ 1_ 5_ 3_ 5_ |
    | 1_ 5_ 3_ 5_ 1_ 5_ 3_ 5_ | 7__ 5_ 2_ 5_ 7__ 5_ 2_ 5_ | 4__ 1_ 6__ 1_ 5__ 2_ 7__ 2_ | 1_ 5_ 3_ 5_ 1_ - 0 - |
}

A1:Woodblock[pitchMode=fixed]@|0|{
    <4*>
    | {p} 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
    | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
    | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
    | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
}

/* ========================================================================= */
/* A2: 從這頭到那頭 (課本經典「咚—嚓—咚—嚓」根五音與反拍和弦伴奏)            */
/* ========================================================================= */

A2:Vocal@|0|{
    <4*>
    /* 他總像是鐘擺一般過活 */
    | 1 3 2 1 | 2 3 5 ( 0 7_)%(-) | 1 - - ( 0 7_)%(-) | 5_ - - - |
    /* 從這頭不斷擺蕩到那頭 */
    | 1 3 2 ( 1 5_)%(-) | 2 3 5 ( 0 7_)%(-) | 1 - - ( 0 1)%(-) | 7_ - - - |
    /* 有時一個人在這裡，有時一個人在那頭 */
    | 1 3 2 ( 1 5_)%(-) | 2 3 3 - | 1 3 2 ( 1 5_)%(-) | 1 2 1 - |
    /* 他總像是鐘擺一般過活 一陣*/
    | 1 3 2 1 | 2 3 5 ( 0 7_)%(-) | 1 - - 2 | 1 - 3 1 |
}

A2:PianoRH@|0|{
    <8*>
    /* 音樂課本最常見的反拍三和弦「(咚) 嚓 (咚) 嚓」伴奏型 */
    | {mp} 0 [C] 0 [C] 0 [C] 0 [C] | 0 [G] 0 [G] 0 [G] 0 [G] | 0 [F] 0 [F] 0 [F] 0 [F] | 0 [G] 0 [G] 5 4 3 2 |
    | 0 [C] 0 [C] 0 [C] 0 [C] | 0 [G] 0 [G] 0 [G] 0 [G] | 0 [F] 0 [F] 0 [F] 0 [F] | 0 [G] 0 [G] 5 4 3 2 |
    | 0 [F] 0 [F] 0 [C] 0 [C] | 0 [G] 0 [C] 3 4 5 3 | 0 [F] 0 [F] 0 [C] 0 [C] | 0 [G] 0 [C] 3 2 1 - |
    | 0 [C] 0 [C] 0 [C] 0 [C] | 0 [G] 0 [G] 0 [G] 0 [G] | 0 [F] 0 [F] 0 [G] 0 [G] | [C] - 0 - [C] - 0 - |
}

A2:PianoLH@|0|{
    <4*>
    /* 穩如時鐘的「根音—五音」四分音符步伐 */
    | {mp} 1_ 5__ 1_ 5__ | 5__ 2_ 5__ 2_ | 4__ 1_ 4__ 1_ | 5__ 2_ 5__ 7__ |
    | 1_ 5__ 1_ 5__ | 5__ 2_ 5__ 2_ | 4__ 1_ 4__ 1_ | 5__ 2_ 5__ 7__ |
    | 4__ 1_ 1_ 5__ | 5__ 2_ 1_ 5__ | 4__ 1_ 1_ 5__ | 5__ 2_ 1_ 5__ |
    | 1_ 5__ 1_ 5__ | 5__ 2_ 5__ 2_ | 4__ 1_ 5__ 2_ | 1_ 5__ 1_ 0 |
}

A2:Woodblock[pitchMode=fixed]@|0|{
    <4*>
    | {mp} 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
    | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
    | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
    | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
}

/* ========================================================================= */
/* B1: 風 一股寒流 (課本抒情段落：標準八分音符琶音與乖巧的高音伴唱)          */
/* ========================================================================= */

B1:Vocal@|0|{
    <4*>
    /* 風 一股 寒流 都能夠沒有理由就將思緒牽 */
    | 5 - 3 1 | (5 2)%(-) 2 3 5 | 6 5 3 2 | 3 2 (3 2)%(-) 1 |
    /* 動 即使明知 他鄉的誘惑 也不能新奇 多久 一陣*/
    | 5 - 3 1 | (2 3 0 3 3 2)%(---) 1 | (6_ 1 0 3 3 2 1 1)%(----) | 1 5_ 3 1 |
}

B1:PianoRH@|0|{
    <4*>
    /* 像音樂老師右手幫忙彈出主旋律骨架與三度和聲，陪著學生一起唱 */
    | {mf} [C] - 3 1 | [Dm] 2 3 5 | [Am] 5 [G] 2 | [C] 2 3 1 |
    | [C] - 3 1 | [F] 3 2 1 | [Am] 1 [G] 2 | [C] 5_ 3 1 |
}

B1:PianoLH@|0|{
    <8*>
    /* 課本抒情段最標準的「1-5-1-3-5-3-1-5」八分音符琶音 */
    | {mp} 1_ 5_ 1 3 5 3 1 5_ | 2_ 6_ 2 4 6 4 2 6_ | 6__ 3_ 6_ 1 5__ 2_ 5_ 7_ | 1_ 5_ 1 3 5 3 1 5_ |
    | 1_ 5_ 1 3 5 3 1 5_ | 4__ 1_ 4_ 6_ 5__ 2_ 5_ 7_ | 6__ 3_ 6_ 1 5__ 2_ 5_ 7_ | 1_ 5_ 1 3 1 - 0 - |
}

B1:Woodblock[pitchMode=fixed]@|0|{
    <4*>
    | {p} 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
    | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
}

/* ========================================================================= */
/* B2: 回家的喜悅 也不能新奇多久 (第 8 小節全場休止，唯獨時鐘冷酷滴答)       */
/* ========================================================================= */

B2:Vocal@|0|{
    <4*>
    /* 風 一股 寒流 都能夠沒有理由就將思緒牽 */
    | 5 - 3 1 | (5 2)%(-) 2 3 5 | 6 5 3 2 | 3 2 (3 2)%(-) 1 |
    /* 動 即使明知 回家的喜悅 也不能新奇 多久*/
    | 5 - 3 1 | (2 3 0 3 3 2)%(---) 1 | (6_ 1 0 3 3 2 1 1)%(----) | 2 1 0 0 |
}

B2:PianoRH@|0|{
    <4*>
    | {mf} [C] - 3 1 | [Dm] 2 3 5 | [Am] 5 [G] 2 | [C] 2 3 1 |
    | [C] - 3 1 | [F] 3 2 1 | [Am] 1 [F] 2 | [G] [C] 0 0 |
}

B2:PianoLH@|0|{
    <8*>
    | {mp} 1_ 5_ 1 3 5 3 1 5_ | 2_ 6_ 2 4 6 4 2 6_ | 6__ 3_ 6_ 1 5__ 2_ 5_ 7_ | 1_ 5_ 1 3 5 3 1 5_ |
    | 1_ 5_ 1 3 5 3 1 5_ | 4__ 1_ 4_ 6_ 5__ 2_ 5_ 7_ | 6__ 3_ 6_ 1 4__ 1_ 4_ 6_ | 5__ - 1_ - 0 - 0 - |
}

B2:Woodblock[pitchMode=fixed]@|0|{
    <4*>
    /* 第 8 小節第 3、4 拍人聲與鋼琴雙手離鍵，一片死寂中只有時鐘清晰地敲出「滴—答」 */
    | {p} 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
    | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 {mf} 5 1 |
}

/* ========================================================================= */
/* C: 排比句 (在他鄉...在故鄉... 最端正朝氣的課本進行曲，對比最窒息的歌詞)   */
/* ========================================================================= */

C:Vocal@|0|{
    <4*>
    /* 在他鄉被別人排擠 在故鄉被自己人壓迫 */
    | 1 3 2 (1 5_)%(-) | 2 3 3 - | 1 3 2 (1 5_)%(-) | 1 2 1 - |
    /* 在他鄉總覺得委屈 在故鄉也一樣沒人懂 */
    | 1 3 2 (1 5_)%(-) | 2 3 3 - | 1 3 2 (1 5_)%(-) | 1 2 1 - |
    /* 在他鄉是一份孤寂 在故鄉是另一種難過 */
    | 1 3 2 (1 5_)%(-) | 2 3 3 - | 1 3 2 (1 5_)%(-) | 1 2 1 - |
    /* 在他鄉總想著回去 在故鄉卻更想逃走 */
    | 1 3 2 (1 5_)%(-) | 2 3 5 - | 1 3 2 (5 5_)%(-) | 4 3 1 - |
}

C:PianoRH@|0|{
    <8*>
    /* 像唱校歌一樣一拍一下的正拍大三和弦，句尾還不忘彈出乖巧的課本連接音 */
    | {mf} [C] - [C] - [G] - [C] - | [G] - [C] - 3 4 5 3 | [F] - [F] - [C] - [C] - | [G] - [C] - 1 2 3 1 |
    | [C] - [C] - [G] - [C] - | [G] - [C] - 3 4 5 3 | [F] - [F] - [C] - [C] - | [G] - [C] - 1 2 3 1 |
    | [C] - [C] - [G] - [C] - | [G] - [C] - 3 4 5 3 | [F] - [F] - [C] - [C] - | [G] - [C] - 1 2 3 1 |
    | [C] - [C] - [G] - [C] - | [G] - [G] - 5 6 5 4 | [F] - [F] - [G] - [G] - | [F] - [G] - [C] - 5_ - |
}

C:PianoLH@|0|{
    <4*>
    /* 毫不遲疑、一板一眼的四分音符進行曲低音 */
    | {mf} 1_ 5__ 1_ 5__ | 5__ 2_ 1_ 5__ | 4__ 1_ 1_ 5__ | 5__ 2_ 1_ 5__ |
    | 1_ 5__ 1_ 5__ | 5__ 2_ 1_ 5__ | 4__ 1_ 1_ 5__ | 5__ 2_ 1_ 5__ |
    | 1_ 5__ 1_ 5__ | 5__ 2_ 1_ 5__ | 4__ 1_ 1_ 5__ | 5__ 2_ 1_ 5__ |
    | 1_ 5__ 1_ 5__ | 5__ 2_ 5__ 7__ | 4__ 1_ 5__ 2_ | 4__ 5__ 1_ 5__ |
}

C:Woodblock[pitchMode=fixed]@|0|{
    <4*>
    /* 始終維持不疾不徐的四分音符滴答聲 */
    | {p} 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
    | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
    | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
    | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
}

/* ========================================================================= */
/* D: 從故鄉到他鄉... (人聲急促擺盪，鋼琴與時鐘卻退回最安靜冷靜的課本分解)    */
/* ========================================================================= */

D:Vocal@|0|{
    <8*>
    /* 從故鄉到他鄉 從他鄉到故鄉 從故鄉到他鄉 繼續擺動 */
    | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 2 7_ 5_ |
    /* 從他鄉到故鄉 從故鄉到他鄉 從他鄉到故鄉 繼續擺動 */
    | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 2 7_ 1 |
    /* 從故鄉到他鄉 從他鄉到故鄉 從故鄉到他鄉 繼續擺動 */
    | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 2 7_ 5_ |
    /* 從他鄉到故鄉 從故鄉到他鄉 從他鄉到故鄉 繼續擺 */
    | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 1 5 2 | 1 - 3 2 - 1 5 2 | 1 - 3 2 - 2 7_ - |
}

D:PianoRH@|0|{
    <4*>
    /* 不喧嘩、不搶戲，只用最輕柔端正的二分／全音符長和弦襯托人聲的來回奔波 */
    | {mp} [C] - - - | [G] - - - | [F] - - - | [Dm] - [G] - |
    | [C] - - - | [G] - - - | [F] - - - | [G] - [C] - |
    | [C] - - - | [G] - - - | [F] - - - | [Dm] - [G] - |
    | [C] - - - | [F] - [G] - | [F] - [G] - | [Dm] - [G7] - |
}

D:PianoLH@|0|{
    <8*>
    /* 回到 A1 最安靜、最規律的拜厄阿爾貝堤低音 (Do-Sol-Mi-Sol)，像永遠不會累的鐘擺 */
    | {p} 1_ 5_ 3_ 5_ 1_ 5_ 3_ 5_ | 7__ 5_ 2_ 5_ 7__ 5_ 2_ 5_ | 4__ 1_ 6__ 1_ 4__ 1_ 6__ 1_ | 2__ 6__ 4_ 6__ 5__ 2_ 7__ 2_ |
    | 1_ 5_ 3_ 5_ 1_ 5_ 3_ 5_ | 7__ 5_ 2_ 5_ 7__ 5_ 2_ 5_ | 4__ 1_ 6__ 1_ 4__ 1_ 6__ 1_ | 5__ 2_ 7__ 2_ 1_ 5_ 3_ 5_ |
    | 1_ 5_ 3_ 5_ 1_ 5_ 3_ 5_ | 7__ 5_ 2_ 5_ 7__ 5_ 2_ 5_ | 4__ 1_ 6__ 1_ 4__ 1_ 6__ 1_ | 2__ 6__ 4_ 6__ 5__ 2_ 7__ 2_ |
    | 1_ 5_ 3_ 5_ 1_ 5_ 3_ 5_ | 4__ 1_ 6__ 1_ 5__ 2_ 7__ 2_ | 4__ 1_ 6__ 1_ 5__ 2_ 7__ 2_ | 2__ 6__ 4_ 6__ 5__ 2_ 5__ - |
}

D:Woodblock[pitchMode=fixed]@|0|{
    <4*>
    /* 就算人聲再怎麼急促，時鐘依然面無表情地維持四分音符「滴—答—滴—答」 */
    | {p} 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
    | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
    | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
    | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 0 |
}

/* ========================================================================= */
/* END: 動 (鋼琴課本終止式結束後，時鐘還孤單地多響了兩聲才停在虛空)          */
/* ========================================================================= */

End:Vocal@|0|{
    <1*>
    /* 動 */
    | 1 |
}

End:PianoRH@|0|{
    <8*>
    /* 在「動」落下後，乖巧地把前奏課本主題再彈一次，最後敲下標準的 V7 - I 課本收尾 */
    | {mf} 1 - 3 - 2 1 3 - | 2 - 3 - 5 - 3 - |
    | 1 - 3 - 2 1 3 2 | {mp} 2 - - - 7_ - - - |
    | 1 - 3 - 2 1 3 - | 2 - 3 - 5 - 3 - |
    | {p} 4 - 3 - 2 1 2 3 | 2 - - - 7_ - - - |
    | [C] - 0 - 0 - 0 - |
}

End:PianoLH@|0|{
    <8*>
    /* 鐘擺又若無其事地繼續用阿爾貝堤低音擺動，直到最後一個 C 和弦 */
    | {mp} 1_ 5_ 3_ 5_ 1_ 5_ 3_ 5_ | 7__ 5_ 2_ 5_ 7__ 5_ 2_ 5_ |
    | 6__ 3_ 1_ 3_ 4__ 1_ 6__ 1_ | 5__ 2_ 7__ 2_ 5__ 4_ 3_ 2_ |
    | {p} 1_ 5_ 3_ 5_ 1_ 5_ 3_ 5_ | 7__ 5_ 2_ 5_ 7__ 5_ 2_ 5_ |
    | 4__ 1_ 6__ 1_ 4__ 1_ 6__ 1_ | 5__ 2_ 7__ 2_ 5__ - - - |
    | 1_ - 0 - 0 - 0 - |
}

End:Woodblock[pitchMode=fixed]@|0|{
    <4*>
    /* 鋼琴在第 9 小節第 1 拍收尾後，時鐘在寂靜中孤單地多敲了兩聲「答…滴…」，最終靜止 */
    | {p} 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
    | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 | 5 1 5 1 |
    | 5 1 {pp} 5 0 |
}

/* 完整播放順序 */
-> Intro -> A1 -> A2 -> B1 -> B2 -> C -> D -> End ->#

