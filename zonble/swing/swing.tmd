::SCORE::
** 鐘擺 **
!= 100
?= C
~ "composer: zonble"
~ "note: 原曲寫於 2011 年"
<4/4>

/* ========================================================================= */
/* A1: 他總像是鐘擺一般過活 (純吉他指彈伴奏，最純粹的民謠質感)               */
/* ========================================================================= */

A1:Vocal@|0|{
    <4*>
    /* 他總像是鐘擺一般過活 */
    | 1 3 2 1 | 2 3 5 ( 0 7_)%(-) | 1 - - ( 0 7_)%(-) | 5_ - - - |
    /* 從這頭不斷擺蕩到那頭 */
    | 1 3 2 ( 1 5_)%(-) | 2 3 5 ( 0 7_)%(-) | 1 - - ( 0 1)%(-) | 7_ - - - |
    /* 有時一個人在這裡，有時一個人在那頭 */
    | 1 3 2 ( 1 5_)%(-) | 2 3 3 - | 1 3 2 ( 1 5_)%(-) | 1 2 1 - |
    /* 他總像是鐘擺一般過活 */
    | 1 3 2 1 | 2 3 5 ( 0 7_)%(-) | 1 - - ( 0 2)%(-) | 1 - - - |
}

/* ========================================================================= */
/* A2: 從這頭到那頭 (木貝斯加入，鐘擺步伐感加重)                             */
/* ========================================================================= */

A2:Vocal@|0|{
    <4*>
    /* 他總像是鐘擺一般過活 */
    | 1 3 2 1 | 2 3 5 ( 0 7_)%(-) | 1 - - ( 0 7_)%(-) | 5_ - - - |
    /* 從這頭不斷擺蕩到那頭 */
    | 1 3 2 ( 1 5_)%(-) | 2 3 5 ( 0 7_)%(-) | 1 - - ( 0 1)%(-) | 7_ - - - |
    /* 有時一個人在這裡，有時一個人在那頭 */
    | 1 3 2 ( 1 5_)%(-) | 2 3 3 - | 1 3 2 ( 1 5_)%(-) | 1 2 1 - |
    /* 他總像是鐘擺一般過活 一陣*/
    | 1 3 2 1 | 2 3 5 ( 0 7_)%(-) | 1 - - 2 | 1 - 3 1 |
}

/* ========================================================================= */
/* B1: 風 一股寒流 (大提琴悠遠長音，民謠敘事推進)                            */
/* ========================================================================= */

B1:Vocal@|0|{
    <4*>
    /* 風 一股 寒流 都能夠沒有理由就將思緒牽 */
    | 5 - 3 1 | (5 2)%(-) 2 3 5 | 6 5 3 2 | 3 2 (3 2)%(-) 1 |
    /* 動 即使明知 他鄉的誘惑 也不能新奇 多久 一陣*/
    | 5 - 3 1 | (2 3 0 3 3 2)%(---) 1 | (6_ 1 0 3 3 2 1 1)%(----) | 1 5_ 3 1 |
}

/* ========================================================================= */
/* B2: 回家的喜悅 也不能新奇多久 (冰冷沉重，粉碎幻覺)                         */
/* ========================================================================= */

B2:Vocal@|0|{
    <4*>
    /* 風 一股 寒流 都能夠沒有理由就將思緒牽 */
    | 5 - 3 1 | (5 2)%(-) 2 3 5 | 6 5 3 2 | 3 2 (3 2)%(-) 1 |
    /* 動 即使明知 回家的喜悅 也不能新奇 多久*/
    | 5 - 3 1 | (2 3 0 3 3 2)%(---) 1 | (6_ 1 0 3 3 2 1 1)%(----) | 2 1 0 0 |
}

/* ========================================================================= */
/* C: 排比句 (在他鄉...在故鄉... 吉他重音切分，張力緊繃)                      */
/* ========================================================================= */

C:Vocal@|0|{
    <4*>
    /* 在他鄉被別人排擠 在故鄉被自己人壓迫 */
    | 1 3 2 (1 5_)%(-) | 2 3 3 - | 1 3 2 (1 5_)%(-) | 1 2 1 - |
    /* 在他鄉總覺得委屈 在故鄉也一樣沒人懂 */
    | 1 3 2 (1 5_)%(-) | 2 3 3 - | 1 3 2 (1 5_)%(-) | 1 2 1 - |
    /* 在他鄉是一份孤寂 在故鄉是另一種難過 */
    | 1 3 2 (1 5_)%(-) | 2 3 3 - | 1 3 2 (1 5_)%(-) | 1 2 1 - |
    /* 在他鄉總想著回去 在故鄉卻更想逃走 */
    | 1 3 2 (1 5_)%(-) | 2 3 5 - | 1 3 2 (5 5_)%(-) | 4 3 1 - |
}

/* ========================================================================= */
/* D: 從故鄉到他鄉... (全八分音符激昂掃弦，火車般奔馳失控)                  */
/* ========================================================================= */

D:Vocal@|0|{
    <8*>
    /* 從故鄉到他鄉 從他鄉到故鄉 從故鄉到他鄉 繼續擺動 */
    | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 2 7_ 5_ |
    /* 從他鄉到故鄉 從故鄉到他鄉 從他鄉到故鄉 繼續擺動 */
    | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 2 7_ 1 |
    /* 從故鄉到他鄉 從他鄉到故鄉 從故鄉到他鄉 繼續擺動 */
    | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 2 7_ 5_ |
    /* 從他鄉到故鄉 從故鄉到他鄉 從他鄉到故鄉 繼續擺 */
    | 1 - 3 2 - 1 3 2 | 1 - 3 2 - 1 5 2 | 1 - 3 2 - 1 5 2 | 1 - 3 2 - 2 7_ - |
}

/* ========================================================================= */
/* END: 動 (戛然而止，鐘擺最終靜止在虛空)                                    */
/* ========================================================================= */

End:Vocal@|0|{
    <1*>
    /* 動 */
    | 1 |
}

/* 完整播放順序 */
-> A1 -> A2 -> B1 -> B2 -> C -> D -> End ->#

