::SCORE::
** 勇者傳說：主人公主題六大場景變奏曲 (Hero's Journey Variations) **
!= 100
?= C
Key= C
<4/4>

/* =========================================================================
   原案核心主題（出自 motif.tmd）：
   | 1- 1 5_ 1 5_ 1 2_ | 3 - 1 - 5 --- |
   | 2- 2 1_ 2 1_ 6_ 2_ | 3 2 1 2 3 --- |
   | 1- 1 5_ 1 5_ 1 2_ | 3 - 1 - 3 - 5 - |
   | 2 3 2 1 3 --- | 3 2 1 2 3 --- |

   本篇為 RPG 遊戲流程完整主導動機變奏（Leitmotif Transformations）：
   1. 新手村 (Village) - 悠閒牧歌、長笛與木吉他
   2. 第一場戰鬥 (Battle) - 青春熱血、切分節奏與搖滾鼓點
   3. 旅館休息 (Inn) - 溫馨安詳、八音盒鋼片琴催眠曲
   4. 進入魔王城 (Castle) - 轉 C 小調、哥德陰森管風琴與沉重定音鼓
   5. 打魔王 (Boss) - 狂暴極速、金屬交響戰鬥與高張力銅管
   6. 最終勝利 (Victory) - 壯麗凱旋、大調交響 Tutti 齊奏讚歌
   ========================================================================= */

/* -------------------------------------------------------------------------
   1. 新手村 (Village) - 陽光草原、微風木屋
   ------------------------------------------------------------------------- */
Village:Flute@|0|{
    <8*>
    {!= 100}
    /* 主旋律：長笛溫柔吹拂 */
    1 - 1 5_ 1 5_ 1 2_ | 3 - 1 - 5 - - - |
    2 - 2 1_ 2 1_ 6_ 2_ | 3 2 1 2 3 - - - |
    1 - 1 5_ 1 5_ 1 2_ | 3 - 1 - 3 - 5 - |
    2 3 2 1 3 - 2 - | 1 - - - 0 0 0 0 |
}

Village:AcousticGuitar@|0|{
    <8*>
    /* 木吉他分解和弦伴奏 */
    1_ 5_ 1 3 5_ 1 3 5_ | 1_ 5_ 1 3 5_ 1 3 5_ |
    4_ 6_ 1 4 6_ 1 4 6_ | 5__ 7_ 2 5 7_ 2 5 7_ |
    1_ 5_ 1 3 5_ 1 3 5_ | 6__ 3_ 6_ 1 3_ 6_ 1 3_ |
    4_ 6_ 1 4 5__ 7_ 2 5 | 1_ 5_ 1 3 1_ - - - |
}

Village:Bass@|0|{
    <8*>
    /* 輕快撥弦低音 */
    1_ - - - 5__ - - - | 1_ - - - 5__ - - - |
    4_ - - - 2_ - - - | 5__ - - - 5_ - - - |
    1_ - - - 5__ - - - | 6__ - - - 3_ - - - |
    4_ - - - 5__ - - - | 1_ - - - - - - - |
}

Village:CHORD@|0|{
    <1*>
    [C] | [C] | [F] | [G] |
    [C] | [Am] |
    <2*>
    [F] [G] | [C] - |
}

/* -------------------------------------------------------------------------
   2. 第一場戰鬥 (Battle) - 勇者拔劍、遭遇野怪
   ------------------------------------------------------------------------- */
Battle:Trumpet@|0|{
    <8*>
    {!= 138}
    /* 小號主奏：戰鬥切分化動機 */
    1 0 1 5_ 1 5_ 1 2_ | 3 - 1 0 5 - 0 0 |
    2 0 2 1_ 2 1_ 6_ 2_ | 3 2 1 2 3 - 5 0 |
    1 0 1 5_ 1 5_ 1 2_ | 3 - 1 0 3 - 5 0 |
    2 3 2 1 3 0 2 0 | 1 - 0 1 1 - 0 0 |
}

Battle:ElectricGuitar@|0|{
    <8*>
    /* 電吉他切音節奏 */
    1_ 1_ 0 1_ 1_ 1_ 0 1_ | 1_ 1_ 0 1_ 5__ 5__ 0 5__ |
    4_ 4_ 0 4_ 4_ 4_ 0 4_ | 5_ 5_ 0 5_ 5_ 5_ 0 5_ |
    1_ 1_ 0 1_ 1_ 1_ 0 1_ | 6__ 6__ 0 6__ 6__ 6__ 0 6__ |
    4_ 4_ 0 4_ 5_ 5_ 0 5_ | 1_ - 0 1_ 1_ - 0 0 |
}

Battle:Bass@|0|{
    <8*>
    /* 奔跑式八分音符 Bassline */
    1_ 1_ 1_ 1_ 1_ 1_ 1_ 1_ | 1_ 1_ 1_ 1_ 5__ 5__ 5__ 5__ |
    4_ 4_ 4_ 4_ 4_ 4_ 4_ 4_ | 5__ 5__ 5__ 5__ 5__ 5__ 5__ 5__ |
    1_ 1_ 1_ 1_ 1_ 1_ 1_ 1_ | 6__ 6__ 6__ 6__ 6__ 6__ 6__ 6__ |
    4_ 4_ 4_ 4_ 5__ 5__ 5__ 5__ | 1_ 1_ 1_ 1_ 1_ - 0 0 |
}

Battle:Drums@|0|{
    <8*>
    /* 熱血戰鬥鼓點 */
    C X S X B B S X | B X S X B B S X |
    B X S X B B S X | B X S X B S S S |
    C X S X B B S X | B X S X B B S X |
    B X S X B S B S | C - 0 0 C - 0 0 |
}

/* -------------------------------------------------------------------------
   3. 旅館休息 (Inn) - 恢復元氣、安詳夢鄉
   ------------------------------------------------------------------------- */
Inn:Celesta@|0|{
    <8*>
    {!= 72}
    /* 鋼片琴/八音盒晶瑩動機 */
    1^ - - - 5 - 1^ - | 3^ - 1^ - 5^ - - - |
    2^ - 1^ - 2^ - 3^ - | 1^ - - - - - - - |
}

Inn:Harp@|0|{
    <8*>
    /* 豎琴水波琶音 */
    1_ 5_ 1 3 5 3 1 5_ | 1_ 5_ 1 3 5 3 1 5_ |
    4_ 1 4 6 5_ 2 5 7 | 1_ 5_ 1 3 1^ - - - |
}

Inn:Strings@|0|{
    <8*>
    /* 柔和弦樂襯底 */
    1_ - - - - - - - | 3_ - - - - - - - |
    4_ - - - 5_ - - - | 1_ - - - - - - - |
}

/* -------------------------------------------------------------------------
   4. 進入魔王城 (Castle) - 陰暗哥德、小調威壓
   ------------------------------------------------------------------------- */
Castle:PipeOrgan@|0|{
    <8*>
    {!= 80}
    /* 管風琴：C 小調陰暗變奏 (3, 降三音, 6, 降六音) */
    1 - 1 5_ 1 5_ 1 2_ | 3, - 1 - 5 - - - |
    2 - 2 1_ 2 1_ 6,_ 2_ | 3, 2 1 2 3, - - - |
    1 - 1 5_ 1 5_ 1 2_ | 3, - 1 - 3, - 5 - |
    2 3, 2 1 3, - 2 - | 1 - - - 0 0 0 0 |
}

Castle:Strings@|0|{
    <8*>
    /* 低音大提琴懸疑沉音 */
    1_ - - - - - - - | 6,__ - - - - - - - |
    4_ - - - - - - - | 5__ - - - - - - - |
    1_ - - - - - - - | 6,__ - - - - - - - |
    4_ - - - 5__ - - - | 1_ - - - - - - - |
}

Castle:Timpani[pitchMode=fixed]@|0|{
    <8*>
    /* 沉重恐懼鼓擊 */
    1_ - 0 0 1_ - 0 0 | 5__ - - - - - - - |
    1_ - 0 0 1_ - 0 0 | 5__ - - - 5__ - - - |
    1_ - 0 0 1_ - 0 0 | 1_ - 0 0 1_ - 0 0 |
    4__ - - - 5__ - - - | 1_ - - - 0 0 0 0 |
}

Castle:CHORD@|0|{
    <1*>
    [Cm] | [Cm] | [Fm] | [G] |
    [Cm] | [Ab] |
    <2*>
    [Fm] [G] | [Cm] - |
}

/* -------------------------------------------------------------------------
   5. 打魔王 (Boss) - 命運決戰、金屬交響狂潮
   ------------------------------------------------------------------------- */
Boss:Brass@|0|{
    <8*>
    {!= 156}
    /* 狂暴銅管：極速小調切分戰鬥號角 */
    1 0 1 5_ 1 5_ 1 2_ | 3, 0 1 0 5 - 0 0 |
    2 0 2 1_ 2 1_ 6,_ 2_ | 3, 2 1 2 3, 0 5 0 |
    1 0 1 5_ 1 5_ 1 2_ | 3, 0 1 0 3, 0 5 0 |
    2 3, 2 1 3, 3, 2 2 | 1 - 0 1 1 - 0 0 |
}

Boss:Strings@|0|{
    <8*>
    /* 高速連續跳音 Ostinato */
    1 5_ 1 5_ 1 5_ 1 5_ | 3, 1 3, 1 3, 1 3, 1 |
    2 6,_ 2 6,_ 2 6,_ 2 6,_ | 5 2 5 2 5 2 5 2 |
    1 5_ 1 5_ 1 5_ 1 5_ | 3, 1 3, 1 3, 1 3, 1 |
    4 1 4 1 5 2 5 2 | 1 - 0 1 1 - 0 0 |
}

Boss:DistortionGuitar@|0|{
    <8*>
    /* 重金屬失真重音轟鳴 */
    1_ 1_ 1_ 1_ 1_ 1_ 1_ 1_ | 1_ 1_ 1_ 1_ 5__ 5__ 5__ 5__ |
    4_ 4_ 4_ 4_ 4_ 4_ 4_ 4_ | 5__ 5__ 5__ 5__ 5__ 5__ 5__ 5__ |
    1_ 1_ 1_ 1_ 1_ 1_ 1_ 1_ | 6,__ 6,__ 6,__ 6,__ 6,__ 6,__ 6,__ 6,__ |
    4_ 4_ 4_ 4_ 5__ 5__ 5__ 5__ | 1_ - 0 1_ 1_ - 0 0 |
}

Boss:Drums@|0|{
    <8*>
    /* 雙踏極速狂暴節奏 */
    C X S X B B S X | B X S X B B S X |
    B X S X B B S X | B S B S B S S S |
    C X S X B B S X | B X S X B B S X |
    B S B S B B S S | C - 0 0 C - 0 0 |
}

/* -------------------------------------------------------------------------
   6. 最終勝利 (Victory) - 晨曦破曉、大調凱旋榮耀
   ------------------------------------------------------------------------- */
Victory:Trumpet@|0|{
    <8*>
    {!= 116}
    /* 凱旋小號：英雄讚歌昇華再現 */
    1 - 1 5_ 1 5_ 1 2_ | 3 - 1 - 5 - - - |
    2 - 2 1_ 2 1_ 6_ 2_ | 3 2 1 2 3 - - - |
    1 - 1 5_ 1 5_ 1 2_ | 3 - 1 - 3 - 5 - |
    6 - 5 - 3 - 2 - | 1 - - - - - - - |
}

Victory:Brass@|0|{
    <8*>
    /* 法國號與長號厚重對位 */
    1_ - - - 5__ - - - | 1_ - 3_ - 5_ - - - |
    2_ - - - 5__ - - - | 1_ - 2_ - 3_ - - - |
    1_ - - - 5__ - - - | 1_ - 3_ - 5_ - - - |
    4_ - 5__ - 5_ - - - | 1_ - - - - - - - |
}

Victory:Strings@|0|{
    <8*>
    /* 澎湃齊奏琶音 */
    1 5 1^ 3^ 1^ 5 3 5_ | 1 5 1^ 3^ 1^ 5 3 5_ |
    2 6 2^ 4^ 2^ 6 4 6_ | 3 5 1^ 3^ 1^ 5 3 5_ |
    1 5 1^ 3^ 1^ 5 3 5_ | 1 5 1^ 3^ 1^ 5 3 5_ |
    4 6 1^ 4^ 5 7 2^ 5^ | 1^ - - - - - - - |
}

Victory:Timpani[pitchMode=fixed]@|0|{
    <8*>
    /* 慶典定音鼓重擊 */
    1_ - - - 5__ - - - | 1_ - - - 5__ - - - |
    2__ - - - 5__ - - - | 1_ - - - 5__ - - - |
    1_ - - - 5__ - - - | 1_ - - - 5__ - - - |
    4__ - - - 5__ - - - | 1_ - - - - - - - |
}

Victory:Drums@|0|{
    <8*>
    /* 軍樂小鼓滾奏與大鈸齊鳴 */
    C - - - 0 0 0 0 | 0 0 0 0 S S S S |
    C - - - 0 0 0 0 | 0 0 0 0 S S S S |
    C - - - 0 0 0 0 | 0 0 0 0 S S S S |
    S S S S S S S S | C - - - - - - - |
}

Victory:CHORD@|0|{
    <1*>
    [C] | [C] | [Dm] | [C] |
    [C] | [C] |
    <2*>
    [F] [G] | [C] - |
}

/* =========================================================================
   總演奏流程（連續播放整場冒險史詩）
   ========================================================================= */
-> Village -> Battle -> Inn -> Castle -> Boss -> Victory ->#

