    | [5] - [5] [5] - [5] [5] [5] | [6m] - [6m] [6m] - [6m] [6m] [6m] |
    | [4] - [4] [4] - [4] [4] [4] | [1] - [1] [2m] - [3m] [5] - |
    | [5] - [5] [5] - [5] [5] [5] | [1] - [1] [1] - [1] [1] [1] |
}

B2:Banjo@|0|{
