    | B-x- S-s- B-x- S-s- | B-x- S-s- B-s- S-S- |
    | B-x- S-s- B-x- S-s- | B-x- S-s- B-x- S-S- |
    | B-x- S-x- B-x- S-x- | B-x- S-s- S-S- T-S- |
}

/* ========================================================================= */
/* B2 (8 bars): 第二圈纏繞 (口琴與小提琴加入長弓對位，火車鼓點加速催逼)      */
