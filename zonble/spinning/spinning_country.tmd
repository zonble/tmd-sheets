    | B-x- S-x- B-x- S-S- | B-x- S-s- S-S- T-S- |
}

/* ========================================================================= */
/* B3 (8 bars): 第三圈繃緊 — 第 8 小節全團急停，獨留三拍超明顯鼓大過門進副歌！*/
/* ========================================================================= */

B3:Vocal@|0|{
    <8*>
    /* 纏繞我的心 纏*/
    | 4 -- 1 1 4 - - | 3 - - - - - 1 - |
    /* 繞我一圈一遍再一週*/
    | 5 - - 5 5 5 5 5 | 5 4 -- 3 --- |
    /* 纏繞我的 全身上下*/
    | 4 -- 1 1 2 - - | 1 - 2 - 3 - 5 - |
    /* 前後跟左右 */
    | 5 - 6 - 5 - - 6 | 3 - - - - - - - |
}

B3:Guitar@|0|{
    <8*>
    /* 第 8 小節第 1 拍敲下 [1] 後全體急停三拍 (Stop-Time)，讓鼓組獨奏大過門完全跳出來！ */
    | {f} [4] - [4] [4] - [4] [4] [4] | [1] - [1] [1] - [1] [1] [1] |
    | [5] - [5] [5] [5] [5] [5] [5] | [6m] - [6m] [6m] - [6m] [6m] [6m] |
    | [4] - [4] [4] - [4] [4] [4] | [1] - [1] [2m] - [3m] [5] - |
    | [5] - [5] [5] [5] - [5] [5] | [1] - 0 - 0 - 0 - |
}

B3:Banjo@|0|{
