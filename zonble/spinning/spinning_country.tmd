    | {f} 4__ - 1_ - 4__ - 1_ - | 1_ - 5__ - 1_ - 5__ - |
    | 5__ - 5__ 5__ 5__ 5__ 5__ 5__ | 6__ - 3_ - 6__ - 3_ - |
    | 4__ - 1_ - 4__ - 1_ - | 1_ - 2_ - 3_ - 5_ - |
    | 5__ - 6__ - 5__ - 5__ - | 1_ - 0 - 0 - 0 - |
}

B3:Drums@|0|{
    <16*>
    /* 第 8 小節：吉他、斑鳩、小提琴、貝斯全部煞車停在第 1 拍，鼓組獨奏三拍超明顯的小鼓＋桶鼓大過門 (Solo Drum Fill) 炸進副歌！ */
    | {f} B-x- S-s- B-S- B-S- | B-x- S-s- B-s- S-S- |
    | B-S- B-S- B-S- B-S- | B-x- S-s- S-s- T-S- |
    | B-x- S-s- B-S- B-S- | B-S- B-S- B-S- S-S- |
    | B-S- T-S- B-S- B-S- | {ff} B--- S-S- T-T- S-S- |
}

/* ========================================================================= */
/* C1 (8 bars): 然後我會 開始與你一起 旋轉個不休 (鄉村大副歌 Hoedown 全開！)  */
/* ========================================================================= */

C1:Vocal@|0|{
    <8*>
