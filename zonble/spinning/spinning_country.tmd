    | {f} 4_ 1 4 6 1^ 6 4 1 | 1 3 5 1^ 5 3 1 5_ |
    | 5 5 2 5 7 5 2 5 | 6_ 1 3 6 1^ 6 3 1 |
    | 4_ 1 4 6 1^ 6 4 1 | 1 2 3 5 6 5 3 5 |
    | 5 2 5 6 5 2 5 6 | 1^ - 0 - 0 - 0 - |
}

B3:Fiddle@|0|{
    <8*>
    | {f} 6 - - 4 6 - - - | 5 6 7 1^ 7 6 5 3 |
    | 7 - - 7 7 7 7 7 | 7 6 - - 5 - 3 - |
    | 6 - - 4 6 - - - | 3 - 4 - 5 - 1^ - |
    | 7 - 1^ - 7 - - 1^ | 1^ - 0 - 0 - 0 - |
}

B3:Harmonica@|0|{
