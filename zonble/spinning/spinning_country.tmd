    | {f} 4 - - 4 6 - - - | 5 - - - 3 - - - |
    | 5 - - 5 5 5 5 5 | 6 - - - 3 - - - |
    | 4 - - 4 6 - - - | 3 - 4 - 5 - 5 - |
    | 5 - 6 - 5 - - 6 | 5 - 0 - 0 - 0 - |
}

B3:AcousticBass@|0|{
