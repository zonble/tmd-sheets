::SCORE::
** 陀螺 **
!= 120
?= C
~ "composer: zonble"
<4/4>

A:Vocal@|-1|{
    <8*>
    /* 請用 */
    | 0 0 0 0 0 0 1 7_ |
    /* 你的手 輕輕*/
    | 4_ 1 - 1 - - 2 1 |
    /* 扶正我 我不*/
    | 2 3 - 1 - - 2 1 |
    /* 能支撐 我自*/
    | 5_ 1 - 2 - - 1 7_ |
    /* 己的重 我不*/
    | 6_ 1 - 3 - - 1 7_ |
    /* 能行走 我動*/
    | 4_ 1 - 1 - - 2 1 |
    /* 也不能動 你知道*/
    | 2 3 - 1 - - 1 (1 1)%(-) |
    /*  我是一隻歪頭 */
    | 2 1 2 1 2 1 2 4 |
    /* 晃腦的陀螺 */
    | 3 1 - 1 - - 0 0 |
}

A1:Vocal@|-1|{
    <8*>
    /* 請用 */
    | 0 0 0 0 0 0 1 7_ |
    /* 你的手 輕輕*/
    | 4_ 1 - 1 - - 2 1 |
    /* 扶正我 我不*/
    | 1 6_ - 5_ - - 1 1 |
    /* 能支撐 我自*/
    | 7_ 6_ - 7_ - - 7_ 7_ |
    /* 己的重 我不*/
    | 1 7_ - 6_ - - 1 7_ |
    /* 能行走 我動*/
    | 4_ 1 - 1 - - 2 1 |
    /* 我動也不能動 */
    | 2 3 - 1 - - 1 (1 1)%(-) |
    /* 你知道 我是一隻歪頭 */
    | 5 3 3 3 3 2 3 4 |
    /* 晃腦的陀螺 */
    | 3 1 - 1 - - - - |
}

B1:Vocal@|0|{
    <8 *>
    /* 纏繞我的心 纏*/
    | 4 -- 1 1 2 - - | 3 - - - - - 1 - |
    /* 繞我一圈一遍再一週*/
    | 5_ - - 5_ 2 1 2 1 | 1 2 -- 3 --- |
    /* 纏繞我的 全身上下*/
    | 4 -- 1 1 2 - - | 1 - 2 - 3 - 5 - |
    /* 前後跟左右 */
    | 5 - 5 - 5 - 4 - | 3 - - - - - - - |
}

B2:Vocal@|0|{
    <8 *>
    /* 纏繞我的心 纏*/
    | 4 -- 1 1 2 - - | 3 - - - - - 1 - |
    /* 繞我一圈一遍再一週*/
    | 5 - - 2 2 1 2 1 | 3 4 -- 3 --- |
    /* 纏繞我的 全身上下*/
    | 4 -- 1 1 2 - - | 1 - 2 - 3 - 5 - |
    /* 前後跟左右 */
    | 5 - 6 - 5 - - 6 | 3 - - - - - - - |
}

B3:Vocal@|0|{
    <8 *>
    /* 纏繞我的心 纏*/
    | 4 -- 1 1 4 - - | 3 - - - - - 1 - |
    /* 繞我一圈一遍再一週*/
    | 5 - - 5 5 5 5 5 | 5 4 -- 3 --- |
    /* 纏繞我的 全身上下*/
    | 4 -- 1 1 2 - - | 1 - 2 - 3 - 5 - |
    /* 前後跟左右 */
    | 5 - 6 - 5 - - 6 | 3 - - - - - - - |
}

C1:Vocal@|0|{
    <8*>
    /* 然後我會 開始與你一起*/
    /* 然後我會 繼續與你一起*/
    | 4 - 4 - 5 - 6 - | 5 - 5 - 5 3 3 1 |
    /* 旋轉個不休 直*/
    | 5 - 5 - 3 - 5 - | 5 - - - - - 5 - |
    /* 到我們都 累了 都*/
    | 4 - 4 - 5 - 6 - | 5 - - - 1 - 5 - |
    /* 倦了 再也 不能做些什麼 */
    | 5 - - - 7_ - 5_ 5_ | 5 - 5 5 3 2 1 - |
}

C2:Vocal@|0|{
    <8*>
    /* 但是我從 心底詛咒*/
    /* 但是我絕 不會看到*/
    | 4 - 4 - 5 - 6 - | 5 - 5 - 5 - 3 - |
    /* 那一個時候 因*/
    | 5 - 5 - 3 - 5 - | 5 - - - - - 5 - |
    /* 為我想要 一直 和你一起*/
    /* 為我一定 永遠 和你一起*/
    | 4 - 4 - 5 - 6 - | 5 - 5 - 5 3 3 1 |
    /* 旋轉個不休 */
    | 5 - 5 - 5 - 4 - | 3 - - - - - - - |
}

D:Vocal@|0|{
    <8*>
    /* 旋轉個不休 */
    | 4 - - 1 1 - - 4 | 3 - - - - - - - |
    /* 旋轉個不休 */
    | 2 - - 2 5 - - 6 | 5 - - - - - - - |
    /* 我想永遠和你一起 */
    | 4 - 4 - 4 - 4 - | 3 - 1 - 1 - 1 - |
    /* 旋轉個不休 */
    | 5_ - 5_ - 7_ - 1 - | 1 - - - - - - - |
}

-> A -> A -> A1
-> B1 -> B2 -> B3
-> C1 -> C2
-> C1 -> C2
-> D
-> #

