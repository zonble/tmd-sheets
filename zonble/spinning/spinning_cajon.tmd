    | 5__ - - 2_ - - 5__ - | 6__ - - 3_ - - 6__ - |
    | 4__ - - 1_ - - 4__ - | 1_ - - 5__ - - 1_ - |
    | 2__ - 2_ - 5__ - 5_ - | 1_ - 5__ - 1_ - 0 0 |
}

A:Percussion@|0|{
    <16*>
    | {p} B-x- t-s- b-x- s-x- | B-x- t-s- b-x- s-x- |
    | B-x- t-s- b-x- s-x- | B-x- t-s- b-x- S-s- |
    | B-x- t-s- b-x- s-x- | B-x- t-s- b-x- s-x- |
    | B-s- B-s- B-s- B-S- | B-x- t-S- B--- 0--- |
}

