/* C2 (8 bars): 但是我從心底詛咒... 永遠和你一起旋轉個不休 (狂熱最高潮！)     */
/* ========================================================================= */

C2:Vocal@|0|{
    <8*>
    /* 但是我從 心底詛咒*/
    /* 但是我絕 不會看到*/
    | 4 - 4 - 5 - 6 - | 5 - 5 - 5 - 3 - |
    /* 那一個時候 因*/
    | 5 - 5 - 3 - 5 - | 5 - - - - - 5 - |
    /* 為我想要 一直 和你一起*/
    /* 為我一定 永遠 和你一起*/
    | 4 - 4 - 5 - 6 - | 5 - 5 - 5 3 3 1 |
    /* 旋轉個不休 */
    | 5 - 5 - 5 - 4 - | 3 - - - - - - - |
}

