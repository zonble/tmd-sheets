::SCORE::
** 藿香薊 **
!= 120
?= E
<4/4>

/* Intro */

Intro:Violin@|-1| {
    <4 *>
    | 0 0 0 5 |
    | 1^ 5 6 6 | (6 7)%(-) 1^ 7 6 | 5 (5 6)%(-) 5 (5 5)%(-) | 5 (5 6)%(-) 5 5 |
    | 1^ 5 6 6 | (6 7)%(-) 1^ 7 6 | (7 - - 1^)%(--) 1^ - | - - 1^ - |
    | - - 1^ - | - - 1^ - | - - - - |
}

Intro:Piano@|6| {
    <4*>
    | 0 0 1 1 |
    | (1 2)%(-) 3 3 2 | (2 3)%(-) 2 1 1 | (1 2)%(-) 3 3 2 | (2 7_)%(-) 5_ 1 - |
}

/* A */

A1:Vocal@|-1| {
    <4*>
    /* 灑來了一陣淅瀝
    是綿綿不停的霪雨
    傳來了一串笑語
    是苔痕親吻著山壁 */

    | 0 0 3 1 |
    | 5 6 5 4 | 3 - - - | - - - - | 0 0 1 3 |
    | 2 (3 2)%(-) 1 2 | 3 - - - | - - - - | 0 0 3 1 |
    | 5 6 5 4 | 3 - - - | - - - - | 0 0 1 3 |
    | 3 2 2 1 | 1 - - - | - - - - | 0 5 1^ 5 |
}

A1:Piano@|0| {
    <4*>
    /* 於是可以知道湖面的皺紋叫漣漪
    於是可以知道蕩開的方向叫牽引
    於是可以順著燕子的輕盈
    向著不知名處飛去
    一路上，開滿像繁星的藿香薊 */

    | 0 0 0 0 | 0 (3 3 )%(-) 3 (3 3 )%(-) | 3 (3 3 )%(-) 3 2 | 1 - - - |
    | 0 0 0 0 | 0 (3 3 )%(-) 3 (3 3 )%(-) | 3 (3 3 )%(-) 3 2 | 1 - - - |
    | 0 0 0 0 | 0 (3 3 )%(-) 3 (3 3 )%(-) | 3 (3 3 )%(-) 3 2 | 1 - - - |
    | 0 0 0 0 | 0 (3 3 )%(-) 3 (3 3 )%(-) | 3 (3 3 )%(-) 3 2 | 1 - - - |
}

A1:Violin@|1| {
    <4 *>
    | 3 - 2 - | 3 - - - | - - - - |
    | 0 0 0 0 | 1 - 2 - | 3 - - - | - - - - |
    | 0 0 0 0 | 3 - 2 - | 3 - - - | - - - - |
    | 0 0 0 0 | 1 - 2 - | 1 - - - | - - - - |
}

/* B */

B1:Vocal@|0| {
    <4*>
    /* 飄來了一陣清新
    是翻騰蒸潤的氤氳
    傳來了一串跫音
    是橋底溪澗的湍急 */

    | 6 6 (6 7)%(-) 1^ | 7 6 (5 -- 6)%(--) | 5 - - - | - 5 1^ 5 |
    | 6 6 (6 7)%(-) 1^ | 7 6 (7 -- 1^)%(--) | 1^ - - - | - 5 1^ 5 |
    | 6 6 (6 7)%(-) 1^ | 7 6 (5 -- 6)%(--) | 5 (5 5)%(-) 5 (5 6)%(-) | 5 5 1^ 5 |
    | 6 6 (6 7)%(-) 1^ | 7 6 (7 -- 1^)%(--) | 1^ - - - | - - - - |
}

B1:Piano@|14| {
    <4*>
    | 1 1 (1 2)%(-) 3 | 3 2 (2 3)%(-) 2 | 1 - - - |
}

/* A */
A2:Vocal@|-1| {
    <4*>
    /* 飄來了一陣清新
    是翻騰蒸潤的氤氳
    傳來了一串跫音
    是橋底溪澗的湍急 */

    | 0 0 3 1 |
    | 5 6 5 4 | 3 - - - | - - - - | 0 0 1 3 |
    | 2 (3 2)%(-) 1 4 | 3 - - - | - - - - | 0 0 3 1 |
    | 5 6 5 4 | 3 - - - | - - - - | 0 0 1 3 |
    | 3 2 2 1 | 1 - - - | - - - - | 0 5 1^ 5 |
}

A2:Piano@|0| {
    <4 *>
    | 0 0 0 0 | 0 (3 3 )%(-) 3 (3 3 )%(-) | 3 (3 3 )%(-) 3 2 | 1 - - - |
    | 0 0 0 0 | 0 (3 3 )%(-) 3 (3 3 )%(-) | 3 (3 3 )%(-) 3 2 | 1 - - - |
    | 0 0 0 0 | 0 (3 3 )%(-) 3 (3 3 )%(-) | 3 (3 3 )%(-) 3 2 | 1 - - - |
    | 0 0 0 0 | 0 (3 3 )%(-) 3 (3 3 )%(-) | 3 (3 3 )%(-) 3 2 | 1 - - - |
}

A2:Violin@|0| {
    <4 *>
    | 0 0 0 0 | 3 - 2 - | 3 - - - | - - - - |
    | 0 0 0 0 | 1 - 2 - | 3 - 2 - | 1 - - - |
    | 0 0 0 0 | 3 - 2 - | 3 - - - | - - - - |
    | 0 0 0 0 | 1 - 2 - | 1 - - - | - - - - |
}

/* B */

B2:Vocal@|0| {
    <4*>
    /* 於是可以知道枝椏的起伏叫韻律
    於是可以知道葉片的顫動叫呼吸
    於是可以順著燕子的輕盈
    向著不知名處飛去
    一路上，開滿像繁星的藿香薊 */

    | 6 6 (6 7)%(-) 1^ | 7 6 (5 -- 6)%(--) | 5 - - - | - 5 1^ 5 |
    | 6 6 (6 7)%(-) 1^ | 7 6 (7 -- 1^)%(--) | 1^ - - - | - 5 1^ 5 |
    | 6 6 (6 7)%(-) 1^ | 7 6 (5 -- 6)%(--) | 5 (5 5)%(-) 5 (5 6)%(-) | 5 5 1^ 5 |
    | 4 4 (6 7)%(-) 1^ | 7 6 (7 -- 1^)%(--) | 1^ - - - | - 5 1^ 5 |
}

B2:Piano@|14| {
    <4*>
    | 1 1 (1 2)%(-) 3 | 3 2 0 0 |
}

B3:Vocal@|0| {
    <4*>
    /* 於是可以將種子埋入濕透的衣領
    我的心，於是也蓋上一層植被
    我的心，攀滿了綠、
    還有紫色的、白色的藿香薊
    一路開滿了藿香薊 */

    | 6 6 (6 7)%(-) 1^ | 7 6 (5 -- 6)%(--) | 5 - - - | - - 4^ 3^ |
    | 1^ 1^ (1^ 2^)%(-) 3^ | (2^ - 3^ 2^)%(--) 1^ 4^ | 3^ - - - | - - 4^ 3^ |
    | 1^ 1^ (1^ 2^)%(-) 3^ | 2^ - 1^ 2^ | (3^ 4^ - -) %(--) 3^ - | 3^ (3^ 3^)%(-) 3^ (2^ 1^)%(-) |
    | 1^ - 4^ 3^ | (2^ -- 3^)%(--) (2^ -- 1^)%(--) | 1^ - - - | - - - 5^ |
}

C1:Vocal@|0| {
    <4*>
    /* 迎面吹來下坡的風
    看見密雲漸漸散去
    一路開滿了藿香薊 */

    | 5^ 6^ (5^ - - 4^)%(--) | (3^ 2^)%(--) (3^ - - 1^)%(--) |
    | 1^ 2^ (3^ - - 3^)%(--) | (3^2^)%(-) 1^ 1^ - |
    | 1^ 3^ (2^ 2^ 3^ 2^)%(--) | 1^ 2^ 3^ - |
    | - - - - | - - - 5^ |
}

C2:Vocal@|0| {
    <4*>
    /* 開在路邊平凡如我
    也能訴說春的消息
    紫色、白色的藿香薊 */

    | 5^ 6^ (5^ - - 4^)%(--) | (3^ 2^)%(--) (3^ - - 1^)%(--) |
    | 1^ 2^ (3^ - - 3^)%(--) | (3^2^)%(-) 1^ 1^ - |
    | 1^ 3^ 3^ 2^ | (2^ - - 1^)%(--) 1^ - | - - - - | - - - 5^ |
}

C3:Vocal@|0| {
    <4*>
    /* 迎面吹來下坡的風
    看見天際漸漸放晴
    一路開滿了藿香薊 */
    | 5^ 6^ (5^ - - 2^)%(--) | (5^ 4^)%(--) (3^ - - 1^)%(--) |
    | 1^ 2^ (3^ - - 3^)%(--) | (3^2^)%(-) 1^ 1^ - |
    | 1^ 3^ (2^ 2^ 3^ 2^)%(--) | 1^ 4^ 3^ - |
    | - - - - | - - - 5^ |
}

C4:Vocal@|0| {
    <4*>
    /* 走在路邊草芥如我
    也能領略春的消息
    紫色、白色的藿香薊 */

    | 5^ 6^ (5^ - - 2^)%(--) | (5^ 4^)%(--) (3^ - - 1^)%(--) |
    | 1^ 2^ (3^ - - 3^)%(--) | (3^2^)%(-) 1^ 1^ - |
    | 1^ 3^ 3^ 2^ | (2^ - - 1^)%(--) 1^ - | - - - - | - - - - |
}

