    | 0 0 0 0 | 0 0 0 0 | 0 4 6 2^ | 1^ 7 6 - |
    | 0 0 0 0 | 0 0 0 0 | 0 3 5 1^ | 7 6 5 - |
    | 0 0 0 0 | 0 0 0 0 | 0 4 6 5 | 3 - 1 - |
}

A1:Clarinet@|0| {
    <4*>
    | 1 - - - | 1 - 7_ - | 6_ - - - | 5_ - - - |
    | 4_ - - - | 5_ - - - | 1 - - - | - - - - |
    | 1 - - - | 1 - 7_ - | 6_ - - - | 5_ - - - |
    | 4_ - - - | 5_ - - - | 1 - - - | - - - - |
