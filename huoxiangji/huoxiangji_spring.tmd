/* ==========================================================
   B3: 副歌 3 (16 小節 - 高潮推展)
   於是可以將種子埋入濕透的衣領
   我的心，於是也蓋上一層植被
   我的心，攀滿了綠、還有紫色的、白色的藿香薊...
   ========================================================== */

B3:Vocal@|0| {
    <4*>
    | 6 6 (6 7)%(-) 1^ | 7 6 (5 -- 6)%(--) | 5 - - - | 1^ - 4^ 3^ |
    | 1^ 1^ (1^ 2^)%(-) 3^ | (2^ - 3^ 2^)%(--) 1^ 4^ | 3^ - - 2^ | 1^ - 4^ 3^ |
    | 1^ 1^ (1^ 2^)%(-) 3^ | 2^ - 1^ 2^ | 3^ 4^ 3^ - | 3^ (3^ 3^)%(-) 3^ (2^ 1^)%(-) |
    | 1^ 4 4^ 3^ | 2^ 3^ (2^ - 1^ 2^)%(--) | 1^ - - - | - - - - |
}

B3:Violin@|0| {
    <4*>
    /* 小提琴在高八度激昂演奏核心主題，繁花綻放！ */
    | 1^^ 5^ 6^ 6^ | (6^ 7^)%(-) 1^^ 7^ 6^ | 5^ (5^ 6^)%(-) 5^ (5^ 5^)%(-) | 5^ (5^ 6^)%(-) 5^ 5^ |
    | 6^ - - - | 4^ - - - | 3^ - - - | 0 1^ 4^ 3^ |
    | 1^^ 5^ 6^ 6^ | (6^ 7^)%(-) 1^^ 7^ 6^ | 1^^ - - - | 0 3^ 5^ 1^^ |
