::SCORE::
** あをば **
!= 100
?= D
<4/4>
~ "日治時期公學校唱歌"
~ "國立臺灣歷史博物館典藏"

Awoba:Piano@|0| {
    <4*>
    /* アメガヤム クモガチレル */
    /* カセガフク キガユレル */
    | 3 3 (2--1)%(--) | 2 -- 0 | 5 3 (1 -- 2)%(--) | 3 -- 0 |
    /* クモノアケニ ウネウネト */
    /* キサノカゲハ ユラユラト*/
    | 4 - 2 1 | 3 2 1 - | 3 6 5 3 | 2 -- 0 |
    /* アタバワカバノ ヤマヤマガ */
    /* ミツのおもてに ちのうへに*/
    | 3 - 5 5 | 1^ 1^ 7 6 | 5 5 3 6 | 5 -- 0 |
    /* トホクチカクノ コオル */
    /*  アをく くろく こうつる */
    | (1 --2)%(--) 3 - | (6--6)%(--) 5 - | 2 --3 | 1 -- 0 |
}

-> Awoba
-> #

