::SCORE::
** おまつり日（祭典之日） **
!= 132
?= Eb
<2/4>
~ "日治時期公學校唱歌"
~ "國立臺灣歷史博物館典藏"

/* =========================================================================
   原書歌詞全文（對應 image3.jpeg & image4.jpeg / P024–P025）：

   一　たいわんじんじやのおまつり日、
   たいこはどんどんなつてゐる。
   今年はほう年、よい年だ。
   ほうらいまいをそなへませう。
   みこしかついで、えつさつさ、
   たいこかついで、えつさつさ。

   二　たいわんじんじやのおまつり日、
   たいこはどんどんなつてゐる。
   みかんやぶんたん・ざぼんなど、
   いちばへかひにいきませう。
   みこしかついで、えつさつさ、
   たいこかついで、えつさつさ。

   三　たいわんじんじやのおまつり日、
   たいこはどんどんなつてゐる。
   バナナやおんらい・もくくわなど、
   おせどへ行つてもぎませう。
   みこしかついで、えつさつさ、
   たいこかついで、えつさつさ。

   （尾奏：たいわんじんじやのおまつり日）
   ========================================================================= */

/* ==========================================================
   前奏 (Intro): 4 小節 (2/4 拍)
   以祭典太鼓「どんどん」與抬神轎「えつさつさ」的歡騰節奏展開
   ========================================================== */

Intro:PianoRH@|0| {
    <8*>
    | (1^ -- 1^)%(--) 6 - | (6 -- 5)%(--) (3 -- 2)%(--) | 2 0 5_ 0 | 1 - - 0 |
}

Intro:PianoLH@|0| {
    <8*>
    | 4_ [4] 4_ [4] | 1_ [1] 6_ [6m] | 2_ 0 5_ 0 | 1_ [1] [1] 0 |
}

/* ==========================================================
   主歌段 (Omatsuribi): 24 小節 (2/4 拍)
   右手為唱歌主旋律，左手為祭典太鼓般的活潑伴奏
   ========================================================== */

Omatsuribi:PianoRH@|0| {
    <8*>
    /* ================= 第一行 (4 小節, image.jpeg / P022) ================= */
    /* 一: タ   イ ワ   ン | ジ   ン ジヤ ノ | オ   マ ツ   リ | ビ         */
    /* 二: た   い わ   ん | じ   ん じや の | お   ま つ   り | び         */
    /* 三: タ   イ ワ   ン | ジ   ン ジヤ ノ | オ   マ ツ   リ | ビ         */
    | (1 -- 3)%(--) (5 -- 5)%(--) | (5 -- 5)%(--) (5 -- 5)%(--) | (3 -- 5)%(--) (6 -- 6)%(--) | 5 - - 0 |

    /* ================= 第二行 (4 小節, image.jpeg / P022) ================= */
    /* 一: タ   イ コ   ハ | ドン   ドン   | ナ   ツ テ   ヰ | ル         */
    /* 二: た   い こ   は | どん   どん   | な   つ て   ゐ | る         */
    /* 三: タ   イ コ   ハ | ドン   ドン   | ナ   ツ テ   ヰ | ル         */
    | (6 -- 1^)%(--) (6 -- 5)%(--) | 3 - 1 - | (2 -- 2)%(--) (2 -- 3)%(--) | 2 - - 0 |

    /* ================= 第三行 (4 小節, image.jpeg / P022) ================= */
    /* 一: コ   ト シ   ハ | ホ   ウ ネ   ン | ヨ   イ ト   シ | ダ         */
    /* 二: み   か ん   や | ぶ   ん た   ん | ざ   ぼ ん   な | ど         */
    /* 三: バ   ナ ナ   ヤ | オ   ン ラ   イ | モ   ク クワ ナ | ド         */
    | (3 -- 2)%(--) (1 -- 3)%(--) | (5 -- 5)%(--) (5 -- 5)%(--) | (6 -- 5)%(--) (3 -- 5)%(--) | 6 - - 0 |

    /* ================= 第四行 (4 小節, image.jpeg / P022) ================= */
    /* 一: ホ   ウ ラ   イ | マ   イ ヲ     | ソ   ナ ヘ   マ | セウ       */
    /* 二: い   ち ば   へ | か   ひ に     | い   き ま   せ | う         */
    /* 三: オ   セ ド   ヘ | イツ テ        | モ   ギ マ   セ | ウ         */
    | (1^ -- 2^)%(--) (1^ -- 6)%(--) | (5 -- 5)%(--) 3 - | (2 -- 2)%(--) (3 -- 2)%(--) | 1 - - 0 |

    /* ================= 第五行 (4 小節, image2.jpeg / P023) ================ */
    /* 一: ミ     コ シ   | カ   ツ イ   デ | エツ   サツ   | サ         */
    /* 二: み     こ し   | か   つ い   で | えつ   さつ   | さ         */
    /* 三: ミ     コ シ   | カ   ツ イ   デ | エツ   サツ   | サ         */
    | 3 - 1 1 | (3 -- 4)%(--) (5 -- 1^)%(--) | 6 0 5 0 | 5 - - 0 |

    /* ================= 第六行 (4 小節, image2.jpeg / P023) ================ */
    /* 一: タ   イ コ     | カ   ツ イ   デ | エツ   サツ   | サ         */
    /* 二: た   い こ     | か   つ い   で | えつ   さつ   | さ         */
    /* 三: タ   イ コ     | カ   ツ イ   デ | エツ   サツ   | サ         */
    | (1^ -- 1^)%(--) 6 - | (6 -- 5)%(--) (3 -- 2)%(--) | 2 0 5_ 0 | 1 - - 0 |
}

Omatsuribi:PianoLH@|0| {
    <8*>
    /* ================= 第一行 (4 小節) ================= */
    | 1_ [1] 5_ [1] | 1_ [1] 5_ [1] | 1_ [1] 4_ [4] | 1_ [1] 5_ 0 |

    /* ================= 第二行 (4 小節) ================= */
    | 4_ [4] 4_ [4] | 1_ [1] 6_ [6m] | 2_ [2m] 2_ [2m] | 5_ [5] 5_ 0 |

    /* ================= 第三行 (4 小節) ================= */
    | 1_ [1] 5_ [1] | 1_ [1] 5_ [1] | 4_ [4] 1_ [1] | 6_ [6m] 6_ 0 |

    /* ================= 第四行 (4 小節) ================= */
    | 4_ [4] 4_ [4] | 1_ [1] 6_ [6m] | 5_ [5] 5_ [5] | 1_ [1] 1_ 0 |

    /* ================= 第五行 (4 小節) ================= */
    | 1_ [1] 5_ [1] | 1_ [1] 5_ [1] | 4_ 0 1_ 0 | 5_ [5] 5_ 0 |

    /* ================= 第六行 (4 小節) ================= */
    | 4_ [4] 4_ [4] | 1_ [1] 6_ [6m] | 2_ 0 5_ 0 | 1_ [1] 1_ 0 |
}

/* ==========================================================
   尾奏段 (Coda): 4 小節 (轉 3/4 拍, != 112)
   三段歌詞唱畢後，以寬廣莊重的三拍子作結
   ========================================================== */

Coda:PianoRH@|0| {
    <8*>
    /* ================= 第七行 (尾奏 4 小節, image2.jpeg / P023) =========== */
    /* 尾: タ イ ワ   ン   | ジ ン ジヤ ノ   | オ マ ツ   リ   | ビ         */
    {!= 112} {<3/4>}
    | 3 2 1 - 2 - | 3 5 6 - 5 - | 3 5 2 - 3 - | 1 - - - 0 - |
}

Coda:PianoLH@|0| {
    <8*>
    {!= 112} {<3/4>}
    | 1_ - [1] - 5_ - | 1_ - [4] - [1] - | 1_ - 5_ - [5] - | 1_ - [1] - 0 - |
}

-> Intro -> Omatsuribi -> Omatsuribi -> Omatsuribi -> Coda -> #

