::SCORE::
** 白さぎ（白鷺鷥） **
!= 112
?= Eb
<3/4>
~ "日治時期公學校唱歌"
~ "國立臺灣歷史博物館典藏"

/* =========================================================================
   原書歌詞全文（對應 image2.jpeg / P039）：

   一　とんだよ、とんだ、白さぎが。
   やつぱり向ふの田に下りた。
   田にはきらきら水ばかり。

   二　とんだよ、とんだ、白さぎが。
   やつぱり向ふの田に下りた。
   田にはすいすいいねばかり。

   三　とんだよ、とんだ、白さぎが。
   やつぱり向ふの田に下りた。
   田にはたにしがかくれてる。
   ========================================================================= */

/* ==========================================================
   前奏 (Intro): 4 小節 (3/4 拍)
   描繪白鷺鷥展翅翩翩飛起、輕盈降落於波光水田的圓舞曲律動
   ========================================================== */

Intro:PianoRH@|0| {
    <8*>
    | 3 - 2 - 1 - | 6 5 1^ - 6 - | 3 5 6 - - 5 | 1^ - - - 0 - |
}

Intro:PianoLH@|0| {
    <8*>
    | 1_ - [1] - [1] - | 4_ - [4] - [4] - | 5_ - [5] - [5] - | 1_ - [1] - 0 - |
}

/* ==========================================================
   主歌段 (Shirasagi): 12 小節 (3/4 拍)
   右手為唱歌主旋律，左手為優雅流暢的三拍子圓舞曲伴奏
   ========================================================== */

Shirasagi:PianoRH@|0| {
    <8*>
    /* ================= 第一行 (4 小節, image.jpeg / P038) ================= */
    /* 一: ト ン ダ   ヨ   | ト ー ン   ダ   | シ ラ サ   ギ   | ガ           */
    /* 二: と ん だ   よ   | と ー ん   だ   | し ら さ   ぎ   | が           */
    /* 三: ト ン ダ   ヨ   | ト ー ン   ダ   | シ ラ サ   ギ   | ガ           */
    | 3 2 1 - 2 - | 3 5 6 - 5 - | 3 5 1^ - 6 - | 5 - - - 0 - |

    /* ================= 第二行 (4 小節, image.jpeg / P038) ================= */
    /* 一: ヤ ツ パ   リ   | ム カ フ   ノ   | タ ニ オ   リ   | タ           */
    /* 二: や つ ぱ   り   | む か ふ   の   | た に お   り   | た           */
    /* 三: ヤ ツ パ   リ   | ム カ フ   ノ   | タ ニ オ   リ   | タ           */
    | 6 6 6 - 5 - | 1^ 1^ 6 - 6 - | 5 6 3 - 2 - | 1 - - - 0 - |

    /* ================= 第三行 (4 小節, image.jpeg / P038) ================= */
    /* 一: タ   ニ   ハ   | キ ラ キ   ラ   | ミ ヅ バ     カ | リ           */
    /* 二: た   に   は   | す い す   い   | い ね ば     か | り           */
    /* 三: タ   ニ   ハ   | タ ニ シ   ガ   | カ ク レ     テ | ル           */
    | 3 - 2 - 1 - | 6 5 1^ - 6 - | 3 5 6 - - 5 | 1^ - - - 0 - |
}

Shirasagi:PianoLH@|0| {
    <8*>
    /* ================= 第一行 (4 小節) ================= */
    | 1_ - [1] - [1] - | 1_ - [4] - [1] - | 6_ - [6m] - [4] - | 5_ - [5] - 0 - |

    /* ================= 第二行 (4 小節) ================= */
    | 4_ - [4] - [1] - | 4_ - [4] - [4] - | 1_ - [1] - [5] - | 1_ - [1] - 0 - |

    /* ================= 第三行 (4 小節) ================= */
    | 1_ - [1] - [1] - | 4_ - [4] - [4] - | 5_ - [5] - [5] - | 1_ - [1] - 0 - |
}

-> Intro -> Shirasagi -> Shirasagi -> Shirasagi -> #

