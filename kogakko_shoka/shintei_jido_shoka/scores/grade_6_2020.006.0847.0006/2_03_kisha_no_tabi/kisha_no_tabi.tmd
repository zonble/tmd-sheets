// 汽車の旅 (北村氏中等音樂教科書)
/*
一、
千里の山坂ひたばしり
くるまは煙を後にして
樂しの希望を載せ行く時
嬉しの旅路を驅け行く時
響くや轍の轟きに
こゝろも空にぞ勇むなる

二、
千里の野山を束の間に
過ぎゆく旅路の面白や
遙のみ空に見えたる山
忽ち來りてやがては行く
送りて迎へて幾度か
數多の野山は窓に入る
*/

tempo= 84
time= 2/4
key= G
title= "汽車の旅"
subtitle= "北村氏中等音樂教科書"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第六學年用（2020.006.0847.0006）"

