// 霧（ピアノ伴奏付）
/*
一、
しら〲と朝霧、野山をこめて
月のごと日輪、ほのかに浮ぶ
野路を行く人影、直ちにきえて
けたゝましもずの音、梢はいづこ
谷間よりはひ出て、木の幹ぬらし
しら〲とおぼろに、朝霧流る

二、
しめやかに夜の霧ちまたをつゝみ
立並ぶ家々、燈火うるむ
影のごと人去り、人來る大路
ほろ〲と聞ゆる笛の音いづこ
窓ぎはにはひよりガラス戸ぬらし
しめやかにひそかに夜の霧流る
*/

tempo= 76
time= 4/4
key= G
title= "霧（ピアノ伴奏付）"
~ "曲：山本壽"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第六學年用（2020.006.0847.0006）"

