// 乃木大將の歌 (小松耕輔)
/*
一、
夢より淡き三日月の
大内山にかぐろひて
先の帝の御車は
果のいでましあらせらる

二、
火砲のひゞき轟きて
宵闇やぶる一刹那
乃木大將は御後を
慕ひまつりて逝きにけり

三、
日頃捧げし誠心は
また魂になりかはり
天つ御國の大君に
天地の共仕ふらん

四、
六十四年の生涯は
日本の武士の鑑にて
をはる最後のかゞやきは
純美崇高極みなし

五、
起てよ武夫武士道の
權化を前に認めずや
今し鋭心起らずば
腰のつるぎに恥あらん

六、
わが帝國の同胞よ
鬼神涙に咽ぶべき
この壯烈に勇まずば
汝の胸に血汐なし
*/

tempo= 84
time= 2/4
key= Em
title= "乃木大將の歌"
~ "曲：小松耕輔"
~ "臺灣教育會公認《新定兒童唱歌》尋常科第六學年用（2020.006.0847.0006）"

[A]
?= G, <2/4>, != 84
Piano@|0|
| [e.8 b,16] [e.8 f16] | [(g.8 f16)] [e.8 f16] | [g.8 a16] [b.8 g16] | f.4 z8 |
| [g.8 g16] [f.8 f16] | [e.8 f16] [(e.8 b,16)] | [g.8 g16] [f.8 f16] | e.4 z8 |
| [(e'.8 b16)] [b.8 b16] | [c'.8 b16] [a.8 a16] | [g.8 a16] [g.8 f16] | b.4 z8 |
| [b.8 e'16] [(b.8 a16)] | [g.8 f16] [e.8 f16] | [(b,.8 e16)] [g.8 f16] | e.4 z8 |
