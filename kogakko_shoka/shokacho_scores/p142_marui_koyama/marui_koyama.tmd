  | そ - の - ま - - た | よ - こっ - ちょ - 0 - | き - の - こ - が - | フタツ - - - 0 - - - |
  | お - や - ま - の - | な - か - に - は - | トン - - ネ ル - - が | フタツ - - - 0 - - - |
