# 圓い小山（顔あそび）(圓圓的小山〔臉部遊戲〕)
# 頁面：P142.jpg
# 作歌：北原白秋
# 作曲：中山晋平
# 調性：ヘ長調 (F major, 1♭)
# 拍號：2/4 拍（末行轉 4/4 拍）
# 速度：♩=84
#
# 【歌詞】
# 圓い小山に　日がでて落ちて
# お月さまが　二つでた
# そのまた横つちよに　きのこが二つ
# お山の中には　トンネルが二つ
# でたり　はいつたり
# 草の原つぱ　ちよろちよろり
# 下にはほらほら　あつたかいお湯が
# わくわくわいてる　あかいお湯
# そらうごいた　わらつた
# あつはつはのは

~title= 圓い小山（顔あそび）
~subtitle= 北原白秋 歌・中山晋平 曲（唱歌帳 P142）
~meter= 2/4
?= F
!= 84

@melody {
  *program= 73
  $16*
  // 第 1–4 小節
  | 6 - 6 - 6 - - 5 | 6 - 5 - 3 - 2 - | 1 - - - - - 2 - | 3 - - - 0 - - - |
  // 第 5–8 小節
  | 2 - 2 - 2 - - 1 | 2 - 3 - 5 - 3 - | 6_ - 1 - 2 - - 3 | 1 - - - 0 - - - |
  // 第 9–12 小節
  | 6 - 6 - 6 - - 6 | 1^ - 6 - 5 - 0 - | 6 - 6 - 1^ - 6 - | 5 - - - 0 - - - |
  // 第 13–16 小節
  | 6 - 5 - 3 - 2 - | 1 - 1 - 2 - 3 - | 5 - - 3 2 - - 3 | 1 - - - 0 - - - |
  // 第 17–20 小節
  | 2 - - - 3 - - - | 5 - - - 0 - - - | 6 - - - 1^ - - - | 5 - - - 0 - - - |
  // 第 21–24 小節
  | 6 - 5 - 3 - 2 - | 1 - 6_ - 1 - 2 - | 3 - - - - - 5 - | 2 - - - 0 - - - |
  // 第 25–28 小節
  | 6 - 6 - 6 - - 5 | 6 - 5 - 3 - 2 - | 1 - - - 2 - - - | 3 - - - 0 - - - |
  // 第 29–32 小節
  | 2 - 2 - 3 - 5 - | 6 - - - 5 - - - | 3 - 5 - 6 - 1^ - | 5 - - - 0 - - - |
  // 第 33–36 小節 (轉 4/4 拍)
  ~meter= 4/4
  | 6 - - - 5 - - - 3 - - - 2 - - - | 1 - - - 2 - - - 3 - - - 0 - - - | 5 - - - 6 - - - 3 - - - 2 - - - | 1 - - - - - - - 0 - - - - - - - |
}

