# 春のみつぎ (春之貢禮)
# 頁面：P135.jpg
# 作歌：西木紫雪
# 作曲：トキ坊
# 調性：ハ長調 (C major)
# 拍號：4/4 拍 (C)
#
# 【歌詞】
# 一、春が來たので　うぐひすは
# 　　白い梅の實　たべながら
# 　　ホーホケキョーと　お歌ひで
# 　　春のおみつぎ　あげました
#
# 二、春が來たので　蝶々は
# 　　黄ろい菜の蜜　すひながら
# 　　ヒラヒラヒラと　おどりして
# 　　春のおみつぎ　あげました
#
# 三、春が來たので　わたくしは
# 　　紅いおリボン　かけながら
# 　　うれしい唱歌　うたひして
# 　　春のおみつぎ　あげました

~title= 春のみつぎ
~subtitle= 西木紫雪 作歌・トキ坊 作曲（唱歌帳 P135）
~meter= 4/4
?= C
!= 104

@melody {
  *program= 73
  $8*
  // 第 1–4 小節
  | 5 - - 5 3 - 1 - | 6 - - 6 5 - 1^ - | 6 - 5 - 6 - 3 - | 5 - - - - - 0 - |
  // 第 5–8 小節
  | 5 - - 5 3 - 1 - | 2 - - 2 3 - 5 - | 6 - 6 - 5 - 3 - | 2 - - - - - 0 - |
  // 第 9–12 小節
  | 1^ - - 1^ 5 - 3 - | 6 - 5 - 3 - 1 - | 5 - - 5 3 - 1 - | 2 - - - - - 0 - |
  // 第 13–16 小節
  | 3 - - 3 5 - 3 - | 6 - - 6 5 - 3 - | 2 - 3 - 5 5 3 2 | 1 - - - - - 0 - |
}

@lyrics {
  $8*
  | は - - る が - き - | た - - の で - う - | ぐ - ひ - す - は - | 0 - - - - - 0 - |
  | し - - ろ い - う - | め - - の み - た - | べ - な - が - ら - | 0 - - - - - 0 - |
  | ホー - - ホ ケ - キョー - | と - お - う - た - | ひ - - で 0 - 0 - | 0 - - - - - 0 - |
  | は - - る の - お - | み - - つ ぎ - あ - | げ - ま - し - た - | 0 - - - - - 0 - |
}
