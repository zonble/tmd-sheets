<2/4>

~Vocal: 53 @name="Vocal" @midi_transpose=0

---

[A]
# 歌詞:
# 1. タイハウ ガラガラ ヒキ出シテ / ドンドン ウチ出ス イサマシサ
#    オホキナ ヤマモ クヅレル ヤウナ / オホキナ オトヨ イサマシヤ
# 2. ハウダイ ガラガラ クヅレ出ス / ドンドン ニゲ出ス テキノヘイ
#    ニゲ出ス ヤウナ コシヌケ ヘイハ / ゼンメツ サセヨ ネラヒウテ

~Vocal: | {f} 5_. 5__ 5_ 5_ | 5_ 5_ 5_ 5_ | 1^_ 1^__ 1^__ 1^_ 1^_ | 1^. 0_ |
