# 渡りやんせ (請過橋吧)
# 頁面：P139.jpg – P140.jpg (《子供の國》第 61–60 頁)
# 作歌：野口雨情
# 作曲：中山晋平
# 調性：變ホ調 / ハ短調 (Eb major / C minor, 3♭)
# 拍號：2/4 拍
#
# 【歌詞】
# 一、山の小川に　一本橋を
# 　　ちよとかけたれば
# 　　目高がなくぞ
# 　　渡りやんせ　渡りやんせ
# 　　石の燈籠の　灯がついた
# 　　灯がついた
#
# 二、山の小川に　丸木の橋を
# 　　ちよとかけたれば
# 　　川蝦なくぞ
# 　　渡りやんせ　渡りやんせ
# 　　石の燈籠の　灯も消えた
# 　　灯も消えた

~title= 渡りやんせ
~subtitle= 野口雨情 作歌・中山晋平 作曲（唱歌帳 P139–P140）
~meter= 2/4
?= E,
key= Cm
!= 84

@melody {
  *program= 73
  $16*
  // 前奏 4 小節
  | 0 - - - 0 - - - | 0 - - - 0 - - - | 0 - - - 0 - - - | 0 - - - 0 - - - |
  // 第 5–8 小節 (P139)
  | 3 - - 3 3 - 4 - | 6 - - 6 6 - 4 - | 3 - 4 - 3 - 1 - | 3 - - - 0 - - - |
  // 第 9–14 小節 (P140 上行)
  | 1^ - - 7 6 - 3 - | 4 - - 3 1 - - - | 6_ - 1 - 4 - - 3 | 3 - - - 0 - - - | 6_ - 6_ - 1 - 1 - | 3 - 4 3 1 - 0 - |
  // 第 15–20 小節 (P140 下行)
  | 6_ - 6_ - 1 - 1 - | 3 - 4 3 1 - 0 - | 1^ - - 7 6 - 3 - | 4 - - 6 3 - 0 - | 3 - 4 - 3 - 1 - | 6_ - - - 0 - - - |
}

@lyrics {
  $16*
  | 0 - - - 0 - - - | 0 - - - 0 - - - | 0 - - - 0 - - - | 0 - - - 0 - - - |
  | や - - ま の - お - | が - - わ に - いっ - | ぽ - ん - ば - し - | を - - - 0 - - - |
  | ちょ - - と か - け - | た - - れ ば - - - | め - だ - か - - が | なく - - - 0 - - - | わ - た - り - やん - | せ - _ _ _ - 0 - |
  | わ - た - り - やん - | せ - _ _ _ - 0 - | い - - し の - とう - | ろ - - の ひ - 0 - | が - つ - い - た - | _ - - - 0 - - - |
}
