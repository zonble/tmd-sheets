  | 0 - - - 0 - - - | 0 - - - 0 - - - | 0 - - - 0 - - - | 0 - - - 0 - - - |
  | や - - ま の - お - | が - - わ に - いっ - | ぽ - ん - ば - し - | を - _ - _ - 0 - |
  | ちょ - - と か - け - | た - - れ ば - - - | め - だ - か - - が | なく - _ - _ - 0 - | わ - た - り - やん - | せ - _ _ _ - 0 - |
  | わ - た - り - やん - | せ - _ _ _ - 0 - | い - - し の - とう - | ろ - - の ひ - 0 - | が - つ - い - た - | _ - _ - _ - 0 - |
}
