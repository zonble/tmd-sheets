# 渡りやんせ (請過橋吧) — 鋼琴伴奏版
# 頁面：P139.jpg – P140.jpg (《子供の國》第 61–60 頁)
# 作歌：野口雨情
# 作曲：中山晋平
# 調性：變ホ調 / ハ短調 (Eb major / C minor, 3♭)
# 拍號：2/4 拍

~title= 渡りやんせ（鋼琴伴奏版）
~subtitle= 野口雨情 作歌・中山晋平 作曲（唱歌帳 P139–P140）
~meter= 2/4
?= E,
key= Cm
!= 84

@rh {
  *program= 0
  $16*
  // 原譜 4 小節前奏
  | 1^ - - 7 6 - 3 - | 4 - - 6 3 - - - | 3 - 4 - 3 - 1 - | 6_ - - - 0 - - - |
  // 第 5–8 小節
  | 3 - - 3 3 - 4 - | <1 6> - - 6 <1 6> - 4 - | 3 - 4 - 3 - 1 - | 3 - <6_ 1> - <6_ 1> - 0 - |
  // 第 9–14 小節
  | 1^ - - 7 6 - 3 - | 4 - - 3 1 - - - | 6_ - 1 - 4 - - 3 | 3 - <6_ 1> - <6_ 1> - 0 - | 6_ - 6_ - 1 - 1 - | 3 - 4 3 1 - 0 - |
  // 第 15–20 小節
  | 6_ - 6_ - 1 - 1 - | 3 - 4 3 1 - 0 - | 1^ - - 7 6 - 3 - | 4 - - 6 3 - 0 - | 3 - 4 - 3 - 1 - | 6_ - <3_ 6_> - <3_ 6_> - 0 - |
}

@lh {
  *program= 0
  $16*
  // 原譜前奏左手
  | 6_ - <1 3> - 6_ - <1 3> - | 4_ - <6_ 1> - 6_ - <1 3> - | 3_ - <6_ 1> - 3_ - <6_ 1> - | 6__ - 3_ - 6__ - 0 - |
  // 第 5–8 小節
  | 6__ - <3_ 6_> - 6__ - <3_ 6_> - | 4_ - <6_ 1> - 4_ - <6_ 1> - | 6__ - <3_ 6_> - 6__ - <3_ 6_> - | 3_ - - - 3_ - 0 - |
  // 第 9–14 小節
  | 6_ - <1 3> - 6_ - <1 3> - | 4_ - <6_ 1> - 6_ - <1 3> - | 4_ - <6_ 1> - 4_ - <6_ 1> - | 3_ - - - 3_ - 0 - | 6__ - 3_ - 6__ - 3_ - | 6__ - <3_ 6_> - 6__ - 0 - |
  // 第 15–20 小節
  | 6__ - 3_ - 6__ - 3_ - | 6__ - <3_ 6_> - 6__ - 0 - | 6_ - <1 3> - 6_ - <1 3> - | 4_ - <6_ 1> - 6_ - 0 - | 3_ - <6_ 1> - 3_ - <6_ 1> - | 6__ - - - 6__ - 0 - |
}

