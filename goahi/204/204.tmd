::SCORE::
** 西樂都馬 **
!= 100
?= F
~ "origin: https://twoperapf.org.tw/resource/sheet-music/204"
<2/4>

Intro:Piano@|0| {
    <16*>
    | 5 - 5 - 3 2 3 5 | 2 - - - - - 3 - |
    | 5_ - 1 - 6_ 5_ 5_ 1 | 5_ - - - - - - - |
    | 5 - 5 - 3 2 3 5 | 2 - - - - - - - |
}

A1:Vocal@|0| {
    <8*>
    /* @lyrics1= 天然美景真奇妙 */
    /* @lyrics2= 鴟鴞展翅賽神雕 */
    | 3 - 2 1 | 2 3 5_ - |
    | (1 -- 2)%(--) 5 3 | 2 - - - |
}

A2:Vocal@|-1| {
    <8*>
    | 0 0 0 3 | 5 5 (3 2 3 5)%(--) | 2 - - - |
}

B1:Vocal@|0| {
    <8*>
    /* @lyrics1= 山頂清涼熱氣消  */
    /* @lyrics2= 樹頂厝鳥唸歌謠 */
    | 2 - 3 1 | 2 3 5_ - |
    | (1 -- 3)%(--) 2 5_ | 1 - - - |
}

C1:Vocal@|0| {
    <8*>
    /* @lyrics1= 水沖(瀑布)懸懸彩虹耀 */
    /* @lyrics2= 爬山運動能還少 */
    | 5_ - 2 7_ | 6_ 7_ - 6_ |
    | (5_ -- 6_)%(--) (2 -- 7_)%(--) | 6_ - - - |
}

D1:Vocal@|0| {
    <16*>
    | 6_ - - - 1 - 5_ - | 6_ - - 1 3_ 5_ 3_ 5_ |
    | 6_ 1 6_ 5_ 3_ 5_ 5_ 1 | 5_ - - - - - - - |
}

-> Intro
-> A1 -> A2
-> B1
-> C1
-> D1
-> #

