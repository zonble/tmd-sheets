::SCORE::
** 都馬調 **
!= 100
?= F
~ "origin: https://twoperapf.org.tw/resource/sheet-music/203"
<2/4>

/* 長錘：倉・七・台・七；此兩小節可依舞台動作重複延長。 */
ChangChui:Drums@|0|{
    <4*>
    /* 倉：C；七：X；台：T；七：X */
    | C X | T X | C X | T X |
}

/* 各各：板鼓領奏 cue，不是一般伴奏。S/s 只表示相對強弱與位置。 */
GeGe:Drums@|-1|{
    <16*>
    /* 各 各：鼓心／鼓邊的兩個精準提示，後留空間給定身或變奏 */
    | 0 0 0 0 S 0 s 0 |
}

/* 奪頭：短促、有切口；此處以低音落點、休止與結束亮點近似。 */
DuoTou:Drums@|0|{
    <16*>
    /* 倉／切口 */
    | B - 0 0 0 0 0 0 | T X B C 0 0 0 0 |
}

Intro:Piano@|0| {
    <8*>
    | 5_ (0 5)%(-) 3 5 |
    | (2 3 2 1)%(--) 7_ 6_ |
    | 5_ 1 (6_ 1)%(-) 2 |
    | 5_ 5_ (3 2 3 5)%(--) |
    | 2 - 2 2 |
}

A1:Vocal1@|0| {
    <8*>
    | 5 - 1 - |
    /* 太 歲 */
    | 2 5 1 (2 1)%(-) | 2 - - - |
    /* 金冠 鳳雉 條 ， */
}

A2:Piano@|-1| {
    <8*>
    | 0 - - 3 |
    | 5 1^ (6 5 3 5)%(--) |
    | 2 - - - |
}

B1:Vocal1@|0| {
    <8*>
    | 2 - 1 2 |
    /* 絲 羅 */
    | 3 (2 1)%(-) 6_ 2 | 2 - 5_ 6_ |
    /* 戰甲隨風 飄 ， 玉面 */
    | 6_ (5_ 6_)%(-) 6_ - |
    /* 朱唇 */
    | 1 - (2 1)%(-) 6_ |
    /* 多 俊 */
    | 5_ - 5_ (2 7_)%(-) |
    /* 俏 ， 白馬 */
    | 6_ 2 (2 3)%(-) 6_ | 6_ - - - |
    /* 銀槍 勝 馬 超 。 */
}

B2:Piano@|-1| {
    <8*>
    | 0 - - 7_ |
    | 6_ (2 5)%(-) (3 2)%(-) 7_ |
    | 6_ - 0 - |
}

B3:Piano@|0| {
    <8*>
    | 5_ (0 5)%(-) 3 5 |
    | (2 3 2 1)%(--) 7_ 6_ |
    | 5_ 1 (6_ 1)%(-) 2 |
    | 5_ 5_ (3 2 3 5)%(--) |
    | 2 - 2 2 |
}

C1:Vocal2@|0| {
    <8*>
    | 1 - 5 3 |
    /* 勒 馬 */
    | (2 1)%(-) 2 1 - |
    /* 停蹄 */
    | 1 (6_ 1)%(-) (2 1)%(-) 6_ |
    /* 詳 細 */
    | 5_ - 2 (5_ 6_)%(-) |
    /* 看 ， 此人 */
    | 2 3 3_ 5_ | 6_ - - - |
    /* 必是 樊梨 花 ， */
}

C2:Piano@|-1| {
    <8*>
    | 0 - - 7_ |
    | 6_ (2 5)%(-) (3 2)%(-) 7_ |
    | 6_ - 6_ 6_ |
}

D1:Vocal2@|0| {
    <8*>
    | (5 -- 3)%(--) 2 1 | 2 3 - - |
    /* 武 藝 高 超 */
    | 1 - (2 1)%(-) 6_ |
    /* 多 變 */
    | 5_ - 6_ (5_ 6_)%(-) |
    /* 化 ， 西遼 */
    | 5_ 6_ (2 3)%(-) 5 | 6_ - - - |
    /* 第一 女 嬌 娃 。 */
}

D2:Piano@|-1| {
    <8*>
    | 0 - - 7_ |
    | 6_ (2 5)%(-) (3 2)%(-) 7_ |
    | 6_ - 0 - |
    /* | 0 - - - | 0 - - - | 0 - - - | */
    /* 長錘 倉來才乙台 倉 */
}

D3:Piano@|0| {
    <8*>
    | 0 - 7_ 6_ |
    | (5_ 6_ 5_ 1)%(--) (6_ 1)%(-) 2 |
    | 5_ 5_ (3 2 3 5)%(--) |
    | (2 -- 1)%(--) 2 - |
}

E1:Vocal1@|0| {
    <8*>
    | 0 - - 2 |
    /* 伊 */
    | (5 -- 3)%(--) 2 1 |
    /* 武 藝 */
    | (2 1)%(-) 2 (3 2)%(-) 1 |
    /* 高強 氣 勢 */
    | 3 2 - 2 |
    /* 勇 。 生: 伊 */
    | (5 -- 3)%(--) 2 1 |
    /* 戰 法 */
    | 2 5 5 5 |
    /* 靈通 武功 */
    | 1 - - 1 |
    /* 生: 強 。 旦: 伊 */
    | 2 1 1 - |
    /* 俊 貌 */
    | 2 (2 1)%(-) 6_ 5_ |
    /* 引我 */
    | (6_ -- 1)%(--) 1 6_ |
    /* 情 難 */
    | 5_ - 2 5_ |
    /* 禁 ， 錯亂 */
    | (2 -- 7_)%(--) 6_ 5_ |
    /* 我 的 */
    | 6_ (5_ 6_)%(-) 5_ - |
    /* 精神 */
    | 5_ 3_ 6_ (5_ 5)%(-) |
    /* 迷亂 我 的 */
    | 6_ - - - |
    /* 心 。 */
}

E2:Piano@|-1| {
    <8*>
    | 0 - - 7_ |
    | 6_ (2 5)%(-) (3 2)%(-) 7_ |
    | 6_ - 0 - |
    | 0 - - - |
    /* 台 */
    | 5_ 1 (6_ 1)%(-) 2 |
    | 5_ 5_ (3 2 3 5)%(--) |
    | 2 - 2 2 |
}

F1:Vocal2@|0| {
    <8*>
    | (5 -- 3)%(--) 2 1 |
    /* 殺 敵 */
    | (3 2)%(-) 1 - 3 |
    /* 保 國 我 */
    | 2 1 - 3 |
    /* 該 負 責 */
    | 2 - - - |
    /* 任 ， */
    | 1 - 1 - |
    /* 意 欲 */
    | 2 5 - 3 |
    /* 將 伊 */
    | 2 1 5_ - |
    /* 來 活 */
    | 1 - - - |
    /* 擒 。 */
}

F2:Vocal1@|0| {
    <8*>
    | (2 -- 7_)%(--) 2 7_ |
    /* 眼 觀伊 */
    | 6_ 2 - 7_ |
    /* 丁 山 */
    | 6_ (5_ 6_)%(-) 5_ 5_ |
    /* 龍眉 鳳 */
    | 7_ 6_ - 6_ |
    /* 眼 ， 伊 */
    | 6_ - 5_ - |
    /* 英 俊 */
    | 2 2 3_ 5_ | 6_ - - - |
    /* 可比 潘 安 。 */
}

F3:Piano@|-1| {
    <8*>
    | 0 - - 7_ |
    | 6_ 7_ 6_ 7_ |
    | 6_ 7_ 6_ 7_ |
    | 2 3 2 3 |
    | 2 3 2 3 |
    | 2 0 0 (2 3)%(-) |
    | 5 (2 5)%(-) (3 2 7_ 6_)%(--) |
    | 5_ 5_ (3 2 3 5)%(--) |
    | (2 -- 2)%(--) 2 2 |
}

G1:Vocal2@|0| {
    <8*>
    | 2 - 5 3 |
    /* 旋 轉 */
    | 2 2 3 3 |
    /* 槍法 引伊 */
    | (1 6_)%(-) 1 1 6_ |
    /* 精神 分 */
    | (5_ -- 5)%(--) 5_ 5_ |
    /* 散 ， */
    | 2 7_ 6_ 5_ |
    /* 殺 退 */
    | 6_ - 2 7_ |
    /* 番 兵 */
    | 6_ - - - |
    /* 啊 */
    | 6_ 0 0 - |
    | 2 0 5_ 0 |
    /* 保 江 */
    | 6_ 0 0 - |
    /* 山 。 */
}

-> ChangChui
-> GeGe
-> Intro
-> A1 -> A2
-> B1 -> B2 -> ChangChui -> DuoTou -> GeGe -> B3
-> C1 -> C2
-> D1 -> D2 -> ChangChui -> D3
-> E1 -> E2
-> F1
-> F2 -> F3
-> G1
-> #

