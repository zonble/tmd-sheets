::SCORE::
** 古早七字仔 男 **
!= 100
?= C
~ "origin: https://twoperapf.org.tw/resource/sheet-music/201"
<2/4>

Intro:Piano@|0| {
    <4*>
    | 5 (5 3)%(-) | 1 (2 3)%(-) | (5 3)%(-) (2 1)%(-) | 5_ - |
    | 5 (5 3)%(-) | 1 (2 3)%(-) | (5 3)%(-) (2 1)%(-) | 7,_ - |
    | (5_ -- 6_)%(-) (1 2)%(-) | 1 - | (5_ 6_)%(-) (5_ 0)%(-) | (2 1)%(-) (2 0)%(-) |
    | 5 (5 3)%(-) | (2 --2)%(--) | (5 2)%(-) (5 3)%(-) | (2 0)%(-) (2 0)%(-) |
}

A1:Vocal@|0| {
    <4*>
    | 3_ (5_3_)%(-) | 5_ (3_5_)%(-) | 3_ (2_ 1_)%(-) | 5_- |
    /* 清早起來啊 欸啊*/
}

A2:Piano@|-1| {
    <4*>
    | (0 - - 6_)%(--) | 5_ (5 3)%(-) | (2 3)%(-) (1 2)%(-) | 5_ - |
}

B1:Vocal@|0| {
    <4*>
    | (6__ 6__ - - 1_ 2_)%(--) | (3__ - - 5_)%(--) | 3_ - |
    /* 鬧欸猜猜 */
    | 2_ (3_ 5_)%(-) | 6__ (3_ 2_)%(-) | 1_ 6__ |
    /* 王婆起來啊 */
    | (3_ 3_)%(-) (2_ 1_)%(-) | 3_ 6__ | 3__ 6__ | 5__ - |
    /* 掛欸店牌呀*/

}
B2:Piano@|-1| {
    <4*>
    | (0 -- 4')%(--) |
    | (2 3)%(-) (12)%(-) | (5_ -- 6_)%(--) | 5_ (53)%(-) | (2 3)%(-) (1 2)%(-) | 5_ - |
}

C1:Vocal@|0| {
    <4*>
    | 5__ (3_ 5__)%(-) | 2_ (3_ 5_)%(-) | 3_ - |
    /* 店牌掛落啊欸 */
    | (3_ 5_ - 3_)%(--) | 5_ 6__ |
    /* 真啊清彩 */
}

C2:Piano@|0| {
