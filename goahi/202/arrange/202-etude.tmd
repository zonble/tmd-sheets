    | 6___+6__ 1_ 3_ 6_ 1 3 6 1^ |
    /* 無人管 */
    | 1___+1__ 1__ 3_+5_ 1__ 2___+2__ 2__ 4_+6_ 2__ |
    | 3___+3__ - - - 6___+6__ - - - |
    /* 思念三姐 */
    {p}
    | 5___+5__ 5__ 7,__ 5__ 3___+3__ 3__ 5__ 3__ |
    | 6___+6__ 6__ 1_ 6__ 1___+1__ 1__ 3_ 1__ |
    | 3___+3__ 3__ 5__ 3__ 6___+6__ 6__ 1_ 6__ |
