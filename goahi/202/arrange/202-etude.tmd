/* ==================== 6. [唱腔] C1: 放下西涼・思念三姐王寶釧 (11 bars) ==================== */
/* 右手彈 Vocal 簡單旋律，左手伴奏極端複雜 */

C1:PianoRH@|0| {
    <16*>
    /* 放下西涼 */
    {ff}
    | 5^+5^^ - 3^+3^^ - 2^+2^^ - - - |
    | 3^+3^^ - 5^+5^^ - 2^+2^^ - - - |
    | 3^+3^^ - - - (3^ 5^ 6^ 1^^ 2^^ 3^^)%(----) |
    /* 無人管 */
    | 1^+1^^ - - - 2^+2^^ - - - |
    | 3^+3^^ - - - 6_+6 - - - |
    /* 思念三姐 (Cantabile rubato: 晶瑩高音夜曲跑句) */
    {p}
    | 5_+5 - - - 3_+3 - - - |
    | 6_+6 - - - 1+1^ - - - |
    | 3+3^ - - - (3 5 6 1^ 2^ 3^ 5^ 6^)%(----) |
    /* 王寶釧 */
    | 2^+2^^ - 1^+1^^ - - - 2^+2^^ - |
    | 3^+3^^ - - - 6_+6 - - - |
    | 1+1^ - - - (1^ 3^ 5^ 1^^ 3^^ 5^^ 1^^^ 3^^^)%(----) |
}

