::SCORE::
** 古早七字仔 女 **
!= 100
?= F
~ "origin: https://twoperapf.org.tw/resource/sheet-music/201"
<2/4>

Intro:Piano@|0| {
    <4*>
    | 5 (5 3)%(-) | 1 (2 3)%(-) | (5 3)%(-) (2 1)%(-) | 5_ - |
    | 5 (5 3)%(-) | 1 (2 3)%(-) | (5 3)%(-) (2 1)%(-) | 7,_ - |
    | (5_ -- 6_)%(-) (1 2)%(-) | 1 - | (5_ 6_)%(-) (5_ 0)%(-) | (2 1)%(-) (2 0)%(-) |
    | 5 (5 3)%(-) | (2 --2)%(--) | (5 2)%(-) (5 3)%(-) | (2 0)%(-) (2 0)%(-) |
}

A1:Vocal@|0| {
    <4*>
    | 3 (53)%(-) | 5 (35)%(-) | 3 (2 1)%(-) | 5- |
    /* 清早起來啊 欸啊*/
}

A2:Piano@|-1| {
    <4*>
    | (0 - - 6_)%(--) | 5_ (5 3)%(-) | (2 3)%(-) (1 2)%(-) | 5_ - |
}

B1:Vocal@|0| {
    <4*>
    | (6_ 6_ -- 12)%(--) | (3_ -- 5)%(--) | 3 - |
    /* 鬧欸猜猜 */
    | 2 (3 5)%(-) | 6_ (32)%(-) | 1 6_ |
    /* 王婆起來啊 */
    | (33)%(-) (21)%(-) | 3 6_ | 3_ 6_ | 5_ - |
    /* 掛欸店牌呀*/
}
B2:Piano@|-1| {
    <4*>
    | (0 -- 4')%(--) |
    | (2 3)%(-) (12)%(-) | (5_ -- 6_)%(--) | 5_ (53)%(-) | (2 3)%(-) (1 2)%(-) | 5_ - |
}

C1:Vocal@|0| {
    <4*>
    | 5_ (3 5_)%(-) | 2 (3 5)%(-) | 3 - |
    /* 店牌掛落啊欸 */
    | (3 5 - 3)%(--) | 5 6_ |
    /* 真啊清彩 */
}
C2:Piano@|0| {
    <4*>
    | (5_--6_)%(-) (1 2)%(-) | (5_ 3)%(-) (2 1)%(-) |
    | (5_ -- 6_)%(--) | 5_ (5 3)%(-) |
    | (2 3)%(-) (1 2)%(-) | 5_ - |
}

D1:Vocal@|0| {
    <4 *>
    | 2 (3 5)%(-) | 6_ (32)%(-) | (1 -- 6_)%(--) |
    /* 等待客官 */
    | (33)%(-) (21)%(-) | 3 6_ | 3_ 6_ | 5_ - |
    /* 對欸遮來呀 */
    | 2 (3 5)%(-) | (3 2)%(-) (1 6_)%(-) | 3_ 6_ |
    /* 客倌對遮來呀 */
}

Outro:Piano@|0| {
    <4*>
