::SCORE::
** 七字調 **
!= 100
?= E,
~ "origin: https://twoperapf.org.tw/resource/sheet-music/202"
<2/4>

Intro:Piano@|0| {
    <8*>
    | 0 0 6 - |
    | 3 - (6_ - - 5)%(--) |
    | 3 6 5 2 |
    | 3 - - - |
}

A1:Vocal1@|0| {
    <8 *>
    | 5 - 2 3 | 2 - 5 - | 3 - - - |
    /* 身騎白馬 */
}

A2:Piano@|-1| {
    <8*>
    | (0 - - 5)%(--) 2 1 | 6_3_ 6_ 1 | 6_- (5 -- 6)%(--) | 3 5 2 1 | 6_ - - - |
}

B1:Vocal1@|0| {
    <8*>
    | 5 3 2 - | 3 - - - | - - - - |
    /* 走三關*/
    | 3 - 6_ - | 3 2 3 - | 3 - - - |
    /* 身換素衣 */
    | 3 5 - 3 | 2 1 6_ 1 | 5_ 6_ - - |
    /* 回中原 */
}
B2:Piano@|-1| {
    <8*>
    | 0 0 3 6 |
    | 5 - (6 5)%(--) | 3 5 2 1 | 6_ 3_ 6_ 1 | 6_ - (5 6)%(--) |
    | 3 5 2 1 | 6_ - - - |
}

C1:Vocal1@|0| {
    <8*>
    | 5 3 2 - | 3 5 2 - | 3 - - - |
    /* 放下西涼*/
    | 1 - 2 - | (3 6_ - -)%(----) |
    /* 無人管 */
    | 5_ - 3_ - | 6_ - 1 - | 3 - - - |
    /* 思念三姐 */
    | 2 1 - 2 | 3 - 6_ - | 1 - - - |
    /* 王寶釧 */
}

C2:Piano@|-1| {
    <8*>
    | 0 0 3 6 | 5 - 0 6 |
    | 5 - 3 6 | 5 - 1^ - | 6 5 3 6 | 5 - 0 6 |
    | 5 - 3 6 | 5 - 1^ - | 6 5 3 6 | 5 - 0 6 |
}

D1:Vocal2@|0| {
    <8*>
    | 5 3 2 3 | 5 - 5 - | 3 - - - |
    /* 四盆牡丹哪 */
}

D2:Piano@|-1| {
    <8*>
    | (0 -- 5)%(--) (2 3 1-)%(--) | 6_ 3_ (6 - 23)%(--) |
    | 1 6_ (5_ 6_ - 5_)%(--) | 3_ (3 5 2 3)%(--) 1 | 6_ - - - |
}

E1:Vocal2@|0| {
    <8*>
    | 2 - 5 3 | - - - - | - - - - |
    /* 在四位 */
    | 3 5 - 3 | 2 (1 2)%(-) 3 - | 6_ - - - |
    /* 無風無雨*/
    | 5_ - - 3 | 2 (1 2)%(-) 6_ - | 1 - - - |
    /* 花袂開*/
}

E2:Piano@|-1| {
    <8*>
    | 0 (3_ 5_ 6_ 1)%(--) | 5_ - 6_ (5_ 6_)%(-) |
    | (3 -- 5)%(--) (2 3)%(-) 1 | 6_ 3_6_ (2 3)%(-) |
    | 1 6_ 5_ (6_ 5_)%(-) | 3_ (3 5 2 3)%(--) 1 | 6_ - - - |
}

F1:Vocal2@|0| {
    <8 *>
    | 3 6_ - - | (2 --3)%(--) 5 - | 3 - - - |
    /* 等待三更啊 */
    | (3 2 3 2)%(--) 1 2 | 3 6_ - - |
    /* 凍霜水 */
    | 1 - 3_ - | 6_ - 1 - | 3 - - - |
    /* 呀凍著花心嘛 */
    | 5 - - 3 | 2 (1 2)%(-) 6_ - | 1 - (3_ 5_ 6_ 1)%(--) | 5_ - - - |
    /* 花齊開 */
    | 2 3 - 6_ | 3 - 1 2 | 3 - - - |
}

Outro:Piano@|-1| {
    <8*>
    | 0 0 (6 - - 5)%(--) | 3 6 5 3 | 2 6_ (3 - - 2)%(--) |
    | 1 3 (2 3)%(-) 1 | 6_ - - - |
}

-> Intro
-> A1 -> A2
-> B1 -> B2
-> C1 -> C2
-> D1 -> D2
-> E1 -> E2
-> F1
