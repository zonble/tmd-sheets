    | {mp} 6__ - 3_ - | 6__ 5__ 6__ - | 6__ 3_ 2_ 1_ |
    | {f} 1_ - 3_ - | 2_ 1_ 6__ 1_ | 5__ 6__ - - |
}

B1:Contrabass@|0| {
