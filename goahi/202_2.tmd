    | {mp} 6__ 3__ | 6__ 5__ | 6__ 3__ |
    | {f} 1_ 3_ | 2_ 6__ | 5__ 6__ |
}

B1:Trombone@|0| {
    <4*>
    | {f} 5_ 2_ | 3_ - | 6_ - |
    | 0 0 | 0 0 | 0 0 |
    | {mf} 1 3_ | 2_ 6_ | 5_ 6_ |
}

B1:Tuba@|0| {
    <4*>
    | {f} 5___ 2__ | 6___ - | 6___ - |
    | 0 0 | 0 0 | 0 0 |
    | {mf} 1__ 3__ | 2__ 6___ | 5___ 6___ |
}

B1:Violin2@|0| {
    <8*>
    | {f} 2 1 5_ 2 | 1 6_ 1 2 | 3 2 1 6_ |
    | {mp} 1 6_ 3_ 6_ | 1 6_ 1 2 | 1 6_ 5_ 6_ |
    | {f} 1 3 2 1 | 6_ 5_ 3_ 5_ | 3_ 6_ 3_ - |
}

B1:Viola@|0| {
    <8*>
    | {f} 5_ 5_ 2_ 5_ | 6_ 3_ 6_ 1 | 6_ 5_ 3_ 2_ |
    | {mp} 6_ 3_ 6_ 3_ | 6_ 5_ 6_ - | 6_ 3_ 5_ 6_ |
    | {f} 6_ 1 6_ 5_ | 2_ 3_ 6_ 5_ | 3_ 6_ 3_ - |
}

B1:Cello@|0| {
    <8*>
