::SCORE::
** 新一軍軍歌 (管弦進行曲) **
!= 116  /* 進行曲步速：每分鐘 116 拍 (Tempo di Marcia) */
?= C    /* 原曲 C 大調 */
<4/4>
~ "詞: 孫熙澤"
~ "曲: 應雪痕"
~ "編制: 管弦進行曲 (Orchestral March with Military Snare)"

/* ========================================================================= */
/* 前奏 (Intro, 4 小節)：軍鼓行軍節拍切入，銅管高亢吹響號角動機，定音鼓重擊進入 */
/* ========================================================================= */

Intro:Trumpet@|0| {
    <4*>
    /* 遠方號角至全體吹響 (Fanfare) */
    | 0 - 0 (5_ 1)%(-) | 3 - - (1 3)%(-) | 5 - (5 6 5 4)%(--) | 3 - 0 0 |
}

Intro:FrenchHorn@|0| {
    <4*>
    | 0 - - - | 1_ - - (1_ 3_)%(-) | 5_ - (5_ 6_ 5_ 4_)%(--) | 3_ - 0 0 |
}

Intro:Trombone@|0| {
    <4*>
    | 0 - - - | 1_ 0 5__ 0 | 1_ 0 5__ 0 | 1_ 5__ 1_ 0 |
}

Intro:Flute@|0| {
    <4*>
    | 0 - - - | 0 - - (1^ 3^)%(-) | 5^ - (5^ 6^ 5^ 4^)%(--) | 3^ - 0 0 |
}

Intro:Violin@|0| {
    <4*>
    | 0 - 0 (5 1^)%(-) | 3^ - - (1^ 3^)%(-) | 5^ - (5^ 6^ 5^ 4^)%(--) | 3^ - 0 0 |
}

Intro:Viola@|0| {
    <4*>
    | 0 - - - | 5_ 0 5_ 0 | 1 0 7_ 0 | 5_ - 0 0 |
}

Intro:Cello@|0| {
    <4*>
    | 0 - - - | 1_ 0 5__ 0 | 1_ 0 5__ 0 | 1_ 5__ 1_ 0 |
}

Intro:Contrabass@|0| {
    <4*>
    | 0 - - - | 1__ 0 5___ 0 | 1__ 0 5___ 0 | 1__ 0 1__ 0 |
}

Intro:Timpani@|0| {
    <4*>
    | 0 - - - | 1__ 0 5___ 0 | 1__ 0 5___ 0 | 1__ - 1__ 0 |
}

Intro:Drums@|0| {
    <8*>
    /* 軍鼓 Cadence 切入，大鼓第 1、3 拍步操重音，最後一小節滾奏衝入主歌 */
    | 0 - - - 0 - - - | B - S - X - S S | B - S - X - S S | B - S S S S S S |
}


/* ========================================================================= */
/* 主歌段 (March, 14 小節)：全體管弦進行曲，英勇剛毅，軍鼓連續推進             */
/* ========================================================================= */

March:Trumpet@|0| {
    <4*>
    /* 吾軍欲發揚 精誠 */
    /* 第一體要壯 筋骨 */
    /* 道德要提倡 禮義 */
    /* 大任一身當 當仁 */
    | 5 1 (1 - - 2)%(--) | (3 - - 1)%(--) 5_ 5_ |
    /* 團結無欺罔 矢志 */
    /* 鍛如百煉鋼 暑雨 */
    /* 廉恥四維張 誰給 */
    /* 于師亦不讓 七尺 */
    | (2 - - 1)%(--) 7_ 2 | 5 - 0 (1 1)%(-) |
    /* 救國亡 猛士力能守四 */
    /* 無怨傷 寒冬不畏冰雪 */
    /* 我們餉 百姓脂膏公家 */
    /* 何昂昂 常將天職記心 */
    | 6 5 4 (2 -- 2)%(-) | 5 (3 -- 1)%(-) 2 3 |
    /* 方 不怕刀和槍 勢把敵人 */
    /* 霜 勞苦是尋常 飢咽秕與 */
    /* 糧 步步自堤防 驕縱與貪 */
    | 1 0 (3 -- 2 1 -- 7_)%(--) | 6_ 0 (2 - - 6_ 7_ - - 6_)%(--) |
    /* 降 親上死長 效命疆 */
    /* 糠 臥薪何妨 膽亦能 */
    /* 贓 長官榜樣 軍國規 */
    /* 康 為民榜樣 為國棟 */
    | 5_ 0 (5_ -- 5_ 7_ -- 3_)%(--) | 5 - (5 - 1 3)%(-) 6 |
    /* 場 才算好兒 */
    /* 嚐 齊學勾踐 */
    /* 章 時刻不可 */
    /* 梁 即為本軍 */
    | 6 - - (0 2)%(-) | 5 (3 -- 1)%(-) 2 - |
    /* 郎 */
    /* 王 */
    /* 忘 */
    /* 光 */
    | 1 - - - | 0 - 0 (5_ 1)%(-) |
}

March:Violin@|0| {
    <4*>
    | 5 1 (1 - - 2)%(--) | (3 - - 1)%(--) 5_ 5_ |
    | (2 - - 1)%(--) 7_ 2 | 5 - 0 (1 1)%(-) |
    | 6 5 4 (2 -- 2)%(-) | 5 (3 -- 1)%(-) 2 3 |
    | 1 0 (3 -- 2 1 -- 7_)%(--) | 6_ 0 (2 - - 6_ 7_ - - 6_)%(--) |
    | 5_ 0 (5_ -- 5_ 7_ -- 3_)%(--) | 5 - (5 - 1 3)%(-) 6 |
    | 6 - - (0 2)%(-) | 5 (3 -- 1)%(-) 2 - |
    | 1 - - - | 0 - 0 (5 1^)%(-) |
}

March:Flute@|0| {
    <4*>
    | 5^ 1^ (1^ - - 2^)%(--) | (3^ - - 1^)%(--) 5 5 |
    | (2^ - - 1^)%(--) 7 2^ | 5^ - 0 (1^ 1^)%(-) |
    | 6^ 5^ 4^ (2^ -- 2^)%(-) | 5^ (3^ -- 1^)%(-) 2^ 3^ |
    | 1^ 0 (3^ -- 2^ 1^ -- 7)%(--) | 6 0 (2^ - - 6 7 - - 6)%(--) |
    | 5 0 (5 -- 5 7 -- 3)%(--) | 5^ - (5^ - 1^ 3^)%(-) 6^ |
    | 6^ - - (0 2^)%(-) | 5^ (3^ -- 1^)%(-) 2^ - |
    | 1^ - - - | 0 - 0 (5^ 1^^)%(-) |
}

March:Clarinet@|0| {
    <4*>
    /* 木管中音副旋律與流暢襯托 */
    | 3 5 5 - | 5 3 3 1 | 7_ 2 4 - | 2 4 3 5 |
    | 1^ 7 6 - | 7 5 4 5 | 3 5 3 - | 4 6 4 - |
    | 2 5 2 - | 3 5 5 1^ | 1^ - - 6 | 7 5 4 - |
    | 3 - - - | 0 - 0 (5 1^)%(-) |
}

March:FrenchHorn@|0| {
    <4*>
    /* 雄渾圓號和聲支持 */
    | 1 0 1 0 | 1 0 1_ 0 | 5_ 0 5_ 0 | 7_ 0 1 0 |
    | 1 0 1 0 | 1 0 7_ 0 | 1 0 1 0 | 1 0 7_ 0 |
    | 7_ 0 5_ 0 | 1 0 1 0 | 1 - - 1 | 1 0 7_ - |
    | 1 - - - | 0 - - - |
}

March:Trombone@|0| {
    <4*>
    /* 進行曲長號低音切分與威武對位 */
    | 1_ 0 5__ 0 | 1_ 0 5__ 0 | 5__ 0 2_ 0 | 5__ 0 1_ 0 |
    | 4_ 0 1_ 0 | 1_ 0 5__ 0 | 1_ 0 6__ 0 | 2_ 0 2_ 0 |
    | 5__ 0 5__ 0 | 1_ 0 1_ 0 | 4_ 0 4_ 0 | 5__ 0 5__ 0 |
    | 1_ 0 5__ 0 | 1_ - 0 0 |
}

March:Viola@|0| {
    <4*>
    | 3_ 0 5_ 0 | 5_ 0 3_ 0 | 4_ 0 2_ 0 | 4_ 0 3_ 0 |
    | 6_ 0 4_ 0 | 3_ 0 2_ 0 | 3_ 0 1_ 0 | 2_ 0 4_ 0 |
    | 2_ 0 7__ 0 | 1_ 0 3_ 0 | 4_ 0 6_ 0 | 5_ 0 4_ 0 |
    | 3_ - - - | 0 - - - |
}

March:Cello@|0| {
    <4*>
    /* 大提琴渾厚行軍低音步伐 (Root - Fifth Marching Bass) */
    | 1_ 0 5__ 0 | 1_ 0 5__ 0 | 5__ 0 2_ 0 | 5__ 0 1_ 0 |
    | 4_ 0 1_ 0 | 1_ 0 5__ 0 | 1_ 0 6__ 0 | 2_ 0 2_ 0 |
    | 5__ 0 5__ 0 | 1_ 0 1_ 0 | 4_ 0 4_ 0 | 5__ 0 5__ 0 |
    | 1_ 0 5__ 0 | 1_ - 0 0 |
}

March:Contrabass@|0| {
    <4*>
    /* 低音提琴重步操步伐 */
    | 1__ 0 5___ 0 | 1__ 0 5___ 0 | 5___ 0 2__ 0 | 5___ 0 1__ 0 |
    | 4__ 0 1__ 0 | 1__ 0 5___ 0 | 1__ 0 6___ 0 | 2__ 0 2__ 0 |
    | 5___ 0 5___ 0 | 1__ 0 1__ 0 | 4__ 0 4__ 0 | 5___ 0 5___ 0 |
    | 1__ 0 5___ 0 | 1__ - 0 0 |
}

March:Timpani@|0| {
    <4*>
    | 1__ 0 5___ 0 | 1__ 0 5___ 0 | 5___ 0 1__ 0 | 5___ 0 1__ 0 |
    | 1__ 0 1__ 0 | 1__ 0 5___ 0 | 1__ 0 1__ 0 | 5___ 0 5___ 0 |
    | 5___ 0 5___ 0 | 1__ 0 1__ 0 | 1__ 0 1__ 0 | 5___ 0 5___ 0 |
    | 1__ 0 5___ 0 | 1__ - 0 0 |
}

March:Drums@|0| {
    <8*>
    /* 行軍軍鼓 (Snare)、大鼓 (Bass Drum B) 與銅鈸節奏 */
    | B - S - X - S S | B - S - X - S S | B - S - X - S S | B - S - X - S S |
    | B - S - X - S S | B - S - X - S S | B - S - X - S S | B - S - X - S S |
    | B - S - X - S S | B - S - X - S S | B - S - X - S S | B - S - X - S S |
    | B - S - X - S S | B - S S S S S S |
}


/* ========================================================================= */
/* 尾奏 (Outro / Coda, 4 小節)：全體管弦與軍鼓合奏凱旋終止式，強烈齊奏收尾 */
/* ========================================================================= */

Outro:Trumpet@|0| {
    <4*>
    /* 凱旋號角高鳴 */
    | 3 - - (1 3)%(-) | 5 - - (3 5)%(-) | 1^ - 7 2^ | 1^ - - 0 |
}

Outro:FrenchHorn@|0| {
    <4*>
    | 1_ - - (1_ 3_)%(-) | 3_ - - (3_ 5_)%(-) | 5_ - 4_ 5_ | 3_ - - 0 |
}

Outro:Trombone@|0| {
    <4*>
    | 1_ 0 5__ 0 | 1_ 0 5__ 0 | 5__ 0 5__ 0 | 1_ - - 0 |
}

Outro:Flute@|0| {
    <4*>
    | 3^ - - (1^ 3^)%(-) | 5^ - - (3^ 5^)%(-) | 1^^ - 7^ 2^^ | 1^^ - - 0 |
}

Outro:Violin@|0| {
    <4*>
    | 3^ - - (1^ 3^)%(-) | 5^ - - (3^ 5^)%(-) | 1^^ - 7^ 2^^ | 1^^ - - 0 |
}

Outro:Viola@|0| {
    <4*>
    | 5_ 0 1 0 | 1 0 3 0 | 4 0 5 0 | 3 - - 0 |
}

Outro:Cello@|0| {
    <4*>
    | 1_ 0 5__ 0 | 1_ 0 5__ 0 | 5__ 0 5__ 0 | 1_ - - 0 |
}

Outro:Contrabass@|0| {
    <4*>
    | 1__ 0 5___ 0 | 1__ 0 5___ 0 | 5___ 0 5___ 0 | 1__ - - 0 |
}

Outro:Timpani@|0| {
    <4*>
    | 1__ 0 5___ 0 | 1__ 0 5___ 0 | 5___ 5___ 5___ 5___ | 1__ - - 0 |
}

Outro:Drums@|0| {
    <8*>
    /* 軍鼓強烈推進、連續滾奏與最終強拍重擊 */
    | B - S - X - S S | B - S - X - S S | S S S S S S S S | C - - - 0 - - - |
}

/* ========================================================================= */
/* 演奏流程：前奏 -> 三段歌詞的主歌進行曲輪番高歌 -> 尾奏凱旋終止            */
/* ========================================================================= */

-> Intro
-> March
-> March
-> March
-> March
-> Outro
->#
