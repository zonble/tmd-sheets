/* =========================================================================
   B 段 (16 小節)
   極端強弱反差：
   - 前兩小節（3 3 3 3 3 3 3 3 | 2 2 2 2 2 2 2 2）全團完全靜音，只留卡祖笛獨奏！
   - 一遇到第 3 小節的 `6_`（與第 7 小節的 `3`），五部銅管（Trumpet / FrenchHorn / BrassSection / Trombone / Tuba）
     與雙電吉他、貝斯同時轟出毫無切分裝飾、整整兩小節（8 拍不中斷）的 {ff} 巨型長音！
   ========================================================================= */

B:Harmonica@|0| {
    <8*>
    {ff}
    | 3 3 3 3 3 3 3 3 | 2 2 2 2 2 2 2 2 | 6_ - - - - - - 6_ | 6_ - - - - - 1 2 |
    | 3 3 3 3 3 3 5 3 | 2 2 2 2 2 2 2 2 | 3 - - - - - - 3 | 3 - - - - - 1 2 |
    | 3 3 3 3 3 3 3 3 | 2 2 2 2 2 2 2 2 | 6_ - - - - - - 6_ | 6_ - - - - - 1 2 |
    | 3 3 3 3 3 3 5 3 | 2 2 2 2 2 2 2 2 | 3 - - - - - - 3 | 3 - - - - - 1 2 |
}

B:Trumpet@|0| {
    <1*>
    {ff}
    /* 整整兩小節（8 拍）不換氣、不切分的巨型銅管長音！ */
    | 0 | 0 | 6 | - |
    | 0 | 0 | 3^ | - |
    | 0 | 0 | 6 | - |
    | 0 | 0 | 3^ | - |
}

B:FrenchHorn@|0| {
    <1*>
    {ff}
    /* 法國號中音區飽滿的 8 拍長音號角 */
    | 0 | 0 | 3 | - |
    | 0 | 0 | 7 | - |
    | 0 | 0 | 3 | - |
    | 0 | 0 | 7 | - |
}

B:BrassSection@|0| {
    <1*>
    {ff}
    /* 銅管合奏群 8 拍不中斷長音齊鳴 */
    | 0 | 0 | 1^ | - |
    | 0 | 0 | 5^ | - |
    | 0 | 0 | 1^ | - |
    | 0 | 0 | 5^ | - |
}

B:Trombone@|0| {
    <1*>
    {ff}
    /* 長號中低音 8 拍不中斷巨型長音 */
    | 0 | 0 | 6_ | - |
    | 0 | 0 | 3 | - |
    | 0 | 0 | 6_ | - |
    | 0 | 0 | 3 | - |
}

B:Tuba@|0| {
    <1*>
    {ff}
