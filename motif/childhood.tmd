::SCORE::
** 童年約定 - 純真童年 (Childhood) **
!= 112
?= C
Key= C
<4/4>

/* ===================================================
   段落：Childhood（純真童年）
   主奏：Glockenspiel（鐘琴/鐵琴），高音清脆跳躍斷奏
   伴奏：AcousticGuitar（木吉他），輕柔民謠分散和弦
   =================================================== */

/* 主奏鐵琴：高音八度、八分音符斷奏與跳躍律動 */
Childhood:Glockenspiel@|0|{
    <8*>
    /* 第 1-2 小節：核心動機 (1 2 3 5 | 3 - - -) 斷奏跳躍化 */
    1^ 0 2^ 0 3^ 0 5^ 0 | 3^ - 0 5^ 3^ 0 0 0 |

    /* 第 3-4 小節：問句發展（俏皮下行與半終止懸念） */
    2^ 0 3^ 0 2^ 0 1^ 0 | 2^ - 0 5^ 2^ - 0 0 |

    /* 第 5-6 小節：動機再現（躍升至高音 6^，如銀鈴般雀躍） */
    1^ 0 2^ 0 3^ 0 5^ 0 | 6^ - 0 1^^ 6^ 0 5^ 0 |

    /* 第 7-8 小節：答句解決（溫柔收斂回主音 1^） */
    3^ 0 5^ 0 2^ 0 3^ 0 | 1^ - - - 0 0 0 0 |
}

/* 木吉他伴奏：民謠分解和弦 (Folk Fingerpicking) */
Childhood:AcousticGuitar@|0|{
    <8*>
    /* 第 1-2 小節：[C] 和弦溫暖流動 */
    1_ 5_ 1 3 5_ 1 3 5_ | 1_ 5_ 1 3 5_ 1 3 5_ |

    /* 第 3-4 小節：[Fmaj7] -> [G] 民謠色彩進展 */
    4_ 6_ 1 3 6_ 1 3 6_ | 5__ 7_ 2 5 7_ 2 5 7_ |

    /* 第 5-6 小節：[C] -> [Am] 回憶敘事感 */
    1_ 5_ 1 3 5_ 1 3 5_ | 6__ 3_ 6_ 1 3_ 6_ 1 3_ |

    /* 第 7-8 小節：[Dm7] -> [G7] -> [C] 柔和終止 */
    2_ 6_ 1 4 5__ 7_ 2 5 | 1_ 5_ 1 3 1_ - - - |
}

/* 和弦標記軌：方便閱讀與後續樂譜導出 */
Childhood:CHORD@|0|{
    <1*>
    [C] | [C] |
    [Fmaj7] | [G] |
    [C] | [Am] |
    <2*>
    [Dm7] [G7] | [C] - |
}

-> Childhood ->#

