::SCORE::
** 勇者傳說：夏日祭典「勇者音頭」 (Hero Ondo - Matsuri Festival) **
!= 124
?= C
Key= C
<4/4>

/* =========================================================================
   【勇者音頭（Hero Ondo）】
   背景設定：魔王討伐成功後，新手村舉行一年一度夏日盆踊大祭典！
   村民們身穿浴衣、手持團扇，圍著高台（櫓 Yagura）載歌載舞。

   音樂特徵：
   1. 樂器編制：
      - 篠笛 / 尺八 (Shakuhachi / Shinobue)：高亢悠揚的祭典笛音
      - 三味線 (Shamisen)：清脆鏗鏘的撥弦骨幹音
      - 古箏 (Koto)：如流水碎步的優雅五聲反拍
      - 和太鼓 (Taiko)：大太鼓低沉地動的「咚咚」震動
      - 祭典鼓組 (Drums)：締太鼓與鉦鈴「咚咚鏘、咚恰咚恰」盆踊節奏
   2. 旋律轉化：
      - ヨナ抜き（1 2 3 5 6）五聲音階天然契合和風祭典！
      - 在樂句中加入休止留白，讓村民呼喊「ハッ！」「ソレ！」「ヨイヨイ！」
   ========================================================================= */

/* -------------------------------------------------------------------------
   段落一：祭り囃子・前奏 (Intro)
   太鼓震地、三味線起手、竹笛引吭高歌
   ------------------------------------------------------------------------- */
Intro:Shakuhachi@|0|{
    <8*>
    0 - - - - - - - | 0 - - - 5_ - 1 - |
    2 - 3 - 5 - 6 - | 5 - - - - - 0 0 |
}

Intro:Shamisen@|0|{
    <8*>
    1_ 1_ 0 1_ 5__ 5__ 0 5__ | 1_ 1_ 0 1_ 5__ 5__ 0 5__ |
    1_ 1_ 0 1_ 2_ 2_ 0 2_ | 5__ 5__ 0 5__ 5__ - 0 0 |
}

Intro:Taiko[pitchMode=fixed]@|0|{
    <8*>
    1_ - 0 1_ 1_ - 0 0 | 1_ - 0 1_ 1_ - 0 0 |
    1_ - 0 1_ 1_ - 0 1_ | 1_ 1_ 1_ 1_ 1_ - 0 0 |
}

Intro:Drums@|0|{
    <8*>
    B 0 B 0 S 0 B 0 | B 0 B 0 S 0 S S |
    B 0 B 0 S 0 B 0 | S S S S S - C 0 |
}

/* -------------------------------------------------------------------------
   段落二：勇者音頭・主歌 (Ondo)
   村民齊跳「勇者舞步」，竹笛吹奏主人公主題，長音處留白呼喊！
   ------------------------------------------------------------------------- */
Ondo:Shakuhachi@|0|{
    <8*>
    /* 第 1-2 小節：動機起步，留空給喊聲「ハッ、ソレ！」 */
    1^ - 1^ 5 1^ 5 1^ 2^ | 3^ - 1^ - 5^ - 0 0 |

    /* 第 3-4 小節：問句級進，留空給喊聲「ヨイヨイ！」 */
    2^ - 2^ 1^ 2^ 1^ 6 2^ | 3^ 2^ 1^ 2^ 3^ - 0 0 |

    /* 第 5-6 小節：動機再現，旋律如夏風揚起 */
    1^ - 1^ 5 1^ 5 1^ 2^ | 3^ - 1^ - 3^ - 5^ - |

    /* 第 7-8 小節：祭典終止式，眾人同踏步 */
    2^ 3^ 2^ 1^ 3^ - 2^ - | 1^ - - - - - 0 0 |
}

Ondo:Shamisen@|0|{
    <8*>
    /* 三味線鏗鏘有力的跳音律動 */
    1_ 0 1_ 5__ 1_ 0 1_ 2_ | 3_ 0 1_ 0 5_ - 0 0 |
    2_ 0 2_ 1_ 2_ 0 6__ 2_ | 3_ 0 1_ 0 3_ - 0 0 |
    1_ 0 1_ 5__ 1_ 0 1_ 2_ | 3_ 0 1_ 0 3_ 0 5_ 0 |
    2_ 0 3_ 0 1_ 0 2_ 0 | 1_ - 0 1_ 1_ - 0 0 |
}

Ondo:Koto@|0|{
    <8*>
    /* 古箏反拍碎步輕拂 */
    0 1 0 5_ 0 1 0 3 | 0 5 0 3 0 5 0 0 |
    0 2 0 6_ 0 2 0 5 | 0 3 0 2 0 3 0 0 |
    0 1 0 5_ 0 1 0 3 | 0 3 0 5 0 6 0 1^ |
    0 6 0 5 0 3 0 2 | 0 1 0 1 1 - 0 0 |
}

Ondo:Taiko[pitchMode=fixed]@|0|{
    <8*>
    /* 大太鼓沉穩推動音頭步態 */
    1_ - 0 1_ 1_ - 0 0 | 1_ - 0 1_ 5__ - 0 0 |
    1_ - 0 1_ 1_ - 0 0 | 1_ - 0 1_ 1_ - 0 0 |
    1_ - 0 1_ 1_ - 0 0 | 1_ - 0 1_ 5__ - 0 0 |
    1_ - 0 1_ 5__ - 0 0 | 1_ - - - 1_ - 0 0 |
}

Ondo:Drums@|0|{
    <8*>
    /* 盆踊經典鼓點：咚咚鏘、咚恰恰！ */
    B 0 B 0 S 0 B 0 | B 0 B 0 S - S 0 |
    B 0 B 0 S 0 B 0 | B 0 B 0 S - S 0 |
    B 0 B 0 S 0 B 0 | B 0 B 0 S 0 B 0 |
    B 0 S 0 B 0 S 0 | B 0 B 0 C - 0 0 |
}

Ondo:CHORD@|0|{
    <1*>
    [C] | [C] | [Dm] | [C] |
    [C] | [C] |
    <2*>
    [F] [G] | [C] - |
}

/* -------------------------------------------------------------------------
   段落三：間奏・太鼓見せ場與掛け声 (Break)
   太鼓花式連擊、三味線狂飆，祭典氣氛熱烈無比！
   ------------------------------------------------------------------------- */
Break:Shakuhachi@|0|{
    <8*>
    5^ - 6^ - 5^ 3^ 2^ 1^ | 2^ - 3^ - 1^ - - - |
    0 - - - - - - - | 0 - - - 0 0 5 6 |
}

Break:Shamisen@|0|{
    <8*>
    1_ 1_ 0 1_ 2_ 2_ 0 2_ | 3_ 3_ 0 3_ 5_ 5_ 0 5_ |
    6_ 6_ 0 6_ 5_ 5_ 0 5_ | 1_ 1_ 1_ 1_ 1_ - 0 0 |
}

Break:Taiko[pitchMode=fixed]@|0|{
    <8*>
    1_ 1_ 0 1_ 1_ 1_ 0 1_ | 1_ 1_ 0 1_ 1_ 1_ 0 1_ |
    1_ 1_ 1_ 1_ 1_ 1_ 1_ 1_ | 1_ - 0 0 1_ - 0 0 |
}

Break:Drums@|0|{
    <8*>
    B B S B B B S B | B B S B B B S B |
    S S S S S S S S | C - 0 0 C - 0 0 |
}

/* -------------------------------------------------------------------------
   段落四：終曲・大團圓 (Finale)
   全員齊唱、大鉦齊鳴、夏夜煙火盛放！
   ------------------------------------------------------------------------- */
Finale:Shakuhachi@|0|{
    <8*>
    1^ - 1^ 5 1^ 5 1^ 2^ | 3^ - 1^ - 5^ - - - |
    2^ - 2^ 1^ 2^ 1^ 6 2^ | 3^ 2^ 1^ 2^ 3^ - - - |
    1^ - 1^ 5 1^ 5 1^ 2^ | 3^ - 1^ - 3^ - 5^ - |
    6^ - 5^ - 3^ - 2^ - | 1^ - - - - - - - |
}

Finale:Shamisen@|0|{
    <8*>
    1_ 0 1_ 5__ 1_ 0 1_ 2_ | 3_ 0 1_ 0 5_ 0 5_ 0 |
    2_ 0 2_ 1_ 2_ 0 6__ 2_ | 3_ 0 1_ 0 3_ 0 3_ 0 |
    1_ 0 1_ 5__ 1_ 0 1_ 2_ | 3_ 0 1_ 0 3_ 0 5_ 0 |
    4_ 0 5__ 0 5_ 0 5_ 0 | 1_ 1_ 1_ 1_ 1_ - 0 0 |
}

Finale:Koto@|0|{
    <8*>
    1 5 1^ 3^ 1^ 5 3 5_ | 1 5 1^ 3^ 1^ 5 3 5_ |
    2 6 2^ 4^ 2^ 6 4 6_ | 3 5 1^ 3^ 1^ 5 3 5_ |
    1 5 1^ 3^ 1^ 5 3 5_ | 1 5 1^ 3^ 1^ 5 3 5_ |
    4 6 1^ 4^ 5 7 2^ 5^ | 1^ - - - - - 0 0 |
}

Finale:Taiko[pitchMode=fixed]@|0|{
    <8*>
    1_ - 0 1_ 1_ - 0 0 | 1_ - 0 1_ 5__ - 0 0 |
    1_ - 0 1_ 1_ - 0 0 | 1_ - 0 1_ 1_ - 0 0 |
    1_ - 0 1_ 1_ - 0 0 | 1_ - 0 1_ 5__ - 0 0 |
    4__ - - - 5__ - - - | 1_ - - - - - - - |
}

Finale:Drums@|0|{
    <8*>
    B 0 B 0 S 0 B 0 | B 0 B 0 S 0 S S |
    B 0 B 0 S 0 B 0 | B 0 B 0 S 0 S S |
    B 0 B 0 S 0 B 0 | B 0 B 0 S 0 B 0 |
    S S S S S S S S | C - - - - - - - |
}

Finale:CHORD@|0|{
    <1*>
    [C] | [C] | [Dm] | [C] |
    [C] | [C] |
    <2*>
    [F] [G] | [C] - |
}

/* =========================================================================
   祭典演奏流程：前奏 -> 盆踊主歌 -> 間奏切分 -> 大終曲
   ========================================================================= */
-> Intro -> Ondo -> Break -> Finale ->#

