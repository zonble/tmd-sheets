/* ========================================================================= */
/* C1 Section (16小節)：                                                     */
/* - 木吉他：連續穩定推進                                                    */
/* - 💥 答題：定音鼓（Timpani）「咚！咚！咚！！」重槌搭配那三個音！          */
/* - 原本的套鼓（Drums）撤掉，讓定音鼓的重擊震撼全場                          */
/* ========================================================================= */

C1:Vocal@|0| {
    <8*>
    /* 起 塵埃飄落 塵埃揚*/
    | 2 - - - - - - - | 0 0 0 0  3 2 3 2 | 1 - - - - - - - | 0 0 0 0 3 2 3 2 |
    /* 起 塵埃飄落 塵埃揚*/
