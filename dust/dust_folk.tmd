    <8*>
    | 2_ 6_ 2_ 3 2_ 6_ 2_ 3 | 1_ 5_ 1_ 3 1_ 5_ 1_ 3 |
    | 1_ 5_ 1_ 3 1_ 5_ 1_ 3 | 2_ 6_ 2_ 3 2_ 6_ 2_ 3 |
