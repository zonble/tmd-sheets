/* ========================================================================= */
/* 主歌 A段 (8小節)：木吉他撥弦 + Bass + 人聲                                */
/* ========================================================================= */

A:Vocal@|0| {
    <8*>
    /* 每片落葉都值得微風 每株飛絮都值得花朵 每顆流星都值得廣闊夜空*/
    | 2 - 2 - 2 1 6_ 5_ | 6_ 1 - - 2 -  1 2 | 3 2 1 5_ 1  2 - - | 1 - - - - - - - |
    /* 每份渺小都值得歌頌 每個孩子都值得笑容 每粒塵埃都值得一塊角落*/
    | 1 - 1 - 1 6_ 5_ 4_ | 1 5_ - - 1 - 6_ -  | 2 - - - - - - - |
    /* (念白) 即便會—— */
    | 0 0 0 0 0 0 0 0 |
}

