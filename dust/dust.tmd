 ::SCORE::
 ** 塵埃 **
 != 140
 ?= C
 <4/4>

A:Vocal@|0| {
    <8*>
    /* 每片落葉都值得微風 每株飛絮都值得花朵 每顆流星都值得廣闊夜空*/
    /* 每份渺小都值得歌頌 每個孩子都值得笑容 每粒塵埃都值得一塊角落 即便會 */
    | 2 - 2 - 2 1 6_ 5_ | 6_ 1 - - 2 -  1 2 | 3 2 1 5_ 1  2 - - | 1 - - - - - - - |
    | 1 - 1 - 1 6_ 5_ 4_ | 1 5_ - - 1 - 6_ -  | 2 - - - - - - - | 0 0 0 0 0 0 0 0 |
}

Chorus:Vocal@|0| {
    <8*>
    /* 沉沒在時間的河裡 沒有一絲餘波*/
    | 2 - 3 - 2 -- 3 | 5 -- 3 2 - 3 2 | 1 - 3  - 2 - - 6_ | 2 - - - - - - - |
    /* 溶解在時間的洋裡 沒有一點泡沫*/
    | 2 - 3 - 2 -- 3 | 5 -- 3 2 - 3 2 | 1 - 6_ - 6_ - - 5_ | 5_ - - - - - - - |
    /* 沉沒在時間的河裡 沒有一絲餘波*/
    | 2 - 3 - 2 -- 3 | 5 -- 3 2 - 3 2 | 1 - 3  - 2 - - 6_ | 2 - - - - - - - |
    /* 溶解在時間的洋裡 沒有一點泡沫*/
    | 2 - 3 - 2 -- 3 | 5 -- 3 2 - 3 2 | 1 - 6_ - 6_ - - 3 | 2 - - - - - - - |
}

Chorus2:Vocal2@|0| {
    <8*>
    /* 漂流在時間的河裡 沒有一絲餘波*/
    | 2 - 3 - 2 -- 3 | 5 -- 3 2 - 3 2 | 1 - 3  - 2 - - 6_ | 2 - - - - - - - |
    /* 溶解在時間的洋裡 沒有一點泡沫*/
    | 2 - 3 - 2 -- 3 | 5 -- 3 2 - 3 2 | 1 - 6_ - 6_ - - 5_ | 5_ - - - - - - - |
    /* 漂流在時間的河裡 沒有一絲餘波*/
    | 2 - 3 - 2 -- 3 | 5 -- 3 2 - 3 2 | 1 - 3  - 2 - - 6_ | 2 - - - - - - - |
    /* 溶解在時間的洋裡 沒有一點泡沫 看塵埃揚*/
    | 2 - 3 - 2 -- 3 | 5 -- 3 2 - 3 2 | 1 - 6_ - 6_ - - 3 | 2 - - - 3 2 3 - |
}

A2 {
    <8*>
    | 2 - 2 - 2 1 6_ 5_ | 6_ 1 - - 2 -  1 2 | 3 2 1 5_ 1  2 - - | 1 - - - - - - - |
    | 1 - 1 - 1 6_ 5_ 4_ | 1 5_ - - 1 - 6_ -  | 2 - - - - - - - | 0 0 0 0 0 0 0 0 |
}


C1:Vocal@|0| {
    <8*>
    /* 起 塵埃飄落 塵埃揚*/
    | 2 - - - - - - - | 0 0 0 0  3 2 3 2 | 1 - - - - - - - | 0 0 0 0 3 2 3 2 |
    /* 起 塵埃飄落 塵埃揚*/
    | 1 - - - - - - - | 0 0 0 0 3 2 3 5 | 2 - - - - - - - | 0 0 0 0  3 2 3  - |
    /* 起 塵埃飄—落— */
    | 2 - - - - - - - | 0 0 0 0  3 2 3 1 | - - - - - - - - | 0 0 0 0 2 - - -  |
    /* 揚起又飄落 看塵埃揚*/
    | 1 - - - - - - - | 5 - 5 - 5 - 3 - | 2 - - - - - - - | 0 0 0 0 3 2 3 - |
}

C1:Vocal@|0| {
    <2*>
    | 2 3 | 2 - | 1 2 | 1 - |
    | 1 2 | 1 - | 2 3 | 2 - |
    | 2 3 | 2 - | 3 2 | 1 2 |
    | 1 - | - - | 2 3 | 2 - |
}


C2:Vocal@|0| {
    <8*>
    /* 起 塵埃飄落 塵埃揚*/
    | 2 - - - - - - - | 0 0 0 0  3 2 3 2 | 1 - - - - - - - | 0 0 0 0 3 2 3 2 |
    /* 起 塵埃飄落 塵埃揚*/
    | 1 - - - - - - - | 0 0 0 0 3 2 3 5 | 2 - - - - - - - | 0 0 0 0  3 2 3  - |
    /* 起 塵埃飄—落—*/
    | 2 - - - - - - - | 0 0 0 0  3 2 3 1 | - - - - - - - - | 0 0 0 0 2 - - -  |
    /* 揚起又飄落*/
    | 1 - - - - - - - | 5 - 5 - 5 - 3 - | 2 - - - - - - - | 0 0 0 0 0 0 0 0 |
}

->A
->A
->Chorus
->(canon A2 (Vocal Vocal2) 2)
->Chorus2
->C1
->C2
->#