A:Vocal@|0| {
    <8*>
    /* 每片落葉都值得微風 每株飛絮都值得花朵 每顆流星都值得廣闊夜空*/
    /* 每份渺小都值得歌頌 每個孩子都值得笑容 每粒塵埃都值得一塊角落 即便他 */
    | 2 - 2 - 2 1 6_ 5_ | 6_ 1 - - 2 -  1 2 | 3 2 1 5_ 1  2 - - | 1 - - - - - - - |
    | 1 - 1 - 1 6_ 5_ 4_ | 1 5_ - - 1 - 6_ -  | 2 - - - - - - - | 0 0 0 0 0 0 0 0 |
}

Chorus:Vocal@|0| {
    <8*>
    /* 浮沈在時間的河裡 沒有一絲餘波*/
    | 2 - 3 - 2 -- 3 | 5 -- 3 2 - 3 2 | 1 - 3  - 2 - - 6_ | 2 - - - - - - - |
    /* 溶解在時間的洋裡 沒有一點泡沫*/
    | 2 - 3 - 2 -- 3 | 5 -- 3 2 - 3 2 | 1 - 6_ - 6_ - - 5_ | 5_ - - - - - - - |
    /* 浮沈在時間的河裡 沒有一絲餘波*/
    | 2 - 3 - 2 -- 3 | 5 -- 3 2 - 3 2 | 1 - 3  - 2 - - 6_ | 2 - - - - - - - |
    /* 溶解在時間的洋裡 沒有一點泡沫*/
    | 2 - 3 - 2 -- 3 | 5 -- 3 2 - 3 2 | 1 - 6_ - 6_ - - 3 | 2 - - - - - - - |
}

Chorus2:Vocal2@|0| {
    <8*>
    /* 漂流在時間的河裡 沒有一絲餘波*/
    | 2 - 3 - 2 -- 3 | 5 -- 3 2 - 3 2 | 1 - 3  - 2 - - 6_ | 2 - - - - - - - |
    /* 溶解在時間的洋裡 沒有一點泡沫*/
