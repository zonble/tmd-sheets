    | 2_ - 2_ - 2_ 0 2_ 2_ | 0 0 0 0 2_ 2_ 2_ 2_ |
    | 1_ - 1_ - 1_ 0 1_ 1_ | 0 0 0 0 1_ 1_ 1_ 1_ |
    | 1_ - 1_ - 1_ 0 1_ 1_ | 0 0 0 0 1_ 1_ 1_ 1_ |
    | 2_ - 2_ - 2_ 0 2_ 2_ | 0 0 0 0 2_ 2_ 2_ 0 |
    | 2_ - 2_ - 2_ 0 2_ 2_ | 0 0 0 0 2_ 2_ 2_ 2_ |
    | 6__ - 6__ - 6__ 0 6__ 6__ | 0 0 0 0 6__ 0 6__ 0 |
    | 4__ - 4__ - 4__ 0 4__ 4__ | 5__ - 5__ - 5__ 0 5__ 5__ |
    | 2_ - 2_ - 2_ 0 2_ 2_ | 2_ 2_ 2_ 2_ 2_ 2_ 2_ 0 |
}

