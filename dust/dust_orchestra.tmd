    | 2__ | 1__ | 4___ | 5___ |
    | 2__ | 1__ | 6___ | 2__ |
    | 2__ | 1__ | 4___ | 2__ |
}

/* ========================================================================= */
/* A2 Section (8 bars) - 依然是清澈的琶音，弦樂悄悄微溫                     */
/* ========================================================================= */

A2:Vocal@|0| {
    <8*>
    | 2 - 2 - 2 1 6_ 5_ | 6_ 1 - - 2 - 1 2 | 3 2 1 5_ 1 2 - - | 1 - - - - - - - |
    | 1 - 1 - 1 6_ 5_ 4_ | 1 5_ - - 1 - 6_ - | 2 - - - - - - - |
    /* (念白) 即便會—— */
