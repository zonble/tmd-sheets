/* ========================================================================= */
/* C1 Section (16 bars) - 💥 塵埃之問與天地之答                             */
/* 架構核心：                                                                */
/* 【問】：極致渺小！塵埃在無垠宇宙中的微弱孤鳴。全團全體靜默屏息（Tacet），*/
/*        只有人聲單音孤獨呼喚「起——」。                                    */
/* 【答】：巨大天地！在後半拍全體管弦、銅管齊鳴、定音鼓巨雷轟擊「塵埃飄落」！*/
/* ========================================================================= */

C1:Vocal@|0| {
    <8*>
    /* 起 塵埃飄落 塵埃揚*/
    | 2 - - - - - - - | 0 0 0 0 3 2 3 2 | 1 - - - - - - - | 0 0 0 0 3 2 3 2 |
    /* 起 塵埃飄落 塵埃揚*/
    | 1 - - - - - - - | 0 0 0 0 3 2 3 5 | 2 - - - - - - - | 0 0 0 0 3 2 3 - |
    /* 起 塵埃飄—落— */
    | 2 - - - - - - - | 0 0 0 0 3 2 3 1 | - - - - - - - - | 0 0 0 0 2 - - - |
    /* 揚起又飄落 看塵埃揚*/
    | 1 - - - - - - - | 5 - 5 - 5 - 3 - | 2 - - - - - - - | 0 0 0 0 3 2 3 - |
}

