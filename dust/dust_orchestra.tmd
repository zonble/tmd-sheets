    <8*>
    | 2_ 6_ 2 3 5 3 2 6_ | 1_ 5_ 1 2 5 2 1 5_ | 6__ 3_ 6_ 1 3 1 6_ 3_ | 2_ 6_ 2 3 5 3 2 6_ |
    | 2_ 6_ 2 3 5 3 2 6_ | 1_ 5_ 1 2 5 2 1 5_ | 4__ 1_ 4_ 6_ 1 6_ 4_ 1_ | 5__ 2_ 5_ 7_ 2 7_ 5_ 2_ |
    | 2_ 6_ 2 3 5 3 2 6_ | 1_ 5_ 1 2 5 2 1 5_ | 6__ 3_ 6_ 1 3 1 6_ 3_ | 2_ 6_ 2 3 5 3 2 6_ |
    | 2_ 6_ 2 3 5 3 2 6_ | 1_ 5_ 1 2 5 2 1 5_ | 4__ 1_ 4_ 6_ 1 6_ 4_ 1_ | 2_ 6_ 2 3 5 3 2 6_ |
}

