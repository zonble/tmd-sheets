    <2*>
    | 2_ - | 1_ - | 6__ - | 2_ - |
    | 2_ - | 1_ - | 4__ - | 5__ - |
    | 2_ - | 1_ - | 6__ - | 2_ - |
    | 2_ - | 1_ - | 4__ - | 2_ - |
