    <2*>
    | 2_ 3_ | 2_ - | 1_ 2_ | 1_ - |
    | 1_ 2_ | 1_ - | 2_ 3_ | 2_ - |
    | 2_ 3_ | 2_ - | 3_ 2_ | 1_ 2_ |
    | 1_ - | 5__ - | 2_ 3_ | 2_ - |
}

C1:Contrabass@|0| {
    <2*>
    | 2__ 3__ | 2__ - | 1__ 2__ | 1__ - |
    | 1__ 2__ | 1__ - | 2__ 3__ | 2__ - |
    | 2__ 3__ | 2__ - | 3__ 2__ | 1__ 2__ |
    | 1__ - | 5___ - | 2__ 3__ | 2__ - |
