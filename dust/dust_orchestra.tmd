/* ========================================================================= */
/* Chorus2 Section (16 bars) - 琶音激盪！最後四拍「看塵埃揚」極限蓄力！     */
/* ========================================================================= */

Chorus2:Vocal@|0| {
    <8*>
    /* 漂流在時間的河裡 沒有一絲餘波*/
    | 2 - 3 - 2 -- 3 | 5 -- 3 2 - 3 2 | 1 - 3 - 2 - - 6_ | 2 - - - - - - - |
    /* 溶解在時間的洋裡 沒有一點泡沫*/
    | 2 - 3 - 2 -- 3 | 5 -- 3 2 - 3 2 | 1 - 6_ - 6_ - - 5_ | 5_ - - - - - - - |
    /* 漂流在時間的河裡 沒有一絲餘波*/
    | 2 - 3 - 2 -- 3 | 5 -- 3 2 - 3 2 | 1 - 3 - 2 - - 6_ | 2 - - - - - - - |
    /* 溶解在時間的洋裡 沒有一點泡沫 看塵埃揚*/
